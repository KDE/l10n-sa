msgid ""
"<guilabel>Tunnel via loopback address</guilabel> makes the tunnel connect to "
"the remote desktop service through the remote host's loopback address. Use "
"this when the service listens only on that address. The remote desktop port "
"still comes from the connection address."
msgstr ""

#. Tag: title
#: index.docbook:690
#, no-c-format
msgid "Starting connections from the command line"
msgstr ""

#. Tag: para
#: index.docbook:691
#, no-c-format
msgid "Pass a complete URL to connect directly:"
msgstr ""

#. Tag: screen
#: index.docbook:692
#, no-c-format
msgid ""
"<userinput><command>krdc</command> rdp://alice@megan</userinput>\n"
"<userinput><command>krdc</command> vnc://megan:5901</userinput>\n"
"<userinput><command>krdc</command> spice://vmhost:5902</userinput>"
msgstr ""

#. Tag: para
#: index.docbook:694
#, no-c-format
msgid ""
"Use <option>--fullscreen</option> with one URL to start that connection in "
"full screen. You can also pass several URLs to open multiple connections:"
msgstr ""

#. Tag: screen
#: index.docbook:696
#, no-c-format
msgid ""
"<userinput><command>krdc</command> --fullscreen rdp://megan</userinput>\n"
"<userinput><command>krdc</command> vnc://megan rdp://workstation</userinput>"
msgstr ""

#. Tag: para
#: index.docbook:698
#, no-c-format
msgid ""
"In a complete URL, percent-encode reserved characters in the user name. For "
"example, use <userinput>rdp://alice%40example.org@megan</userinput> for the "
"user name <literal>alice@example.org</literal>."
msgstr ""

#. Tag: para
#: index.docbook:702
