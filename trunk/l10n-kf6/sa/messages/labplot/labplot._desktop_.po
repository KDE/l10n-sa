#: src/org.kde.labplot2.desktop:5 src/org.kde.labplot.desktop:5
msgctxt "Name"
msgid "LabPlot"
msgstr "लैबप्लॉट"

#: src/org.kde.labplot2.desktop:27 src/org.kde.labplot.desktop:27
msgctxt "GenericName"
msgid "Data Visualization and Analysis software"
msgstr "डाटा विजुअलाइजेशन एण्ड एनालिसिस सॉफ्टवेयर"

#: src/org.kde.labplot2.desktop:55 src/org.kde.labplot.desktop:55
msgctxt "Comment"
msgid ""
"LabPlot is a FREE, open source and cross-platform Data Visualization and "
"Analysis software accessible to everyone."
msgstr ""
"LabPlot इति निःशुल्कं, मुक्तस्रोतं तथा च पार-मञ्चं Data Visualization and "
"Analysis सॉफ्टवेयरं सर्वेषां कृते सुलभम् अस्ति ।"
