#: org.kde.kdiamond.appdata.xml:9
#. (itstool) path: component/name
msgid "KDiamond"
msgstr "केहीरा"

#: org.kde.kdiamond.appdata.xml:10
#. (itstool) path: component/summary
msgid "KDiamond is a three-in-a-row game by KDE"
msgstr "केडायमण्ड् केडीई इत्यस्य त्रयः पङ्क्तिबद्धः क्रीडा अस्ति"

#: org.kde.kdiamond.appdata.xml:12
#. (itstool) path: description/p
msgid ""
"KDiamond is a single player puzzle game. The object of the game is to build "
"lines of three similar diamonds."
msgstr ""
"KDiamond इति एकः खिलाडी पहेलीक्रीडा अस्ति । क्रीडायाः उद्देश्यं त्रयाणां "
"समानानां हीरकानां रेखानिर्माणम् अस्ति ।"

#: org.kde.kdiamond.appdata.xml:22
#. (itstool) path: screenshot/caption
msgid "Playing KDiamond"
msgstr "KDiamond इति क्रीडन्"