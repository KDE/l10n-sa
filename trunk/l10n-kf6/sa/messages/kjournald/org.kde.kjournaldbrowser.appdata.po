#: org.kde.kjournaldbrowser.appdata.xml:10
#. (itstool) path: component/name
msgid "Journald Browser"
msgstr "जर्नल्ड् ब्राउज़र"

#: org.kde.kjournaldbrowser.appdata.xml:11
#. (itstool) path: component/summary
msgid "Browser for journald databases"
msgstr "जर्नल्ड् डाटाबेस् कृते ब्राउजर्"

#: org.kde.kjournaldbrowser.appdata.xml:13
#. (itstool) path: description/p
msgid ""
"Journald-browser is a reference implementation of the kjournald library and "
"provides a flexible tool to browse in local, remote and offline journald "
"databases."
msgstr ""
"Journald-browser kjournald पुस्तकालयस्य सन्दर्भकार्यन्वयनम् अस्ति तथा च "
"स्थानीय, दूरस्थ तथा अफलाइन journald आँकडाधारयोः ब्राउज् कर्तुं लचीला साधनं "
"प्रदाति ।"

#: org.kde.kjournaldbrowser.appdata.xml:18
#. (itstool) path: screenshot/caption
msgid "Log Browser"
msgstr "लॉग ब्राउज़र"
