#: org.kde.tokodon.desktop:4 src/tokodon.notifyrc:5
msgctxt "Name"
msgid "Tokodon"
msgstr "टोकोडोन्"

#: org.kde.tokodon.desktop:43
msgctxt "GenericName"
msgid "Browse the Fediverse"
msgstr "Fediverse ब्राउज् कुर्वन्तु"

#: org.kde.tokodon.desktop:66
msgctxt "Comment"
msgid "Client for the Mastodon"
msgstr "मस्टोडन् कृते ग्राहकः"

#: src/tokodon.notifyrc:45
msgctxt "Comment"
msgid "A client for Mastodon, the decentralized social media"
msgstr "विकेन्द्रीकृतस्य सामाजिकमाध्यमस्य मास्टोडन् इत्यस्य ग्राहकः"

#: src/tokodon.notifyrc:79
msgctxt "Name"
msgid "Favorite"
msgstr "प्रिय"

#: src/tokodon.notifyrc:113
msgctxt "Comment"
msgid "Someone favorited your post"
msgstr "भवतः पोस्ट् कश्चन प्रियं कृतवान्"

#: src/tokodon.notifyrc:147
msgctxt "Name"
msgid "Boost"
msgstr "संवेग"

#: src/tokodon.notifyrc:179
msgctxt "Comment"
msgid "Someone boosted your post"
msgstr "कश्चन भवतः पोस्ट् बूस्ट् कृतवान्"

#: src/tokodon.notifyrc:214 src/tokodon.notifyrc:345
msgctxt "Name"
msgid "Follow"
msgstr "अनुशीलनं"

#: src/tokodon.notifyrc:248
msgctxt "Comment"
msgid "Someone followed you"
msgstr "कश्चित् भवन्तं अनुसृत्य गतः"

#: src/tokodon.notifyrc:283
msgctxt "Name"
msgid "Follow Request"
msgstr "अनुसरणं कुर्वन्तु अनुरोधः"

#: src/tokodon.notifyrc:313
msgctxt "Comment"
msgid "Someone requested to followed you"
msgstr "कश्चन भवतः अनुसरणं कर्तुं प्रार्थितवान्"

#: src/tokodon.notifyrc:379
msgctxt "Comment"
msgid "Someone mentioned you"
msgstr "कश्चित् भवतः उल्लेखं कृतवान्"

#: src/tokodon.notifyrc:414
msgctxt "Name"
msgid "Update"
msgstr "अद्यतन"

#: src/tokodon.notifyrc:447
msgctxt "Comment"
msgid "Someone edited a post"
msgstr "कश्चन एकं पोस्ट् सम्पादितवान्"

#: src/tokodon.notifyrc:481
msgctxt "Name"
msgid "Poll"
msgstr "मतदानम्"

#: src/tokodon.notifyrc:511
msgctxt "Comment"
msgid "Someone's poll ended"
msgstr "कस्यचित् मतदानं समाप्तम्"

#: src/tokodon.notifyrc:543
msgctxt "Name"
msgid "Status"
msgstr "स्थितिः"

#: src/tokodon.notifyrc:573
msgctxt "Comment"
msgid "Someone posted a new status"
msgstr "कश्चन नूतनं स्थितिं स्थापितवान्"
