#: org.kde.pvfViewer.appdata.xml:9
#. (itstool) path: component/name
msgid "pvfViewer"
msgstr "pvfदर्शकः"

#: org.kde.pvfViewer.appdata.xml:10
#. (itstool) path: component/summary
msgid "A PC Stitch Pattern Viewer File viewer"
msgstr "एकः PC Stitch Pattern Viewer सञ्चिकादर्शकः"

#: org.kde.pvfViewer.appdata.xml:12
#. (itstool) path: description/p
msgid ""
"pvfViewer is a program to view and print PC Stitch Pattern Viewer files "
"having a .pvf extension."
msgstr ""
"pvfViewer इति .pvf विस्तारयुक्तानि PC Stitch Pattern Viewer सञ्चिकाः "
"द्रष्टुं मुद्रयितुं च एकः कार्यक्रमः अस्ति ।"

#: org.kde.pvfViewer.appdata.xml:13
