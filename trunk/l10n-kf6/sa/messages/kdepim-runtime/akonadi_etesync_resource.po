#: etesyncresource.cpp:49
#, kde-format
msgid "EteSync Resource"
msgstr "EteSync संसाधन"

#: etesyncresource.cpp:187
#, kde-format
msgid "Temporary server error"
msgstr "अस्थायी सर्वर त्रुटि"

#: etesyncresource.cpp:191
#, kde-format
msgid "You do not have permission to perform this action."
msgstr "एतत् कर्म कर्तुं भवतः अनुमतिः नास्ति ।"

#: etesyncresource.cpp:194
#, kde-format
msgid "Permission denied"
msgstr "अनुमतिः अङ्गीकृता"

#: etesyncresource.cpp:198
#, kde-format
msgid "A server error occurred."
msgstr "सर्वरदोषः अभवत् ।"

#: etesyncresource.cpp:201
#, kde-format
msgid "Server error"
msgstr "सर्वर त्रुटिः"

#: etesyncresource.cpp:220
#, kde-format
msgid ""
"Your EteSync credentials were changed. Please click OK to re-enter your "
"credentials."
msgstr ""
"भवतः EteSync प्रमाणपत्राणि परिवर्तितानि आसन् । कृपया स्वस्य प्रमाणपत्राणि "
"पुनः प्रविष्टुं OK नुदन्तु ।"

#: etesyncresource.cpp:222
#, kde-format
msgid "Credentials Changed"
msgstr "प्रमाणपत्राणि परिवर्तितानि"

#: etesyncresource.cpp:270
#, kde-format
msgid "Cannot retrieve items - account is null"
msgstr "वस्तूनि पुनः प्राप्तुं न शक्यते - खातं शून्यम् अस्ति"

#: etesyncresource.cpp:277 etesyncresource.cpp:383 etesyncresource.cpp:456
#: etesyncresource.cpp:514 etesyncresource.cpp:643 etesyncresource.cpp:701
#, kde-format
msgid "Could not get etesyncCollection from cache '%1'"
msgstr "'%1' सञ्चिकातः etesyncCollection प्राप्तुं न शक्तवान् ।"

#: etesyncresource.cpp:411
#, kde-format
msgid "Could not create new etesyncItem '%1'"
msgstr "नूतनं etesyncItem '%1' निर्मातुं न शक्तवान्."

#: etesyncresource.cpp:463 etesyncresource.cpp:521
#, kde-format
msgid "Could not get etesyncItem from cache '%1'"
msgstr "'%1' सञ्चिकातः etesyncItem प्राप्तुं न शक्तवान् ।"

#: etesyncresource.cpp:583
#, kde-format
msgid "Could not create new etesyncCollection"
msgstr "नूतनं etesyncCollection निर्मातुं न शक्तवान्"

#: etesyncresource.h:62
#, kde-format
msgid "Something went wrong"
msgstr "किमपि भ्रष्टं जातम्"

#: etesyncresource.kcfg:10
#. i18n: ectx: label, entry (BaseUrl), group (General)
#, kde-format
msgid "Server URL"
msgstr "सर्वर URL"

#: etesyncresource.kcfg:11 etesyncresource.kcfg:12
#. i18n: ectx: tooltip, entry (BaseUrl), group (General)
#. i18n: ectx: whatsthis, entry (BaseUrl), group (General)
#, kde-format
msgid ""
"The URL of the EteSync server, should be something like "
"https://myserver.org/"
msgstr "EteSync सर्वरस्य URL, https://myserver.org/ इव किमपि भवेत् ।"

#: etesyncresource.kcfg:16 etesyncresource.kcfg:17
#. i18n: ectx: tooltip, entry (Username), group (General)
#. i18n: ectx: whatsthis, entry (Username), group (General)
#, kde-format
msgid "The username that is used to log into the EteSync server"
msgstr "EteSync सर्वरे प्रवेशार्थं यत् उपयोक्तृनाम उपयुज्यते"

#: etesyncresource.kcfg:20
#. i18n: ectx: label, entry (BasePath), group (General)
#, kde-format
msgid "Path to base directory"
msgstr "आधारनिर्देशिकायाः मार्गः"

#: setupwizard.cpp:66
#, kde-format
msgid "Login Credentials"
msgstr "प्रवेशप्रमाणपत्रम्"

#: setupwizard.cpp:67
#, kde-format
msgid "Enter your credentials to login to the EteSync server"
msgstr "EteSync सर्वरे प्रवेशार्थं स्वस्य प्रमाणपत्राणि प्रविशन्तु"

#: setupwizard.cpp:76
#, kde-format
msgid "Username:"
msgstr "उपयोक्तृनाम : १."

#: setupwizard.cpp:82
#, kde-format
msgid "Password:"
msgstr "समाभाष्:"

#: setupwizard.cpp:90
#, kde-format
msgid "Server:"
msgstr "सर्वरः : १."

#: setupwizard.cpp:103
#, kde-format
msgid ""
"🛈 The password field is empty because EteSync does not store it for "
"security reasons."
msgstr "🛈 गुप्तशब्दक्षेत्रं रिक्तं यतः EteSync सुरक्षाकारणात् तत् न संगृह्णाति।"

#: setupwizard.cpp:135
#, kde-format
msgid ""
"Please ensure that the server URL is correct. The URL should start with "
"http:// or https://."
msgstr ""
"कृपया सुनिश्चितं कुर्वन्तु यत् सर्वरस्य URL सम्यक् अस्ति । URL http:// अथवा "
"https:// इत्यनेन आरभ्यत ।"

#: setupwizard.cpp:137
#, kde-format
msgid ""
"Could not connect to the server. Please ensure that the server URL is "
"correct."
msgstr ""
"सर्वरेण सह सम्बद्धं कर्तुं न शक्तवान्। कृपया सर्वरस्य URL सम्यक् अस्ति इति "
"सुनिश्चितं कुर्वन्तु ।"

#: setupwizard.cpp:139
#, kde-format
msgid "EteSync server not found. Please ensure that the server URL is correct."
msgstr ""
"EteSync सर्वरः न प्राप्तः। कृपया सुनिश्चितं कुर्वन्तु यत् सर्वरस्य URL "
"सम्यक् अस्ति ।"

#: etesyncresource.kcfg:15
#. i18n: ectx: label, entry (Username), group (General)
#, kde-format
msgctxt "the username to login on server"
msgid "Username"
msgstr "उपयोक्तृनाम"

#: setupwizard.cpp:28
#, kde-format
msgctxt "@title:window"
msgid "EteSync configuration wizard"
msgstr "EteSync विन्यासविजार्डः"

#: setupwizard.cpp:85
#, kde-format
msgctxt "@option:check"
msgid "Advanced settings"
msgstr "उन्नत सेटिंग्स्"