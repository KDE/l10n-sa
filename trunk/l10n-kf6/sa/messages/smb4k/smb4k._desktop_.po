#: core/smb4k.notifyrc:3 smb4k/org.kde.smb4k.desktop:3
msgctxt "Name"
msgid "Smb4K"
msgstr "Smb4K"

#: core/smb4k.notifyrc:43 smb4k/org.kde.smb4k.desktop:77
msgctxt "Comment"
msgid "Advanced Network Neighborhood Browser"
msgstr "उन्नत संजालपरिसर ब्राउजर"

#: core/smb4k.notifyrc:84
msgctxt "Name"
msgid "Notification"
msgstr "अधिसूचना"

#: core/smb4k.notifyrc:124
msgctxt "Comment"
msgid "The user is notified about an action"
msgstr "उपयोक्तारः कस्यापि क्रियायाः विषये सूचितः भवति"

#: core/smb4k.notifyrc:163
msgctxt "Name"
msgid "Warning"
msgstr "चेतवानी"

#: core/smb4k.notifyrc:203
msgctxt "Comment"
msgid "A warning is shown to the user"
msgstr "उपयोक्त्रे चेतावनी दर्शिता भवति"

#: core/smb4k.notifyrc:243
msgctxt "Name"
msgid "Error"
msgstr "त्रुटि"

#: core/smb4k.notifyrc:283
msgctxt "Comment"
msgid "An error message is shown to the user"
msgstr "उपयोक्त्रे त्रुटिसन्देशः दर्शितः भवति"

#: core/smb4k.notifyrc:321
msgctxt "Name"
msgid "Share mounted"
msgstr "शेयर घुड़सवार"

#: core/smb4k.notifyrc:357
msgctxt "Comment"
msgid "A share has been mounted"
msgstr "एकः भागः आरोहितः अस्ति"

#: core/smb4k.notifyrc:397
msgctxt "Name"
msgid "Share unmounted"
msgstr "शेयर अनमाउंट"

#: core/smb4k.notifyrc:433
msgctxt "Comment"
msgid "A share has been unmounted"
msgstr "एकः भागः अनमाउण्ट् कृतः अस्ति"

#: core/smb4k.notifyrc:473
msgctxt "Name"
msgid "Shares mounted"
msgstr "शेयर्स् माउण्ट्"

#: core/smb4k.notifyrc:509
msgctxt "Comment"
msgid "Multiple shares have been mounted"
msgstr "अनेकाः भागाः माउण्ट् कृताः सन्ति"

#: core/smb4k.notifyrc:549
msgctxt "Name"
msgid "Shares unmounted"
msgstr "शेयर अनमाउंट"

#: core/smb4k.notifyrc:585
msgctxt "Comment"
msgid "Multiple shares have been unmounted"
msgstr "अनेकाः भागाः अनमाउण्ट् कृताः सन्ति"

#: core/smb4k.notifyrc:625
msgctxt "Name"
msgid "Migrating login credentials"
msgstr "प्रवेशप्रमाणपत्राणि प्रवासयन्"

#: core/smb4k.notifyrc:651
msgctxt "Comment"
msgid ""
"The login credentials are migrated to the new format and the active password "
"manager"
msgstr "प्रवेशप्रमाणपत्राणि नूतनस्वरूपे सक्रियगुप्तशब्दप्रबन्धके च प्रवासितानि भवन्ति"

#: core/smb4k.notifyrc:680
msgctxt "Name"
msgid "Mimetype not supported"
msgstr "Mimetype समर्थितम् नास्ति"

#: core/smb4k.notifyrc:716
msgctxt "Comment"
msgid "The mimetype of the file that is to be printed is not supported"
msgstr "मुद्रितव्यस्य सञ्चिकायाः अनुकरणप्रकारः समर्थितः नास्ति"

#: core/smb4k.notifyrc:756
msgctxt "Name"
msgid "Bookmark exists"
msgstr "बुकमार्क विद्यते"

#: core/smb4k.notifyrc:792
msgctxt "Comment"
msgid "The bookmark exists"
msgstr "पुस्तकचिह्नं विद्यते"

#: core/smb4k.notifyrc:833
msgctxt "Name"
msgid "Bookmark label in use"
msgstr "उपयोगे बुकमार्क लेबल"

#: core/smb4k.notifyrc:869
msgctxt "Comment"
msgid "The label for the bookmark already exists"
msgstr "पुस्तकचिह्नस्य लेबलं पूर्वमेव अस्ति"

#: core/smb4k.notifyrc:910
msgctxt "Name"
msgid "Mounting failed"
msgstr "माउण्टिङ्ग् विफलम् अभवत्"

#: core/smb4k.notifyrc:947
msgctxt "Comment"
msgid "Mounting a share failed"
msgstr "भागस्य माउण्टिङ्ग् असफलम् अभवत्"

#: core/smb4k.notifyrc:988
msgctxt "Name"
msgid "Unmounting failed"
msgstr "अनमाउण्टिङ्ग् विफलम् अभवत्"

#: core/smb4k.notifyrc:1025
msgctxt "Comment"
msgid "Unmounting a share failed"
msgstr "भागस्य अनमाउण्टिङ्ग् असफलम् अभवत्"

#: core/smb4k.notifyrc:1066
msgctxt "Name"
msgid "Unmounting not allowed"
msgstr "अनमाउण्टिङ्ग् न अनुमतम्"

#: core/smb4k.notifyrc:1102
msgctxt "Comment"
msgid "The unmounting of a certain share is not allowed"
msgstr "कस्यचित् भागस्य अवरोहणं न अनुमतम्"

#: core/smb4k.notifyrc:1143
msgctxt "Name"
msgid "Synchronization failed"
msgstr "समन्वयनं विफलम् अभवत्"

#: core/smb4k.notifyrc:1180
msgctxt "Comment"
msgid "The synchronization of a share and a local copy failed"
msgstr "एकस्य भागस्य स्थानीयप्रतिलिपेः च समन्वयनं विफलम् अभवत्"

#: core/smb4k.notifyrc:1220
msgctxt "Name"
msgid "Command not found"
msgstr "आदेशः न लब्धः"

#: core/smb4k.notifyrc:1258
msgctxt "Comment"
msgid "A required command could not be found"
msgstr "अपेक्षितः आदेशः न लब्धः"

#: core/smb4k.notifyrc:1299
msgctxt "Name"
msgid "Cannot bookmark printer"
msgstr "मुद्रकं बुकमार्कं कर्तुं न शक्यते"

#: core/smb4k.notifyrc:1335
msgctxt "Comment"
msgid "A printer cannot be bookmarked"
msgstr "मुद्रकस्य पुस्तकचिह्नं कर्तुं न शक्यते"

#: core/smb4k.notifyrc:1376
msgctxt "Name"
msgid "File not found"
msgstr "सञ्चिका न प्राप्ता"

#: core/smb4k.notifyrc:1415
msgctxt "Comment"
msgid "A file could not be found"
msgstr "सञ्चिका न लब्धा"

#: core/smb4k.notifyrc:1456
msgctxt "Name"
msgid "Opening file failed"
msgstr "सञ्चिकां उद्घाटयितुं विफलम्"

#: core/smb4k.notifyrc:1492
msgctxt "Comment"
msgid "A file could not be opened"
msgstr "सञ्चिका उद्घाटयितुं न शक्यते स्म"

#: core/smb4k.notifyrc:1533
msgctxt "Name"
msgid "Reading file failed"
msgstr "सञ्चिकायाः पठनं विफलम् अभवत्"

#: core/smb4k.notifyrc:1569
msgctxt "Comment"
msgid "A file could not be read"
msgstr "सञ्चिका पठितुं न शक्यते स्म"

#: core/smb4k.notifyrc:1610
msgctxt "Name"
msgid "mkdir failed"
msgstr "mkdir असफलः अभवत्"

#: core/smb4k.notifyrc:1647
msgctxt "Comment"
msgid "A directory could not be created"
msgstr "निर्देशिका निर्मातुं न शक्यते स्म"

#: core/smb4k.notifyrc:1688
msgctxt "Name"
msgid "Process error"
msgstr "प्रक्रियादोषः"

#: core/smb4k.notifyrc:1726
msgctxt "Comment"
msgid "A process error occurred"
msgstr "प्रक्रियादोषः अभवत्"

#: core/smb4k.notifyrc:1767
msgctxt "Name"
msgid "Action failed"
msgstr "कर्म विफलम् अभवत्"

#: core/smb4k.notifyrc:1805
msgctxt "Comment"
msgid "A KAuth action failed"
msgstr "एकं KAuth क्रिया असफलम् अभवत्"

#: core/smb4k.notifyrc:1845
msgctxt "Name"
msgid "Invalid URL"
msgstr "अमान्य URL"

#: core/smb4k.notifyrc:1884
msgctxt "Comment"
msgid "An invalid URL was passed"
msgstr "अमान्यः URL पारितः"

#: core/smb4k.notifyrc:1924
msgctxt "Name"
msgid "Network communication failed"
msgstr "संजालसञ्चारः विफलः अभवत्"

#: core/smb4k.notifyrc:1957
msgctxt "Comment"
msgid "A network related action could not be performed or failed"
msgstr "जालसम्बद्धं कार्यं कर्तुं असफलं वा न शक्यते स्म"

#: core/smb4k.notifyrc:1995
msgctxt "Name"
msgid "Zeroconf error"
msgstr "शून्यकॉन्फ त्रुटिः"

#: core/smb4k.notifyrc:2026
msgctxt "Comment"
msgid "An error with the Zeroconf daemon occurred"
msgstr "Zeroconf डेमन् इत्यनेन सह त्रुटिः अभवत्"

#: core/smb4k.notifyrc:2061
msgctxt "Name"
msgid "Keychain error"
msgstr "कीचेन त्रुटि"

#: core/smb4k.notifyrc:2087
msgctxt "Comment"
msgid ""
"An error occurred while reading the login credentials from the secure storage"
msgstr "सुरक्षितभण्डारतः प्रवेशप्रमाणपत्राणि पठन् त्रुटिः अभवत्"

#: helpers/smb4kmounthelper.actions:2
msgctxt "Name"
msgid "Mount action"
msgstr "कर्म माउण्ट्"

#: helpers/smb4kmounthelper.actions:37
msgctxt "Description"
msgid "Mounts a share"
msgstr "एकं भागं माउण्ट् करोति"

#: helpers/smb4kmounthelper.actions:76
msgctxt "Name"
msgid "Unmount action"
msgstr "अनमाउंट क्रिया"

#: helpers/smb4kmounthelper.actions:111
msgctxt "Description"
msgid "Unmounts a share"
msgstr "एकं भागं अनमाउण्ट् करोति"

