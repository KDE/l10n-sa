#: core/smb4k.notifyrc:3 smb4k/org.kde.smb4k.desktop:3
msgctxt "Name"
msgid "Smb4K"
msgstr "Smb4K"

#: core/smb4k.notifyrc:44 smb4k/org.kde.smb4k.desktop:79
msgctxt "Comment"
msgid "Advanced Network Neighborhood Browser"
msgstr "उन्नत संजालपरिसर ब्राउजर"

#: core/smb4k.notifyrc:86
msgctxt "Name"
msgid "Notification"
msgstr "अधिसूचना"

#: core/smb4k.notifyrc:127
msgctxt "Comment"
msgid "The user is notified about an action"
msgstr "उपयोक्तारः कस्यापि क्रियायाः विषये सूचितः भवति"

#: core/smb4k.notifyrc:167
msgctxt "Name"
msgid "Warning"
msgstr "चेतवानी"

#: core/smb4k.notifyrc:208
msgctxt "Comment"
msgid "A warning is shown to the user"
msgstr "उपयोक्त्रे चेतावनी दर्शिता भवति"

#: core/smb4k.notifyrc:249
msgctxt "Name"
msgid "Error"
msgstr "त्रुटि"

#: core/smb4k.notifyrc:290
msgctxt "Comment"
msgid "An error message is shown to the user"
msgstr "उपयोक्त्रे त्रुटिसन्देशः दर्शितः भवति"

#: core/smb4k.notifyrc:329
msgctxt "Name"
msgid "Share mounted"
