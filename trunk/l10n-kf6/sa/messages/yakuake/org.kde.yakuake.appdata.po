msgid "Features:"
msgstr "गुणाः:"

#: org.kde.yakuake.appdata.xml:17
#. (itstool) path: ul/li
msgid "Smoothly rolls down from the top of your screen"
msgstr "भवतः पटलस्य उपरितः सुचारुतया अधः लुठति"

#: org.kde.yakuake.appdata.xml:18
#. (itstool) path: ul/li
msgid "Tabbed interface"
msgstr "ट्याब्ड् अन्तरफलकम्"

#: org.kde.yakuake.appdata.xml:19
