#: org.kde.yakuake.appdata.xml:9
#. (itstool) path: component/name
msgid "Yakuake"
msgstr "याकुआके"

#: org.kde.yakuake.appdata.xml:10
#. (itstool) path: component/summary
msgid "Drop-down Terminal"
msgstr "ड्रॉप-डाउन टर्मिनल्"

#: org.kde.yakuake.appdata.xml:12
#. (itstool) path: description/p
msgid "Yakuake is a drop-down terminal emulator based on KDE Konsole technology."
msgstr ""
"Yakuake इति KDE Konsole प्रौद्योगिक्याः आधारेण एकः ड्रॉप्-डाउन टर्मिनल् "
"एमुलेटरः अस्ति ।"

#: org.kde.yakuake.appdata.xml:15
