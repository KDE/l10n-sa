#: src/org.kde.rsibreak.desktop:11 src/rsibreak_autostart.desktop:11
msgctxt "Name"
msgid "RSIBreak"
msgstr "RSIBreak इति"

#: src/rsibreak.notifyrc:52
msgctxt "Name"
msgid "Breaks"
msgstr "भङ्गयति"

#: src/rsibreak.notifyrc:102
msgctxt "Name"
msgid "Start of a short break"
msgstr "अल्पविरामस्य आरम्भः"

#: src/rsibreak.notifyrc:198
msgctxt "Name"
msgid "End of a short break"
msgstr "अल्पविरामस्य अन्तः"

#: src/rsibreak.notifyrc:294
msgctxt "Name"
msgid "Start of a long break"
msgstr "दीर्घविरामस्य आरम्भः"

#: src/rsibreak.notifyrc:390
msgctxt "Name"
msgid "End of a long break"
msgstr "दीर्घविरामस्य अन्तः"

#: src/rsibreak.notifyrc:484
msgctxt "Name"
msgid "Regarding timers"
msgstr "समयनिर्धारकस्य विषये"

#: src/rsibreak.notifyrc:526
msgctxt "Name"
msgid "When the short timer has been reset"
msgstr "यदा लघुसमयनिर्धारकः पुनः सेट् कृतः भवति"

#: src/rsibreak.notifyrc:569
msgctxt "Name"
msgid "When the timers have been reset"
msgstr "यदा समयनिर्धारकाः पुनः सेट् कृताः भवन्ति"

#: src/org.kde.rsibreak.desktop:58
msgctxt "GenericName"
msgid "Help prevent repetitive strain injury"
msgstr "पुनरावर्तनीयं तनावस्य चोटं निवारयितुं साहाय्यं कुर्वन्तु"

#: src/org.kde.rsibreak.desktop:91 src/rsibreak_autostart.desktop:58
msgctxt "Comment"
msgid "Makes sure you rest now and then"
msgstr "इदानीं तदा विश्रामं करोति इति सुनिश्चितं करोति"

#: src/rsibreak.notifyrc:4
msgctxt "Comment"
msgid "RSIBreak"
msgstr "RSIBreak इति"

#: src/rsibreak.notifyrc:148
msgctxt "Comment"
msgid "When a short break starts"
msgstr "यदा अल्पः विरामः आरभ्यते"

#: src/rsibreak.notifyrc:244
msgctxt "Comment"
msgid "When a short break ends"
msgstr "यदा अल्पः विरामः समाप्तः भवति"

#: src/rsibreak.notifyrc:340
msgctxt "Comment"
msgid "When a long break starts"
msgstr "यदा दीर्घः विरामः आरभ्यते"

#: src/rsibreak.notifyrc:436
msgctxt "Comment"
msgid "When a long break ends"
msgstr "यदा दीर्घः विरामः समाप्तः भवति"