msgstr "परिणामः %1 - विवरणम्:[%3 (%2)]"

#: src/libparser/diceparser.cpp:79
msgctxt "QObject|"
msgid ""
"Nothing was understood. To roll dice: !1d6 - full documentation: <a href="
"\"https://github.com/Rolisteam/DiceParser/blob/master/HelpMe.md\">https://"
"github.com/Rolisteam/DiceParser/blob/master/HelpMe.md</a>"
msgstr ""
"किमपि न अवगतम् । पासा रोल कर्तुं: !1d6 - पूर्णदस्तावेजनम्: <a href=\"https://github."
"com/Rolisteam/DiceParser/blob/master/HelpMe.md\">https://github.com/"
"Rolisteam/DiceParser/blob/master/HelpMe.md</a>"

#: src/libparser/diceparser.cpp:90
#, qt-format
msgctxt "QObject|"
msgid "Unexpected character at %1 - end of command was ignored \"%2\""
msgstr "%1 इत्यत्र अप्रत्याशितवर्णः - आदेशस्य अन्ते \"%2\" उपेक्षितः ।"

#: src/libparser/diceroller.cpp:61
#, qt-format
msgctxt "DiceRoller|"
msgid ""
"Error:\n"
"%1\n"
"Warnings:\n"
"%2"
msgstr ""
"त्रुटि:\n"
"%1\n"
"चेतावनी : १.\n"
"%2"

#: src/libparser/node/dicerollernode.cpp:25
msgctxt "QObject|"
msgid "No dice to roll"
msgstr "न पासान् रोल कर्तुं"

#: src/libparser/node/dicerollernode.cpp:34
msgctxt "QObject|"
msgid "More unique values asked than possible values (D operator)"
msgstr "सम्भाव्यमूल्यानां अपेक्षया अधिकानि अद्वितीयमूल्यानि पृष्टानि (D operator)"

#: src/libparser/node/explodedicenode.cpp:49
#: src/libparser/node/rerolldicenode.cpp:49
#, qt-format
msgctxt "QObject|"
msgid "Condition (%1) cause an endless loop with this dice: %2"
msgstr "कण्डिशन् (%1) एतेन पासेन सह अनन्तं पाशं जनयति: %2"

#: src/libparser/node/helpnode.cpp:34
#, qt-format
msgctxt "QObject|"
msgid ""
"Rolisteam Dice Parser:\n"
"\n"
"Example (with ! as prefix):\n"
"!2d6\n"
"!1d20\n"
"!6d10e10k3 (L5R)\n"
"\n"
"Full documentation at: %1"
msgstr ""
"रोलिस्टीम पासा पार्सरः : १.\n"
"\n"
"उदाहरणम् (उपसर्गरूपेण ! सह):\n"
"!२d६\n"
"!१घ्२०\n"
"!६ड१०ई१०क३ (L५R) २.\n"
"\n"
"पूर्णदस्तावेजः अत्र: %1"

#: src/libparser/node/helpnode.cpp:61
msgctxt "HelpNode|"
msgid ""
"Rolisteam Dice Parser:\n"
"Full documentation at"
msgstr ""
"रोलिस्टीम पासा पार्सरः : १.\n"
"पूर्ण दस्तावेजीकरण at"

#: src/libparser/node/jumpbackwardnode.cpp:123
msgctxt "QObject|"
msgid ""
" The @ operator expects dice result. Please check the documentation to fix "
"your command."
msgstr ""
" @ संचालकः पासाफलस्य अपेक्षां करोति। कृपया स्वस्य आदेशं निश्चयितुं दस्तावेजीकरणं पश्यन्तु ।"

#: src/libparser/node/keepdiceexecnode.cpp:75
#, qt-format
msgctxt "QObject|"
msgid " You ask to keep %1 dice but the result only has %2"
msgstr " भवान् %1 पासान् स्थापयितुं पृच्छति परन्तु परिणामे केवलं %2 अस्ति"

#: src/libparser/node/listaliasnode.cpp:48
msgctxt "QObject|"
msgid "List of Alias:\n"
msgstr "उपनामस्य सूचीः १.\n"

#: src/libparser/node/listsetrollnode.cpp:71
msgctxt "ListSetRollNode|"
msgid "More unique values asked than possible values (L operator)"
msgstr "सम्भाव्यमूल्यानां अपेक्षया अधिकानि अद्वितीयमूल्यानि पृष्टानि (L operator)"

#: src/libparser/node/mergenode.cpp:34
msgctxt "QObject|"
msgid "No previous node before Merge operator"
msgstr "Merge ऑपरेटर् इत्यस्मात् पूर्वं पूर्वः नोड् नास्ति"

#: src/libparser/node/occurencecountnode.cpp:149
msgctxt "QObject|"
msgid "No matching result"
msgstr "न मेलनं परिणामः"

#: src/libparser/node/paintnode.cpp:63
msgctxt "QObject|"
msgid "No previous node before Paint operator"
msgstr "Paint operator इत्यस्मात् पूर्वं पूर्वं कोऽपि नोड् नास्ति"

#: src/libparser/node/rerolldicenode.cpp:98
msgctxt "QObject|"
msgid ""
" The a operator expects dice result. Please check the documentation and fix "
"your command."
msgstr ""
" a ऑपरेटरः पासान् परिणामं अपेक्षते। कृपया दस्तावेजीकरणं पश्यन्तु, स्वस्य आदेशं च निश्चययन्तु ।"

#: src/libparser/node/scalaroperatornode.cpp:72
#, qt-format
msgctxt "QObject|"
msgid "No Valid result in arithmetic operation: %1"
msgstr "न गणितीयसञ्चालने वैधं परिणामः: %1"

#: src/libparser/node/scalaroperatornode.cpp:139
msgctxt "QObject|"
msgid "Division by zero"
msgstr "शून्येन विभागः"

#: src/libparser/node/variablenode.cpp:39
#, qt-format
msgctxt "QObject|"
msgid "No variable at index:%1"
msgstr "अनुक्रमणिका:%1 इत्यत्र कोऽपि चरः नास्ति"

#: src/libparser/parsingtoolbox.cpp:1446
msgctxt "QObject|"
msgid "Expected closing parenthesis - can't validate the inside."
msgstr "अपेक्षितं समापनकोष्ठकं - अन्तः प्रमाणीकर्तुं न शक्नोति।"

#: src/libparser/parsingtoolbox.cpp:1683
msgctxt "QObject|"
msgid "Validator is missing after the c operator. Please, change it"
msgstr "c ऑपरेटर् इत्यस्य अनन्तरं वैलिडेटरः अनुपलब्धः अस्ति । कृपया, परिवर्तयतु"

#: src/libparser/parsingtoolbox.cpp:1703
#, qt-format
msgctxt "QObject|"
msgid "Validator is always true for the %1 operator. Please, change it"
msgstr "%1 ऑपरेटर् कृते प्रमाणकः सर्वदा सत्यः भवति । कृपया, परिवर्तयतु"

#: src/libparser/parsingtoolbox.cpp:1712
#, qt-format
msgctxt "QObject|"
msgid ""
"Condition can't be reached, causing endless loop. Please, change the %1 "
"option condition"
msgstr "स्थितिः प्राप्तुं न शक्यते, अनन्तं पाशं जनयति । कृपया, %1 विकल्पस्य स्थितिं परिवर्तयन्तु"

#: src/libparser/parsingtoolbox.cpp:1738
#, qt-format
msgctxt "QObject|"
msgid "Validator is missing after the %1 operator. Please, change it"
msgstr "%1 ऑपरेटर् इत्यस्य अनन्तरं प्रमाणकः अनुपलब्धः अस्ति । कृपया, परिवर्तयतु"

#: src/libparser/parsingtoolbox.cpp:1753
#, qt-format
msgctxt "QObject|"
msgid "This condition %1 introduces an endless loop. Please, change it"
msgstr "एषा स्थितिः %1 अनन्तं पाशं प्रवर्तयति । कृपया, परिवर्तयतु"

#: src/libparser/parsingtoolbox.cpp:1769
msgctxt "QObject|"
msgid "Validator is missing after the e operator. Please, change it"
msgstr "ई ऑपरेटर् इत्यस्य अनन्तरं वैलिडेटरः अनुपलब्धः अस्ति । कृपया, परिवर्तयतु"

#: src/libparser/parsingtoolbox.cpp:1847
msgctxt "QObject|"
msgid "Missing parameter for Painter node (p)"
msgstr "Painter node (p) कृते अनुपलब्धः पैरामीटर् ."

#: src/libparser/parsingtoolbox.cpp:2065
#, qt-format
msgctxt "QObject|"
msgid "Dice with %1 face(s) does not exist. Please, put a value higher than 0"
msgstr "%1 मुख(मुखैः) सह पासाः नास्ति । कृपया, 0 इत्यस्मात् अधिकं मूल्यं स्थापयन्तु"

#: src/libparser/parsingtoolbox.cpp:2124
msgctxt "QObject|"
msgid ""
"List is missing after the L operator. Please, add it (e.g : 1L[sword,spear,"
"gun,arrow])"
msgstr ""
"L ऑपरेटर् इत्यस्य अनन्तरं सूची अनुपलब्धा अस्ति । कृपया, योजयतु (उदा : १L[खड्गः,शूलः,बन्दूकः,"
"बाणः])"
