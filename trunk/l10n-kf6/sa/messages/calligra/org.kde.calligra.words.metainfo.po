#: org.kde.calligra.words.metainfo.xml:6
#. (itstool) path: component/name
msgid "Calligra Words"
msgstr "कलिग्रा शब्द"

#: org.kde.calligra.words.metainfo.xml:7
#. (itstool) path: component/summary
msgid "Word Processor"
msgstr "शब्दसंसाधक"

#: org.kde.calligra.words.metainfo.xml:9
#. (itstool) path: description/p
msgid ""
"Words is an intuitive word processor and desktop publisher application. "
"With it, you can create informative and attractive documents with pleasure "
"and ease."
msgstr ""
"शब्दाः एकः सहजः शब्दसंसाधकः डेस्कटॉप् प्रकाशक-अनुप्रयोगः च अस्ति । तेन सह "
"भवान् सुखेन सहजतया च सूचनाप्रदं आकर्षकं च दस्तावेजं निर्मातुम् अर्हति ।"

#: org.kde.calligra.words.metainfo.xml:13
#. (itstool) path: description/p
msgid "Features:"
msgstr "गुणाः:"

#: org.kde.calligra.words.metainfo.xml:15
#. (itstool) path: ul/li
msgid "Frame-based editing"
msgstr "फ्रेम-आधारित सम्पादन"

#: org.kde.calligra.words.metainfo.xml:16
#. (itstool) path: ul/li
msgid "Allows embedding of Documents"
msgstr "Documents इत्यस्य एम्बेडिंग् इत्यस्य अनुमतिं ददाति"

#: org.kde.calligra.words.metainfo.xml:17
#. (itstool) path: ul/li
msgid "Customization of user interface"
msgstr "उपयोक्तृ-अन्तरफलकस्य अनुकूलनम्"

#: org.kde.calligra.words.metainfo.xml:18
#. (itstool) path: ul/li
msgid "Includes all features expected from a modern word processor"
msgstr "आधुनिकशब्दसंसाधकात् अपेक्षितानि सर्वाणि विशेषतानि समाविष्टानि सन्ति"

#: org.kde.calligra.words.metainfo.xml:19
