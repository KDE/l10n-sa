#: org.kde.konsole.appdata.xml:6
#. (itstool) path: component/name
msgid "Konsole"
msgstr "सान्त्वनम्"

#: org.kde.konsole.appdata.xml:7
#. (itstool) path: component/summary
msgid "Use the command line interface"
msgstr "आदेशपङ्क्ति-अन्तरफलकस्य उपयोगं कुर्वन्तु"

#: org.kde.konsole.appdata.xml:12
#. (itstool) path: description/p
msgid ""
"Konsole is a terminal to run a command shell. It provides a command line "
"interface for directly controlling your computer."
msgstr ""
"Konsole इति आदेश-शेल् चालयितुं टर्मिनल् अस्ति । एतत् भवतः सङ्गणकस्य "
"प्रत्यक्षनियन्त्रणार्थं आदेशपङ्क्ति-अन्तरफलकं प्रदाति ।"

#: org.kde.konsole.appdata.xml:13
#. (itstool) path: description/p
msgid "Features:"
msgstr "गुणाः:"

#: org.kde.konsole.appdata.xml:15
#. (itstool) path: ul/li
msgid "Tabs"
msgstr "टब्स्"

#: org.kde.konsole.appdata.xml:16
#. (itstool) path: ul/li
msgid "Multiple profiles"
msgstr "अनेकाः प्रोफाइलाः"

#: org.kde.konsole.appdata.xml:17
#. (itstool) path: ul/li
msgid "Silence and Activity monitoring"
msgstr "मौन एवं गतिविधिनिरीक्षण"

#: org.kde.konsole.appdata.xml:18
#. (itstool) path: ul/li
msgid "Bookmark support"
msgstr "बुकमार्क समर्थनम्"

#: org.kde.konsole.appdata.xml:19
#. (itstool) path: ul/li
msgid "Searching"
msgstr "अन्वेषणम्"

#: org.kde.konsole.appdata.xml:20
#. (itstool) path: ul/li
msgid "Saving output"
msgstr "उत्पादनस्य रक्षणम्"

#: org.kde.konsole.appdata.xml:32
#. (itstool) path: screenshot/caption
msgid "Konsole being used as a terminal emulator"
msgstr "Konsole इत्यस्य उपयोगः टर्मिनल् एमुलेटर् इत्यस्य रूपेण क्रियते"