#: knetattach.ui:24
#. i18n: ectx: property (text), widget (QLabel, textLabel1_2)
#, kde-format
msgid ""
"Select the type of network folder you wish to connect to and press the Next "
"button."
msgstr ""
"यस्य जालपुटस्य प्रकारं भवन्तः संयोजयितुम् इच्छन्ति तत् चित्वा Next बटन् "
"नुदन्तु ।"

