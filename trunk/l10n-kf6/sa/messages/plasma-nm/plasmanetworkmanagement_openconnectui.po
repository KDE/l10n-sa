#: openconnectwebauthdialog.cpp:111
#, kde-format
msgid "Choose a Passkey"
msgstr "एकं Passkey चिनोतु"

#: openconnectwebauthdialog.cpp:112
#, kde-format
msgid "Which passkey do you want to use for %1?"
msgstr "%1 कृते भवान् कस्य पासकील् उपयोक्तुं इच्छति?"

#: openconnectwebauthdialog.cpp:129
#, kde-format
msgid "Ok"
msgstr "अस्तु"

#: openconnectwebauthdialog.cpp:140
#, kde-format
msgid "Use your security key with %1"
msgstr "%1 इत्यनेन सह स्वस्य सुरक्षाकुंजी उपयुज्यताम्"

#: openconnectwebauthdialog.cpp:141
#, kde-format
msgid "Touch your security key again to complete the request."
msgstr "अनुरोधं पूर्णं कर्तुं पुनः स्वस्य सुरक्षाकुंजी स्पृशन्तु।"

#: openconnectwebauthdialog.cpp:158
#, kde-format
msgid "Next"
msgstr "अग्रिम"

#: openconnectwebauthdialog.cpp:167
#, kde-format
msgid "PIN Required"
msgstr "पिन आवश्यक"

#: openconnectwebauthdialog.cpp:168
#, kde-format
msgid "Enter the PIN for your security key"
msgstr "स्वस्य सुरक्षाकुंजी कृते पिन प्रविष्टं कुर्वन्तु"

#: openconnectwebauthdialog.cpp:173
#, kde-format
msgid "New PIN Required"
msgstr "नवीन पिन आवश्यक"

#: openconnectwebauthdialog.cpp:174
#, kde-format
msgid "Set new PIN for your security key"
msgstr "स्वस्य सुरक्षाकुंजी कृते नूतनं PIN सेट् कुर्वन्तु"

#: openconnectwebauthdialog.cpp:176
#, kde-format
msgid "Change PIN Required"
msgstr "पिन परिवर्तनम् आवश्यकम्"

#: openconnectwebauthdialog.cpp:177
#, kde-format
msgid "Change PIN for your security key"
msgstr "स्वस्य सुरक्षाकुंजी कृते पिन परिवर्तयन्तु"

#: openconnectwebauthdialog.cpp:188
#, kde-format
msgid "Internal User Verification Locked"
msgstr "आन्तरिकप्रयोक्तृसत्यापनं ताडितम्"

#: openconnectwebauthdialog.cpp:191
#, kde-format
msgid "Wrong PIN. %1 attempts remaining."
msgstr "गलत पिन। %1 प्रयत्नाः अवशिष्टाः सन्ति ।"

#: openconnectwebauthdialog.cpp:194
#, kde-format
msgid "Too Short. %1 attempts remaining."
msgstr "अति लघु। %1 प्रयत्नाः अवशिष्टाः सन्ति ।"

#: openconnectwebauthdialog.cpp:197
#, kde-format
msgid "Invalid Characters. %1 attempts remaining."
msgstr "अमान्यवर्णाः । %1 प्रयत्नाः अवशिष्टाः सन्ति ।"

#: openconnectwebauthdialog.cpp:201
#, kde-format
msgid "Same as current PIN. %1 attempts remaining."
msgstr "वर्तमानपिनस्य समानम्। %1 प्रयत्नाः अवशिष्टाः सन्ति ।"

#: openconnectwebauthdialog.cpp:239
#, kde-format
msgid "Something went wrong"
msgstr "किमपि भ्रष्टं जातम्"

#: openconnectwebauthdialog.cpp:243
#, kde-format
msgid "Request Timeout"
msgstr "अनुरोधः समयसमाप्तिः"

#: openconnectwebauthdialog.cpp:246
#, kde-format
msgid "Key not registered"
msgstr "कुञ्जी पञ्जीकृता नास्ति"

#: openconnectwebauthdialog.cpp:250
#, kde-format
msgid "You already registered this device.Try again with device"
msgstr "भवान् पूर्वमेव एतत् यन्त्रं पञ्जीकृतवान्।यन्त्रेण पुनः प्रयासं कुर्वन्तु"

#: openconnectwebauthdialog.cpp:256
#, kde-format
msgid ""
"The security key is locked because the wrong PIN was entered too many "
"times.To unlock it, remove and reinsert it."
msgstr ""
"सुरक्षाकुंजी ताडितम् अस्ति यतोहि गलत् पिनः बहुवारं प्रविष्टः आसीत्।तस्य "
"तालान् अनलॉक् कर्तुं, तत् निष्कास्य पुनः सम्मिलितं कुर्वन्तु।"

#: openconnectwebauthdialog.cpp:262
#, kde-format
msgid ""
"The security key is locked because the wrong PIN was entered too many "
"times. You'll need to reset the security key."
msgstr ""
"सुरक्षाकुंजी ताडितम् अस्ति यतोहि गलत् पिनः बहुवारं प्रविष्टः आसीत् । "
"भवद्भिः सुरक्षाकुंजी पुनः सेट् कर्तव्या भविष्यति ।"

#: openconnectwebauthdialog.cpp:266
#, kde-format
msgid "Authenticator removed during verification. Please reinsert and try again"
msgstr ""
"सत्यापनस्य समये प्रमाणकं निष्कासितम्। कृपया पुनः सम्मिलितं कृत्वा पुनः "
"प्रयासं कुर्वन्तु"

#: openconnectwebauthdialog.cpp:269
#, kde-format
msgid "Authenticator doesn't have resident key support"
msgstr "प्रमाणकस्य निवासी कुञ्जीसमर्थनं नास्ति"

#: openconnectwebauthdialog.cpp:272
#, kde-format
msgid "Authenticator missing user verification"
msgstr "प्रमाणककर्ता उपयोक्तृसत्यापनं गम्यते"

#: openconnectwebauthdialog.cpp:275
#, kde-format
msgid "Authenticator missing Large Blob support"
msgstr "प्रमाणीकरणकर्ता Large Blob समर्थनम् अनुपलब्धम्"

#: openconnectwebauthdialog.cpp:278
#, kde-format
msgid "No common algorithms"
msgstr "सामान्यं एल्गोरिदम् नास्ति"

#: openconnectwebauthdialog.cpp:281
#, kde-format
msgid "Storage Full"
msgstr "भण्डारण पूर्ण"

#: openconnectwebauthdialog.cpp:284
#, kde-format
