#: pptpadvanced.ui:17
#. i18n: ectx: property (title), widget (QGroupBox, grp_authenfication)
#, kde-format
msgid "Authentication"
msgstr "प्रमाणीकरणम्"

#: pptpadvanced.ui:26
#. i18n: ectx: property (text), widget (QLabel, lbl_auth)
#, kde-format
msgid "Allow following authentication methods:"
msgstr "निम्नलिखित प्रमाणीकरणविधयः अनुमन्यताम् : १."

#: pptpadvanced.ui:36
#. i18n: ectx: property (toolTip), widget (QListWidget, listWidget)
#, kde-format
msgid "Allow/disable authentication methods."
msgstr "प्रमाणीकरणविधयः अनुमन्यताम्/अक्षमं कुर्वन्तु।"

#: pptpadvanced.ui:40
#. i18n: ectx: property (text), item, widget (QListWidget, listWidget)
#, kde-format
msgid "PAP"
msgstr "PAP"

#: pptpadvanced.ui:48
#. i18n: ectx: property (text), item, widget (QListWidget, listWidget)
#, kde-format
msgid "CHAP"
msgstr "अध्याय"

#: pptpadvanced.ui:56
#. i18n: ectx: property (text), item, widget (QListWidget, listWidget)
#, kde-format
msgid "MSCHAP"
msgstr "MSCHAP"

#: pptpadvanced.ui:64
#. i18n: ectx: property (text), item, widget (QListWidget, listWidget)
#, kde-format
msgid "MSCHAPv2"
msgstr "MSCHAPv2"

#: pptpadvanced.ui:72
#. i18n: ectx: property (text), item, widget (QListWidget, listWidget)
#, kde-format
msgid "EAP"
msgstr "ईएपी"

#: pptpadvanced.ui:88
#. i18n: ectx: property (toolTip), widget (QGroupBox, gb_MPPE)
#, kde-format
msgid ""
"Note: MPPE encryption is only available with MSCHAP authentication methods. "
"To\n"
"enable this checkbox, select one or more of the MSCHAP authentication\n"
"methods: MSCHAP or MSCHAPv2."
msgstr ""
"नोट्: MPPE एन्क्रिप्शन केवलं MSCHAP प्रमाणीकरणविधिभिः सह एव उपलभ्यते । "
"इत्यस्मै\n"
"एतत् चेकबॉक्सं सक्षमं कुर्वन्तु, MSCHAP प्रमाणीकरणस्य एकं वा अधिकं वा "
"चिनोतु\n"
"विधियाः : MSCHAP अथवा MSCHAPv2।"

#: pptpadvanced.ui:91
#. i18n: ectx: property (title), widget (QGroupBox, gb_MPPE)
#, kde-format
msgid "Use MPPE Encryption"
msgstr "MPPE Encryption इत्यस्य उपयोगं कुर्वन्तु"

#: pptpadvanced.ui:112
#. i18n: ectx: property (text), widget (QLabel, lbl_MMPEcrypto)
#, kde-format
msgid "Crypto:"
msgstr "क्रिप्टो : १."

#: pptpadvanced.ui:128
#. i18n: ectx: property (toolTip), widget (QComboBox, cb_MPPECrypto)
#, kde-format
msgid "Require the use of MPPE, with 40/128-bit encryption or all."
msgstr "MPPE इत्यस्य उपयोगः आवश्यकः, 40/128-बिट् एन्क्रिप्शनेन सह वा सर्वैः सह ।"

#: pptpadvanced.ui:137
#. i18n: ectx: property (text), item, widget (QComboBox, cb_MPPECrypto)
#, kde-format
msgid "128 bit"
msgstr "१२८ बिट्"

#: pptpadvanced.ui:142
#. i18n: ectx: property (text), item, widget (QComboBox, cb_MPPECrypto)
#, kde-format
msgid "40 bit"
msgstr "४० बिट्"

#: pptpadvanced.ui:150
#. i18n: ectx: property (toolTip), widget (QCheckBox, cb_statefulEncryption)
#, kde-format
msgid "Allow MPPE to use stateful mode. Stateless mode is still attempted first."
msgstr ""
"MPPE इत्यस्य स्टेटफुल् मोड् इत्यस्य उपयोगं कर्तुं अनुमतिं ददातु । "
"राज्यरहितविधिः अद्यापि प्रथमं प्रयत्नः क्रियते ।"

#: pptpadvanced.ui:153
#. i18n: ectx: property (text), widget (QCheckBox, cb_statefulEncryption)
#, kde-format
msgid "Use stateful encryption"
msgstr "स्टेटफुल् एन्क्रिप्शनस्य उपयोगं कुर्वन्तु"

#: pptpadvanced.ui:163
#. i18n: ectx: property (title), widget (QGroupBox, grp_cryptoAndCompression)
#, kde-format
msgid "Compression"
msgstr "संपीडनम्"

#: pptpadvanced.ui:175
#. i18n: ectx: property (toolTip), widget (QCheckBox, cb_BSD)
#, kde-format
msgid "Allow/disable BSD-Compress compression."
msgstr "BSD-Compress संपीडनं अनुमन्यताम्/अक्षमं कुर्वन्तु।"

#: pptpadvanced.ui:178
#. i18n: ectx: property (text), widget (QCheckBox, cb_BSD)
#, kde-format
msgid "Allow BSD compression"
msgstr "BSD संपीडनं अनुमन्यताम्"

#: pptpadvanced.ui:188
#. i18n: ectx: property (toolTip), widget (QCheckBox, cb_deflate)
#, kde-format
msgid "Allow/disable Deflate compression."
msgstr "संपीडनं Deflate अनुमन्यताम्/अक्षमं कुर्वन्तु।"

#: pptpadvanced.ui:191
#. i18n: ectx: property (text), widget (QCheckBox, cb_deflate)
#, kde-format
msgid "Allow Deflate compression"
msgstr "Deflate compression इत्यस्य अनुमतिं ददातु"

#: pptpadvanced.ui:202
#. i18n: ectx: property (toolTip), widget (QCheckBox, cb_TCPheaders)
#, kde-format
msgid ""
"Allow/disable Van Jacobson style TCP/IP header compression in both the "
"transmit\n"
" and the receive directions."
msgstr ""
"उभयत्र संचरणयोः Van Jacobson शैली TCP/IP शीर्षकसंपीडनं अनुमन्यताम्/अक्षमं "
"कुर्वन्तु\n"
" ग्रहणदिशाश्च ।"

#: pptpadvanced.ui:205
#. i18n: ectx: property (text), widget (QCheckBox, cb_TCPheaders)
#, kde-format
msgid "Allow TCP header compression"
msgstr "TCP शीर्षकसंपीडनं अनुमन्यताम्"

#: pptpadvanced.ui:218
#. i18n: ectx: property (title), widget (QGroupBox, grp_echo)
#, kde-format
msgid "Echo"
msgstr "प्रतिध्वनि"

#: pptpadvanced.ui:227
#. i18n: ectx: property (toolTip), widget (QCheckBox, cb_sendEcho)
#, kde-format
msgid "Send LCP echo-requests to find out whether peer is alive."
msgstr "सहपाठी जीवितः अस्ति वा इति ज्ञातुं LCP प्रतिध्वनि-अनुरोधं प्रेषयन्तु।"

#: pptpadvanced.ui:230
#. i18n: ectx: property (text), widget (QCheckBox, cb_sendEcho)
#, kde-format
msgid "Send PPP echo packets "
msgstr "PPP echo packets प्रेषयन्तु "

#: pptpauth.ui:14
#. i18n: ectx: property (windowTitle), widget (QWidget,
#. PptpAuthenticationWidget)
#, kde-format
msgid "PPTPAuthentication"
msgstr "पीपीटीपीएप्रमाणीकरण"

#: pptpauth.ui:38 pptpprop.ui:115
#. i18n: ectx: property (text), widget (QLabel, textLabel1)
#. i18n: ectx: property (text), widget (QLabel, lbl_password)
#, kde-format
msgid "Password:"
msgstr "समाभाष्:"

#: pptpauth.ui:51 pptpprop.ui:131
#. i18n: ectx: property (toolTip), widget (PasswordField, lePassword)
#. i18n: ectx: property (toolTip), widget (PasswordField, edt_password)
#, kde-format
msgid "Password passed to PPTP when prompted for it."
msgstr "तस्य कृते प्रार्थितस्य गुप्तशब्दः PPTP कृते पारितः।"

#: pptpprop.ui:14
#. i18n: ectx: property (windowTitle), widget (QWidget, PptpProp)
#, kde-format
msgid "PPTP Settings"
msgstr "PPTP सेटिंग्स्"

#: pptpprop.ui:34
#. i18n: ectx: property (text), widget (QLabel, lbl_gateway)
#, kde-format
msgid "Gateway:"
msgstr "प्रवेशद्वारः : १."

#: pptpprop.ui:47
#. i18n: ectx: property (toolTip), widget (QLineEdit, edt_gateway)
#, kde-format
msgid "PPTP server IP or name."
msgstr "PPTP सर्वर IP अथवा नाम।"

#: pptpprop.ui:80
#. i18n: ectx: property (text), widget (QLabel, lbl_login)
#, kde-format
msgid "Login:"
msgstr "प्रवेशः : १."

#: pptpprop.ui:93
#. i18n: ectx: property (toolTip), widget (QLineEdit, edt_login)
#, kde-format
msgid "Set the name used for authenticating the local system to the peer to <name>."
msgstr ""
"स्थानीयतन्त्रस्य प्रमाणीकरणार्थं प्रयुक्तं नाम समकक्षं प्रति <name> इति "
"सेट् कुर्वन्तु ।"

#: pptpprop.ui:153
#. i18n: ectx: property (text), widget (QLabel, lbl_ntdomain)
#, kde-format
msgid "NT Domain:"
msgstr "एन टी डोमेन : १."

#: pptpprop.ui:167
#. i18n: ectx: property (toolTip), widget (QLineEdit, edt_ntDomain)
#, kde-format
msgid ""
"Append the domain name <domain> to the local host name for\n"
"authenticating purposes."
msgstr ""
"कृते स्थानीयहोस्ट् नाम्ने <domain> इति डोमेननाम योजयन्तु\n"
"प्रमाणीकरणप्रयोजनानि।"

#: pptpadvanced.ui:132
#. i18n: ectx: property (text), item, widget (QComboBox, cb_MPPECrypto)
#, kde-format
msgctxt "like in use Any configuration"
msgid "Any"
msgstr "कश्चित्‌"

