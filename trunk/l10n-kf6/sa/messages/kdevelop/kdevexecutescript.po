#: executescriptplugin.cpp:61
#, kde-format
msgid "No valid executable specified"
msgstr "वैधः कार्यान्वयनीयः निर्दिष्टः नास्ति"

#: executescriptplugin.cpp:71
#, kde-format
msgid ""
"There is a quoting error in the script for the launch configuration '%1'. "
"Aborting start."
msgstr ""
"'%1' इत्यस्य प्रक्षेपणविन्यासस्य स्क्रिप्ट् मध्ये उद्धरणदोषः अस्ति । "
"गर्भपातस्य आरम्भः।"

#: executescriptplugin.cpp:76
#, kde-format
msgid ""
"A shell meta character was included in the script for the launch "
"configuration '%1', this is not supported currently. Aborting start."
msgstr ""
"'%1' इत्यस्य प्रक्षेपणविन्यासस्य स्क्रिप्ट् मध्ये एकः शेल् मेटा वर्णः "
"समाविष्टः आसीत्, एतत् सम्प्रति समर्थितं नास्ति । गर्भपातस्य आरम्भः।"

#: executescriptplugin.cpp:93
#, kde-format
msgid "No remote host set for launch configuration '%1'. Aborting start."
msgstr ""
"'%1' इत्यस्य प्रारम्भविन्यासस्य कृते दूरस्थः होस्ट् सेट् नास्ति । "
"गर्भपातस्य आरम्भः।"

#: executescriptplugin.cpp:116
#, kde-format
msgid ""
"There is a quoting error in the arguments for the launch configuration "
"'%1'. Aborting start."
msgstr ""
"'%1' इत्यस्य प्रक्षेपणविन्यासस्य तर्कयोः उद्धरणदोषः अस्ति । गर्भपातस्य "
"आरम्भः।"

#: executescriptplugin.cpp:120
#, kde-format
msgid ""
"A shell meta character was included in the arguments for the launch "
"configuration '%1', this is not supported currently. Aborting start."
msgstr ""
"'%1' इत्यस्य प्रक्षेपणविन्यासस्य तर्केषु शेल् मेटा वर्णः समाविष्टः आसीत्, "
"एतत् सम्प्रति समर्थितं नास्ति । गर्भपातस्य आरम्भः।"

#: executescriptplugin.cpp:173
#, kde-format
msgid "No valid interpreter specified"
msgstr "वैधः व्याख्याकारः निर्दिष्टः नास्ति"

#: executescriptplugin.cpp:183
#, kde-format
msgid ""
"There is a quoting error in the interpreter for the launch configuration "
"'%1'. Aborting start."
msgstr ""
"'%1' इत्यस्य प्रक्षेपणविन्यासस्य व्याख्याकारे उद्धरणदोषः अस्ति । गर्भपातस्य "
"आरम्भः।"

#: executescriptplugin.cpp:188
#, kde-format
msgid ""
"A shell meta character was included in the interpreter for the launch "
"configuration '%1', this is not supported currently. Aborting start."
msgstr ""
"'%1' इत्यस्य प्रक्षेपणविन्यासस्य कृते व्याख्याकारे एकः शेल् मेटा वर्णः "
"समाविष्टः आसीत्, एतत् सम्प्रति समर्थितं नास्ति । गर्भपातस्य आरम्भः।"

#: scriptappconfig.cpp:126
#, kde-format
msgid "Executes Script Applications"
msgstr "स्क्रिप्ट् अनुप्रयोगाः निष्पादयति"

#: scriptappconfig.cpp:136 scriptappconfig.cpp:186
#, kde-format
msgid "Script Application"
msgstr "स्क्रिप्ट अनुप्रयोग"

#: scriptappjob.cpp:76
#, kde-format
msgid "There is no active document to launch."
msgstr "प्रक्षेपणार्थं सक्रियदस्तावेजं नास्ति ।"

#: scriptappjob.cpp:98
#, kde-format
msgid ""
"No environment profile specified, looks like a broken configuration, please "
"check run configuration '%1'. Using default environment profile."
msgstr ""
"कोऽपि वातावरणरूपरेखा निर्दिष्टा, भग्नविन्यासः इव दृश्यते, कृपया '%1' "
"चालनविन्यासं परीक्ष्यताम् । पूर्वनिर्धारितपर्यावरणरूपरेखायाः उपयोगेन।"

#: scriptappjob.cpp:170
#, kde-format
msgid "Starting: %1"
msgstr "आरम्भः : %1"

#: scriptappjob.cpp:184
#, kde-format
msgid "*** Killed Application ***"
msgstr "*** मारितः अनुप्रयोगः *** ."

#: scriptappjob.cpp:195
#, kde-format
msgid "*** Exited normally ***"
msgstr "*** सामान्यतः निर्गतः *** ."

#: scriptappjob.cpp:197
#, kde-format
msgid "*** Exited with return code: %1 ***"
msgstr "*** रिटर्न् कोडेन सह निर्गतम्: %1 ***"

#: scriptappjob.cpp:200
#, kde-format
msgid "*** Process aborted ***"
msgstr "*** प्रक्रिया निरस्त *** ."

#: scriptappjob.cpp:203
#, kde-format
msgid "*** Crashed with return code: %1 ***"
msgstr "*** रिटर्न् कोडेन सह दुर्घटनाम् अभवत्: %1 ***"

#: scriptappjob.cpp:218
#, kde-format
msgid ""
"*** Could not start program '%1'. Make sure that the path is specified "
"correctly ***"
msgstr ""
"*** '%1' इति कार्यक्रमं आरभुं न शक्तम् । मार्गः सम्यक् निर्दिष्टः इति "
"सुनिश्चितं कुर्वन्तु *** ."

