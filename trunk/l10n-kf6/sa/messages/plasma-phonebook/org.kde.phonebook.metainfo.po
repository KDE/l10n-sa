#. (itstool) path: component/name
msgid "Phonebook"
msgstr "दूरभाषपुस्तिका"

#: org.kde.phonebook.metainfo.xml:5
#. (itstool) path: component/summary
msgid "View and edit contacts"
msgstr "सम्पर्कं पश्यन्तु सम्पादयन्तु च"

#: org.kde.phonebook.metainfo.xml:8
