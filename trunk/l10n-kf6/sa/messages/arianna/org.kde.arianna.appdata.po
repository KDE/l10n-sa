#: org.kde.arianna.appdata.xml:11
#. (itstool) path: component/name
msgid "Arianna"
msgstr "एरियान्ना"

#: org.kde.arianna.appdata.xml:12
#. (itstool) path: component/summary
msgid "EBook reader"
msgstr "ईपुस्तक पाठक"

#: org.kde.arianna.appdata.xml:14
#. (itstool) path: description/p
msgid ""
"An ebook reader and library management app supporting \".epub\" files. "
"Arianna discovers your books automatically, and sorts them by categories, "
"genres and authors."
msgstr ""
"\".epub\" सञ्चिकानां समर्थनं कुर्वन् एकः ईपुस्तकपाठकः "
"पुस्तकालयप्रबन्धन-अनुप्रयोगः च । एरियाना भवतः पुस्तकानि स्वयमेव आविष्करोति, "
"श्रेणीभिः, विधैः, लेखकैः च क्रमेण क्रमयति ।"

#: org.kde.arianna.appdata.xml:22
