msgstr "स्लाइस् घड़ीयानदिशायां वा प्रतिघटिकादिशायां वा आकृष्टव्याः इति परिभाषयन्तु ।"

#: rkward/plugins/plots/piechart.rkh:31
#. i18n: ectx: (Loaded from Pie chart) <settings> <setting> (refers to element
#. labelled "Radius")
#, kde-format
msgid ""
