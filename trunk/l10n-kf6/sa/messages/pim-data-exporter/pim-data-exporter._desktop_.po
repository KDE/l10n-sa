#: gui/org.kde.pimdataexporter.desktop:2
msgctxt "Name"
msgid "PIM Data Exporter"
msgstr "पीआईएम डाटा निर्यातक"

#: gui/org.kde.pimdataexporter.desktop:46
msgctxt "GenericName"
msgid "Saves and restores all data from PIM apps"
msgstr "PIM apps तः सर्वाणि आँकडानि रक्षति पुनर्स्थापयति च"

#: gui/org.kde.pimdataexporter.desktop:87
msgctxt "Comment"
msgid ""
"PIM Setting Exporter allows to save all data from PIM apps and restore them "
"in other systems."
msgstr ""
"PIM Setting Exporter इत्यनेन PIM apps तः सर्वाणि आँकडानि रक्षितुं अन्येषु प्रणालीषु पुनः "
"स्थापयितुं च शक्यते ।"
