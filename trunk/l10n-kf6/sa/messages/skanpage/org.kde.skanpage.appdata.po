#: org.kde.skanpage.appdata.xml:14
#. (itstool) path: component/name
msgid "Skanpage"
msgstr "पृष्ठं स्कैन कुर्वन्तु"

#: org.kde.skanpage.appdata.xml:15
#. (itstool) path: component/summary
msgid "Scan multi-page documents and images"
msgstr "बहुपृष्ठीयदस्तावेजान् चित्राणि च स्कैन कुर्वन्तु"

#: org.kde.skanpage.appdata.xml:17
#. (itstool) path: description/p
msgid ""
"Skanpage is a simple scanning application optimized for multi-page document "
"scanning. It can also scan and save single-page documents and images."
msgstr ""
"Skanpage बहुपृष्ठीयदस्तावेजस्कैनिङ्गार्थं अनुकूलितं सरलं "
"स्कैनिङ्ग-अनुप्रयोगम् अस्ति । एकपृष्ठीयदस्तावेजान् चित्राणि च स्कैन् कृत्वा "
"रक्षितुं शक्नोति ।"

#: org.kde.skanpage.appdata.xml:18
#. (itstool) path: description/p
msgid "Features:"
msgstr "गुणाः:"

#: org.kde.skanpage.appdata.xml:20
#. (itstool) path: ul/li
msgid "Scanning from flatbed and ADF scanners"
msgstr "फ्लैटबेड् तथा एडीएफ स्कैनरतः स्कैनिङ्गम्"

#: org.kde.skanpage.appdata.xml:21
#. (itstool) path: ul/li
msgid "Configurable options for scanning device"
msgstr "स्कैनिङ्ग उपकरणस्य कृते विन्यासयोग्याः विकल्पाः"

#: org.kde.skanpage.appdata.xml:22
#. (itstool) path: ul/li
msgid "Reordering, rotation, and deletion of scanned pages"
msgstr "स्कैन् कृतानां पृष्ठानां पुनर्क्रमणं, परिभ्रमणं, विलोपनं च"

#: org.kde.skanpage.appdata.xml:23
#. (itstool) path: ul/li
msgid "Saving to multi-page PDF documents and image files"
msgstr "बहुपृष्ठीय PDF दस्तावेजेषु चित्रसञ्चिकासु च रक्षणम्"

#: org.kde.skanpage.appdata.xml:29
#. (itstool) path: screenshot/caption
msgid "Skanpage main window"
msgstr "Skanpage मुख्यविण्डो"
