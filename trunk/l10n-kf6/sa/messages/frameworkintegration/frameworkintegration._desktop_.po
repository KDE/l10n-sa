#: plasma_workspace.notifyrc:3
msgctxt "Comment"
msgid "System Notifications"
msgstr "प्रणाली सूचनाएँ"

#: plasma_workspace.notifyrc:41
msgctxt "Name"
msgid "Trash: Emptied"
msgstr "कचरा : रिक्त"

#: plasma_workspace.notifyrc:95
msgctxt "Comment"
msgid "The trash has been emptied"
msgstr "कचरा रिक्तं कृतम् अस्ति"

#: plasma_workspace.notifyrc:153
msgctxt "Name"
msgid "Textcompletion: Rotation"
msgstr "पाठसमाप्तिः - परिभ्रमणम्"

#: plasma_workspace.notifyrc:206
msgctxt "Comment"
msgid "The end of the list of matches has been reached"
msgstr "मेलनानां सूचीयाः समाप्तिः प्राप्ता अस्ति"

#: plasma_workspace.notifyrc:263
msgctxt "Name"
msgid "Textcompletion: No Match"
msgstr "पाठसमाप्तिः : No Match"

#: plasma_workspace.notifyrc:316
msgctxt "Comment"
msgid "No matching completion was found"
msgstr "कोऽपि मेलसमाप्तिः न प्राप्ता"

#: plasma_workspace.notifyrc:373
msgctxt "Name"
msgid "Textcompletion: Partial Match"
msgstr "पाठसमाप्तिः : आंशिकमेलनम्"

#: plasma_workspace.notifyrc:426
msgctxt "Comment"
msgid "There is more than one possible match"
msgstr "एकादशाधिकः सम्भाव्यः मेलः अस्ति"

#: plasma_workspace.notifyrc:484
msgctxt "Name"
msgid "Fatal Error"
msgstr "घातक त्रुटिः"

#: plasma_workspace.notifyrc:539
msgctxt "Comment"
msgid "There was a serious error causing the program to exit"
msgstr "कार्यक्रमस्य निर्गमनस्य कारणेन गम्भीरदोषः अभवत्"

#: plasma_workspace.notifyrc:597
msgctxt "Name"
msgid "Notification"
msgstr "अधिसूचना"

#: plasma_workspace.notifyrc:652
msgctxt "Comment"
msgid "Something special happened in the program"
msgstr "कार्यक्रमे किञ्चित् विशेषं घटितम्"

#: plasma_workspace.notifyrc:709
msgctxt "Name"
msgid "Warning"
msgstr "चेतवानी"

#: plasma_workspace.notifyrc:764
msgctxt "Comment"
msgid "There was an error in the program which may cause problems"
msgstr "कार्यक्रमे त्रुटिः आसीत् या समस्यां जनयितुं शक्नोति"

#: plasma_workspace.notifyrc:822
msgctxt "Name"
msgid "Catastrophe"
msgstr "प्रलय"

#: plasma_workspace.notifyrc:876
msgctxt "Comment"
msgid "A very serious error occurred, at least causing the program to exit"
msgstr "अतीव गम्भीरः दोषः अभवत्, न्यूनातिन्यूनं कार्यक्रमस्य निर्गमनस्य कारणम्"

#: plasma_workspace.notifyrc:933
msgctxt "Name"
msgid "Application Crash"
msgstr "अनुप्रयोग दुर्घटना"

#: plasma_workspace.notifyrc:984
msgctxt "Comment"
msgid "An application just closed unexpectedly"
msgstr "एकः अनुप्रयोगः केवलं अप्रत्याशितरूपेण बन्दः अभवत्"

#: plasma_workspace.notifyrc:1037
msgctxt "Name"
msgid "Login"
msgstr "प्रवेशः"

#: plasma_workspace.notifyrc:1091
msgctxt "Comment"
msgid "A new session is starting"
msgstr "नूतनं सत्रं आरभ्यते"

#: plasma_workspace.notifyrc:1148
msgctxt "Name"
msgid "Logout"
msgstr "लॉगआउट"

#: plasma_workspace.notifyrc:1202
msgctxt "Comment"
msgid "Session is exiting"
msgstr "सत्रं निर्गच्छति"

#: plasma_workspace.notifyrc:1260
msgctxt "Name"
msgid "Logout Canceled"
msgstr "लॉगआउट रद्द"

#: plasma_workspace.notifyrc:1314
msgctxt "Comment"
msgid "Plasma logout was canceled"
msgstr "प्लाज्मा लॉगआउट् रद्दः अभवत्"

#: plasma_workspace.notifyrc:1371
msgctxt "Name"
msgid "Print Error"
msgstr "मुद्रणदोषः"

#: plasma_workspace.notifyrc:1426
msgctxt "Comment"
msgid "A print error has occurred"
msgstr "मुद्रणदोषः अभवत्"

#: plasma_workspace.notifyrc:1484
msgctxt "Name"
msgid "Information Message"
msgstr "सूचना सन्देश"

#: plasma_workspace.notifyrc:1539
msgctxt "Comment"
msgid "An information message is being shown"
msgstr "सूचनासन्देशः दर्शितः अस्ति"

#: plasma_workspace.notifyrc:1597
msgctxt "Name"
msgid "Warning Message"
msgstr "चेतावनी सन्देशः"

#: plasma_workspace.notifyrc:1652
msgctxt "Comment"
msgid "A warning message is being shown"
msgstr "चेतावनीसन्देशः दर्शितः अस्ति"

#: plasma_workspace.notifyrc:1710
msgctxt "Name"
msgid "Critical Message"
msgstr "आलोचनात्मक सन्देश"

#: plasma_workspace.notifyrc:1765
msgctxt "Comment"
msgid "A critical message is being shown"
msgstr "एकः समीक्षात्मकः सन्देशः दर्शितः अस्ति"

#: plasma_workspace.notifyrc:1823
msgctxt "Name"
msgid "Question"
msgstr "प्रश्न"

#: plasma_workspace.notifyrc:1878
msgctxt "Comment"
msgid "A question is being asked"
msgstr "एकः प्रश्नः पृष्टः अस्ति"

#: plasma_workspace.notifyrc:1937
msgctxt "Name"
msgid "Beep"
msgstr "बीप"

#: plasma_workspace.notifyrc:1991
msgctxt "Comment"
msgid "Sound bell"
msgstr "ध्वनि घण्टा"

#: plasma_workspace.notifyrc:2048
msgctxt "Name"
msgid "Widget failed to install"
msgstr "विजेट् संस्थापनं कर्तुं असफलम् अभवत्"

#: plasma_workspace.notifyrc:2099
msgctxt "Comment"
msgid "A widget could not be installed"
msgstr "विजेट् संस्थापयितुं न शक्यते स्म"

#: plasma_workspace.notifyrc:2153
msgctxt "Name"
msgid "Widget deleted"
msgstr "विजेट् विलोपितम्"

#: plasma_workspace.notifyrc:2206
msgctxt "Comment"
msgid "A widget has been deleted"
msgstr "एकः विजेट् विलोपितः अस्ति"

#: plasma_workspace.notifyrc:2262
msgctxt "Name"
msgid "Device plugged in"
msgstr "यन्त्रं प्लग् कृतम्"

#: plasma_workspace.notifyrc:2301
msgctxt "Comment"
msgid "A device was plugged in"
msgstr "एकं यन्त्रं प्लग् कृतम् आसीत्"

#: plasma_workspace.notifyrc:2345
msgctxt "Name"
msgid "Device unplugged"
msgstr "उपकरणं अनप्लग् कृतम्"

#: plasma_workspace.notifyrc:2384
msgctxt "Comment"
msgid "A device was unplugged"
msgstr "एकं यन्त्रं अनप्लग् कृतम् आसीत्"
