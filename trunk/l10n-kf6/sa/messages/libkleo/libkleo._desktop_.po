msgctxt "Name"
msgid "md5sum"
msgstr "अहम् md5"

#: src/libkleopatrarc.desktop:344 src/libkleopatrarc-win32.desktop:209
msgctxt "Name"
msgid "Expired"
msgstr "परीत"

#: src/libkleopatrarc.desktop:371 src/libkleopatrarc-win32.desktop:236
msgctxt "Description"
msgid ""
"Certificates that are invalid because they have expired (except disabled "
"ones)"
msgstr "ये प्रमाणपत्राणि अमान्यानि यतः तेषां अवधिः समाप्तः अस्ति (अक्षमान् विहाय)"

#: src/libkleopatrarc.desktop:397 src/libkleopatrarc-win32.desktop:262
msgctxt "Name"
msgid "Revoked"
msgstr "निरस्त"

#: src/libkleopatrarc.desktop:424 src/libkleopatrarc-win32.desktop:289
msgctxt "Description"
msgid ""
"Certificates that are invalid because they have been revoked (except "
"disabled ones)"
msgstr "यत् प्रमाणपत्रं निरस्तं कृत्वा अमान्यम् (अक्षमान् विहाय)"

#: src/libkleopatrarc.desktop:451 src/libkleopatrarc-win32.desktop:316
msgctxt "Name"
msgid "Trusted Root Certificates"
msgstr "विश्वसनीय मूलप्रमाणपत्रम्"

#: src/libkleopatrarc.desktop:478 src/libkleopatrarc-win32.desktop:343
msgctxt "Description"
msgid "S/MIME root certificates that are trusted"
msgstr "S/MIME मूलप्रमाणपत्राणि ये विश्वसनीयाः सन्ति"

#: src/libkleopatrarc.desktop:511 src/libkleopatrarc-win32.desktop:376
msgctxt "Name"
msgid "Not Trusted Root Certificates"
msgstr "न विश्वसनीयाः मूलप्रमाणपत्राणि"

#: src/libkleopatrarc.desktop:538 src/libkleopatrarc-win32.desktop:403
msgctxt "Description"
msgid "S/MIME root certificates that are not trusted"
msgstr "S/MIME मूलप्रमाणपत्राणि ये विश्वसनीयाः न सन्ति"

#: src/libkleopatrarc.desktop:568 src/libkleopatrarc-win32.desktop:433
msgctxt "Name"
msgid "For Qualified Signatures"
msgstr "योग्यहस्ताक्षराणां कृते"

#: src/libkleopatrarc.desktop:595 src/libkleopatrarc-win32.desktop:460
msgctxt "Description"
msgid "Certificates usable for qualified signatures"
msgstr "योग्यहस्ताक्षराणां कृते उपयोगी प्रमाणपत्राणि"

#: src/libkleopatrarc.desktop:625 src/libkleopatrarc-win32.desktop:490
msgctxt "Name"
msgid "On Smart Card"
