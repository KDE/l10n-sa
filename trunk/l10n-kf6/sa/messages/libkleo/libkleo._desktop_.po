#: src/libkleopatrarc.desktop:540 src/libkleopatrarc-win32.desktop:403
msgctxt "Name"
msgid "Not Trusted Root Certificates"
msgstr "न विश्वसनीयाः मूलप्रमाणपत्राणि"

#: src/libkleopatrarc.desktop:570 src/libkleopatrarc-win32.desktop:433
msgctxt "Description"
msgid "S/MIME root certificates that are not trusted"
msgstr "S/MIME मूलप्रमाणपत्राणि ये विश्वसनीयाः न सन्ति"

#: src/libkleopatrarc.desktop:604 src/libkleopatrarc-win32.desktop:467
