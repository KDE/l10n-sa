#: src/libkleopatrarc.desktop:1243 src/libkleopatrarc-win32.desktop:1105
msgctxt "Description"
msgid "Certificates that are disabled"
msgstr "प्रमाणपत्राणि ये अक्षमानि सन्ति"

#: src/libkleopatrarc.desktop:1281 src/libkleopatrarc-win32.desktop:1143
msgctxt "Name"
msgid "My Own"
msgstr "मम स्वकीयः"

#: src/libkleopatrarc.desktop:1313 src/libkleopatrarc-win32.desktop:1175
msgctxt "Description"
