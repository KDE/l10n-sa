msgctxt "Description"
msgid "OpenPGP certificates (except disabled ones)"
msgstr "OpenPGP प्रमाणपत्राणि (अक्षमान् विहाय)"

#: src/libkleopatrarc.desktop:732 src/libkleopatrarc-win32.desktop:597
msgctxt "Name"
msgid "S/MIME"
msgstr "S/MIME"

#: src/libkleopatrarc.desktop:759 src/libkleopatrarc-win32.desktop:624
msgctxt "Description"
msgid "S/MIME certificates"
msgstr "S/MIME प्रमाणपत्राणि"

#: src/libkleopatrarc.desktop:794 src/libkleopatrarc-win32.desktop:659
msgctxt "Name"
msgid "VS-NfD Compliant"
msgstr "VS-NfD अनुरूप"

#: src/libkleopatrarc.desktop:829 src/libkleopatrarc-win32.desktop:694
msgctxt "Description"
msgid "Certificates that are VS-NfD compliant (except disabled ones)"
msgstr "प्रमाणपत्राणि ये VS-NfD अनुरूपाः सन्ति (अक्षमान् विहाय)"

#: src/libkleopatrarc.desktop:859 src/libkleopatrarc-win32.desktop:724
msgctxt "Name"
msgid "Not VS-NfD Compliant"
msgstr "न VS-NfD अनुरूपम्"

#: src/libkleopatrarc.desktop:894 src/libkleopatrarc-win32.desktop:759
msgctxt "Description"
msgid "Certificates that are not VS-NfD compliant (except disabled ones)"
msgstr "प्रमाणपत्राणि ये VS-NfD अनुरूपाः न सन्ति (अक्षमान् विहाय)"

#: src/libkleopatrarc.desktop:926 src/libkleopatrarc-win32.desktop:791
msgctxt "Name"
msgid "Not VS-NfD Compliant (Expired)"
msgstr "VS-NfD अनुरूपं नास्ति (समाप्तः)"

#: src/libkleopatrarc.desktop:959 src/libkleopatrarc-win32.desktop:824
msgctxt "Description"
msgid ""
"Expired certificates (if VS-NfD compliance mode is active, except disabled "
"ones)"
msgstr ""
"अवधिसमाप्तप्रमाणपत्राणि (यदि VS-NfD अनुपालनविधिः सक्रियः अस्ति, अक्षमान् विहाय)"

#: src/libkleopatrarc.desktop:990 src/libkleopatrarc-win32.desktop:855
msgctxt "Name"
msgid "Not VS-NfD Compliant (Revoked)"
msgstr "VS-NfD अनुरूपं नास्ति (निरस्तम्)"

#: src/libkleopatrarc.desktop:1023 src/libkleopatrarc-win32.desktop:888
msgctxt "Description"
msgid ""
"Revoked certificates (if VS-NfD compliance mode is active, except disabled "
"ones)"
msgstr "निरस्तप्रमाणपत्राणि (यदि VS-NfD अनुपालनविधिः सक्रियः अस्ति, अक्षमान् विहाय)"

#: src/libkleopatrarc.desktop:1049 src/libkleopatrarc-win32.desktop:914
msgctxt "Name"
msgid "Disabled"
msgstr "अक्षमित"

#: src/libkleopatrarc.desktop:1063 src/libkleopatrarc-win32.desktop:928
msgctxt "Description"
msgid "Certificates that are disabled"
msgstr "प्रमाणपत्राणि ये अक्षमानि सन्ति"

#: src/libkleopatrarc.desktop:1094 src/libkleopatrarc-win32.desktop:959
msgctxt "Name"
msgid "My Own"
msgstr "मम स्वकीयः"

#: src/libkleopatrarc.desktop:1116 src/libkleopatrarc-win32.desktop:981
msgctxt "Description"
msgid "My own certificates"
msgstr "मम स्वकीयं प्रमाणपत्रम्"
