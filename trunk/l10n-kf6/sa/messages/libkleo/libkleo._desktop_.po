#: src/libkleopatrarc.desktop:529 src/libkleopatrarc-win32.desktop:392
msgctxt "Name"
msgid "Not Trusted Root Certificates"
msgstr "न विश्वसनीयाः मूलप्रमाणपत्राणि"

#: src/libkleopatrarc.desktop:558 src/libkleopatrarc-win32.desktop:421
msgctxt "Description"
msgid "S/MIME root certificates that are not trusted"
