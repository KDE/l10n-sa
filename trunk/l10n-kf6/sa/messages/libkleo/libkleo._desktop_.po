#: src/libkleopatrarc.desktop:1115 src/libkleopatrarc-win32.desktop:978
msgctxt "Description"
msgid "Certificates that are disabled"
msgstr "प्रमाणपत्राणि ये अक्षमानि सन्ति"

#: src/libkleopatrarc.desktop:1148 src/libkleopatrarc-win32.desktop:1011
msgctxt "Name"
msgid "My Own"
msgstr "मम स्वकीयः"

#: src/libkleopatrarc.desktop:1172 src/libkleopatrarc-win32.desktop:1035
msgctxt "Description"
msgid "My own certificates"
msgstr "मम स्वकीयं प्रमाणपत्रम्"
