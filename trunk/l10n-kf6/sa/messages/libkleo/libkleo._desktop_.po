#: src/libkleopatrarc.desktop:561 src/libkleopatrarc-win32.desktop:423
msgctxt "Name"
msgid "Not Trusted Root Certificates"
msgstr "न विश्वसनीयाः मूलप्रमाणपत्राणि"

#: src/libkleopatrarc.desktop:594 src/libkleopatrarc-win32.desktop:456
msgctxt "Description"
msgid "S/MIME root certificates that are not trusted"
