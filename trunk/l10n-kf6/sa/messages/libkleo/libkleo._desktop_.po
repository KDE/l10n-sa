msgctxt "Name"
msgid "Revoked"
msgstr "निरस्त"

#: src/libkleopatrarc.desktop:439 src/libkleopatrarc-win32.desktop:302
msgctxt "Description"
msgid ""
"Certificates that are invalid because they have been revoked (except "
"disabled ones)"
msgstr "यत् प्रमाणपत्रं निरस्तं कृत्वा अमान्यम् (अक्षमान् विहाय)"

