#: src/libkleopatrarc.desktop:652 src/libkleopatrarc-win32.desktop:517
msgctxt "Description"
msgid "Certificates stored on smart cards (except disabled ones)"
msgstr "स्मार्टकार्ड् इत्यत्र संगृहीताः प्रमाणपत्राणि (अक्षमान् विहाय)"

#: src/libkleopatrarc.desktop:679 src/libkleopatrarc-win32.desktop:544
msgctxt "Name"
msgid "OpenPGP"
msgstr "ओपनपीजीपी"

