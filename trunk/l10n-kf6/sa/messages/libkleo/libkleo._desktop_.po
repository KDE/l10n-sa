#: src/libkleopatrarc.desktop:1163 src/libkleopatrarc-win32.desktop:1026
msgctxt "Description"
msgid "Certificates that are disabled"
msgstr "प्रमाणपत्राणि ये अक्षमानि सन्ति"

#: src/libkleopatrarc.desktop:1198 src/libkleopatrarc-win32.desktop:1061
msgctxt "Name"
msgid "My Own"
msgstr "मम स्वकीयः"

#: src/libkleopatrarc.desktop:1225 src/libkleopatrarc-win32.desktop:1088
msgctxt "Description"
msgid "My own certificates"
msgstr "मम स्वकीयं प्रमाणपत्रम्"
