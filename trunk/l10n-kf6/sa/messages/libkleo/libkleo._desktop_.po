#: src/libkleopatrarc.desktop:5 src/libkleopatrarc-win32.desktop:5
msgctxt "Name"
msgid "TAR (PGP®-compatible)"
msgstr "TAR (PGP®-संगत) ९."

#: src/libkleopatrarc.desktop:96
msgctxt "Name"
msgid "TAR (with bzip2 compression)"
msgstr "TAR (bzip2 संपीडनेन सह)"

