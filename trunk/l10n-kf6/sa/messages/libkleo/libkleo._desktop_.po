#: src/libkleopatrarc.desktop:535 src/libkleopatrarc-win32.desktop:398
msgctxt "Name"
msgid "Not Trusted Root Certificates"
msgstr "न विश्वसनीयाः मूलप्रमाणपत्राणि"

#: src/libkleopatrarc.desktop:565 src/libkleopatrarc-win32.desktop:428
msgctxt "Description"
msgid "S/MIME root certificates that are not trusted"
