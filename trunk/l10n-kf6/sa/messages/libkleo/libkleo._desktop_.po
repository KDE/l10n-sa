#: src/libkleopatrarc.desktop:1138 src/libkleopatrarc-win32.desktop:1001
msgctxt "Description"
msgid "Certificates that are disabled"
msgstr "प्रमाणपत्राणि ये अक्षमानि सन्ति"

#: src/libkleopatrarc.desktop:1172 src/libkleopatrarc-win32.desktop:1035
msgctxt "Name"
msgid "My Own"
msgstr "मम स्वकीयः"

#: src/libkleopatrarc.desktop:1197 src/libkleopatrarc-win32.desktop:1060
msgctxt "Description"
