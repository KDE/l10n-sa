msgctxt "Name"
msgid "S/MIME"
msgstr "S/MIME"

#: src/libkleopatrarc.desktop:821 src/libkleopatrarc-win32.desktop:684
msgctxt "Description"
msgid "S/MIME certificates"
msgstr "S/MIME प्रमाणपत्राणि"

#: src/libkleopatrarc.desktop:860 src/libkleopatrarc-win32.desktop:723
msgctxt "Name"
msgid "VS-NfD Compliant"
msgstr "VS-NfD अनुरूप"

#: src/libkleopatrarc.desktop:896 src/libkleopatrarc-win32.desktop:759
msgctxt "Description"
msgid "Certificates that are VS-NfD compliant (except disabled ones)"
msgstr "प्रमाणपत्राणि ये VS-NfD अनुरूपाः सन्ति (अक्षमान् विहाय)"

#: src/libkleopatrarc.desktop:931 src/libkleopatrarc-win32.desktop:794
msgctxt "Name"
msgid "Not VS-NfD Compliant"
msgstr "न VS-NfD अनुरूपम्"

#: src/libkleopatrarc.desktop:967 src/libkleopatrarc-win32.desktop:830
msgctxt "Description"
msgid "Certificates that are not VS-NfD compliant (except disabled ones)"
msgstr "प्रमाणपत्राणि ये VS-NfD अनुरूपाः न सन्ति (अक्षमान् विहाय)"

#: src/libkleopatrarc.desktop:1004 src/libkleopatrarc-win32.desktop:867
msgctxt "Name"
msgid "Not VS-NfD Compliant (Expired)"
msgstr "VS-NfD अनुरूपं नास्ति (समाप्तः)"

#: src/libkleopatrarc.desktop:1038 src/libkleopatrarc-win32.desktop:901
msgctxt "Description"
msgid ""
"Expired certificates (if VS-NfD compliance mode is active, except disabled "
"ones)"
msgstr ""
"अवधिसमाप्तप्रमाणपत्राणि (यदि VS-NfD अनुपालनविधिः सक्रियः अस्ति, अक्षमान् विहाय)"

#: src/libkleopatrarc.desktop:1074 src/libkleopatrarc-win32.desktop:937
msgctxt "Name"
msgid "Not VS-NfD Compliant (Revoked)"
msgstr "VS-NfD अनुरूपं नास्ति (निरस्तम्)"

#: src/libkleopatrarc.desktop:1108 src/libkleopatrarc-win32.desktop:971
msgctxt "Description"
msgid ""
"Revoked certificates (if VS-NfD compliance mode is active, except disabled "
"ones)"
msgstr "निरस्तप्रमाणपत्राणि (यदि VS-NfD अनुपालनविधिः सक्रियः अस्ति, अक्षमान् विहाय)"

#: src/libkleopatrarc.desktop:1139 src/libkleopatrarc-win32.desktop:1002
msgctxt "Name"
