#: org.kde.plasma.camera.appdata.xml:8
#. (itstool) path: component/name
msgid "Plasma Camera"
msgstr "प्लाज्मा कैमरा"

#: org.kde.plasma.camera.appdata.xml:9
#. (itstool) path: component/summary
msgid "Take photos and videos"
msgstr "फोटो, विडियो च गृह्यताम्"

#: org.kde.plasma.camera.appdata.xml:19
#. (itstool) path: description/p
msgid "Camera Application for Plasma Mobile."
msgstr "प्लाज्मा मोबाईलस्य कृते कैमरा अनुप्रयोगः।"

#: org.kde.plasma.camera.appdata.xml:20
#. (itstool) path: description/p
msgid ""
"It supports different resolutions, different white balance modes and "
"switching between different camera devices."
msgstr ""
"एतत् भिन्न-भिन्न-संकल्पं, भिन्न-भिन्न-श्वेत-तुल्य-विधानं, "
"भिन्न-भिन्न-कॅमेरा-यन्त्राणां मध्ये स्विचिंग्-करणं च समर्थयति ।"