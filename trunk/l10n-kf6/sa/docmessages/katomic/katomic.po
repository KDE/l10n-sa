# automatic translation
#: index.docbook:156
#. Tag: action
#, no-c-format
msgid "Undo the last move you made."
msgstr "भवता कृतं अन्तिमं चालनं पूर्ववत् कुरुत।"

# automatic translation
#: index.docbook:159
#. Tag: menuchoice
#, no-c-format
msgid ""
