msgid "Description"
msgstr "वर्णनम्‌"

# automatic translation
#: man-split2po.1.docbook:33
#. Tag: para
#, no-c-format
msgid ""
"<command>split2po</command> is a command-line tool that takes the two given "
"DocBook XML files and produces a <command>gettext</command> message file "
"(PO-file) that represents the changes between them. The resulting PO-file "
"is sent to standard output."
msgstr ""
"<command>split2po</command> इति आदेशपङ्क्तिसाधनं यत् दत्तद्वयं DocBook XML "
"सञ्चिकां गृहीत्वा <command>gettext</command> सन्देशसञ्चिकां (PO-file) "
"उत्पादयति यत् तयोः मध्ये परिवर्तनं प्रतिनिधियति परिणामी PO-सञ्चिका "
"मानकनिर्गमं प्रति प्रेष्यते ।"

# automatic translation
#: man-split2po.1.docbook:39
#. Tag: para
#, no-c-format
msgid ""
"<filename>translated-XML</filename> must be the result of translating "
"<filename>original-XML</filename> into another language. It is this "
"translation that the resulting PO-file will represent."
msgstr ""
"<filename>translated-XML</filename> इत्येतत् "
"<filename>original-XML</filename> इत्यस्य अन्यभाषायां अनुवादस्य परिणामः "
"भवितुमर्हति । अयं अनुवादः एव परिणामी PO-सञ्चिका प्रतिनिधित्वं करिष्यति ।"

# automatic translation
