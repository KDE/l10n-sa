msgstr "<guimenu>दत्तांशः</guimenu> <guimenuitem>क्रमणं...</guimenuitem>"

# automatic translation
#: commands.docbook:785
#. Tag: para
#, no-c-format
msgid ""
"<action>Sort data in selected cells.</action> See the section <link "
"linkend=\"sort\">Sorting Data</link> for more details."
msgstr ""
"<action>चयनितकोष्ठकेषु दत्तांशं क्रमयन्तु ।</action> खण्डं पश्यन्तु<link "
"linkend=\"sort\"> दत्तांशस्य क्रमणं करणम्</link> अधिकविवरणार्थम्।"

# automatic translation
#: commands.docbook:791
#. Tag: menuchoice
#, no-c-format
msgid "<guimenu>Data</guimenu> <guimenuitem>Text to Columns...</guimenuitem>"
msgstr "<guimenu>दत्तांशः</guimenu> <guimenuitem>स्तम्भानां पाठः...</guimenuitem>"

# automatic translation
#: commands.docbook:795
#. Tag: para
#, no-c-format
msgid ""
"This option attempts to interpret text in the selected cell(s) as "
"<acronym>CSV</acronym> data, placing each item into a different cell in the "
"row."
msgstr ""
"एषः विकल्पः चयनितकोष्ठके (कोष्ठकेषु) पाठस्य व्याख्यां "
"<acronym>CSV</acronym> दत्तांशरूपेण कर्तुं प्रयतते, प्रत्येकं द्रव्यं "
"पङ्क्तौ भिन्नकोष्ठके स्थापयति ।"

# automatic translation
#: commands.docbook:802
#. Tag: menuchoice
#, no-c-format
msgid ""
"<shortcut> <keycombo "
"action=\"simul\">&Ctrl;&Shift;<keycap>G</keycap></keycombo> </shortcut> "
"<guimenu>Data</guimenu> <guimenuitem>Named Areas...</guimenuitem>"
msgstr ""
"<shortcut> <keycombo "
"action=\"simul\">&Ctrl;&Shift;<keycap>G</keycap></keycombo> </shortcut> "
"<guimenu>दत्तांश</guimenu> <guimenuitem>नामकृतक्षेत्राणि...</guimenuitem >"

# automatic translation
#: commands.docbook:809
#. Tag: para
#, no-c-format
msgid ""
"<action>Open</action> the <guilabel>Named Areas</guilabel> dialog to "
"select, add, edit and remove named areas. See the section <link "
"linkend=\"namedareas\">Named Cells and Areas</link> for further details."
msgstr ""
"<action>उद्घाटित</action> the<guilabel> नामित क्षेत्र</guilabel> "
"नामकृतक्षेत्राणां चयनं, योजयितुं, सम्पादयितुं, निष्कासयितुं च संवादः । "
"खण्डं पश्यन्तु<link linkend=\"namedareas\"> कोष्ठकाः क्षेत्राणि च "
"नामकृतानि</link> अधिकविवरणार्थम्।"

# automatic translation
#: commands.docbook:816
#. Tag: menuchoice
#, no-c-format
msgid "<guimenu>Data</guimenu> <guimenuitem>Consolidate...</guimenuitem>"
msgstr "<guimenu>दत्तांशः</guimenu> <guimenuitem>एकीकरणं कुर्वन्तु...</guimenuitem>"

# automatic translation
#: commands.docbook:820
#. Tag: para
#, no-c-format
msgid ""
"<action>Consolidate data.</action> See the section <link "
"linkend=\"consolidate\">Consolidating Data</link> for more details."
msgstr ""
"<action>दत्तांशं समेकयन्तु।</action> खण्डं पश्यन्तु<link "
"linkend=\"consolidate\"> दत्तांशस्य समेकनम्</link> अधिकविवरणार्थम्।"

# automatic translation
#: commands.docbook:826
#. Tag: menuchoice
#, no-c-format
msgid "<guimenu>Data</guimenu> <guimenuitem>Subtotals...</guimenuitem>"
msgstr "<guimenu>दत्तांश</guimenu> <guimenuitem>उपसङ्ख्याः...</guimenuitem>"

# automatic translation
#: commands.docbook:830
#. Tag: action
#, no-c-format
msgid "Create different kinds of subtotals to a database."
msgstr "दत्तांशकोशे भिन्नप्रकारस्य उपकुलं रचयन्तु ।"

# automatic translation
#: commands.docbook:836
#. Tag: menuchoice
#, no-c-format
msgid "<guimenu>Data</guimenu> <guimenuitem>Validity...</guimenuitem>"
msgstr "<guimenu>दत्तांश</guimenu> <guimenuitem>वैधता...</guimenuitem>"

# automatic translation
#: commands.docbook:840
#. Tag: para
#, no-c-format
msgid ""
"<action>Set or modify the error checking criteria and error alert message "
"for selected cell(s).</action> See <link linkend=\"validcheck\"> Validity "
"Checking</link> for more details."
msgstr ""
"<action>चयनितकोष्ठकानां (कोष्ठकानां) कृते त्रुटिपरीक्षणमापदण्डं "
"त्रुटिसचेतनासन्देशं च सेट् कुर्वन्तु अथवा परिवर्तयन्तु ।</action> "
"पश्यतु<link linkend=\"validcheck\"> वैधता जाँच</link> अधिकविवरणार्थम्।"

# automatic translation
#: commands.docbook:847
#. Tag: menuchoice
#, no-c-format
msgid "<guimenu>Data</guimenu> <guimenuitem>Goal Seek...</guimenuitem>"
msgstr "<guimenu>दत्तांश</guimenu> <guimenuitem>लक्ष्यं अन्वेष्टुम्...</guimenuitem>"

# automatic translation
#: commands.docbook:851
#. Tag: para
#, no-c-format
msgid ""
"<action>Open the Goal Seek dialog box</action>. See <link "
"linkend=\"goalseek\">Goal Seeking</link> for details."
msgstr ""
"<action>Goal Seek इति संवादपेटिकां उद्घाटयन्तु</action> . पश्यतु<link "
"linkend=\"goalseek\"> लक्ष्यार्थी</link> विस्तरेण कृते।"

# automatic translation
#: commands.docbook:857
#. Tag: menuchoice
#, no-c-format
msgid "<guimenu>Data</guimenu> <guimenuitem>Pivot...</guimenuitem>"
msgstr "<guimenu>दत्तांश</guimenu> <guimenuitem>पिवट्...</guimenuitem>"

# automatic translation
#: commands.docbook:861
#. Tag: para
#, no-c-format
msgid ""
"<action>Open the Pivot Table configuration dialog</action>. See <link "
"linkend=\"pivottable\">Pivot Table</link> for details."
msgstr ""
"<action>Pivot Table विन्याससंवादं उद्घाटयन्तु</action> . पश्यतु<link "
"linkend=\"pivottable\"> धुरी सारणी</link> विस्तरेण कृते।"

# automatic translation
#: commands.docbook:870
#. Tag: title
#, no-c-format
msgid "The Tools Menu"
msgstr "Tools Menu इति"

# automatic translation
#: commands.docbook:874
#. Tag: menuchoice
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Spelling...</guimenuitem>"
msgstr "<guimenu>उपकरणं</guimenu> <guimenuitem>वर्तनी...</guimenuitem>"

# automatic translation
#: commands.docbook:878
#. Tag: action
#, no-c-format
msgid "Check spelling of words in the worksheet."
msgstr "कार्यपत्रके शब्दानां वर्तनीम् अवलोकयन्तु।"

# automatic translation
#: commands.docbook:883
#. Tag: menuchoice
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Custom Lists...</guimenuitem>"
msgstr "<guimenu>उपकरणं</guimenu> <guimenuitem>अनुकूलसूची...</guimenuitem>"

# automatic translation
#: commands.docbook:887
#. Tag: action
#, no-c-format
msgid ""
"View or amend the special series of words recognized by &sheets;. These "
"list can be used to insert special <link linkend=\"series\">series</link> "
"into the worksheet."
msgstr ""
"&amp;sheets;द्वारा ज्ञातानां शब्दानां विशेषश्रृङ्खलां पश्यन्तु अथवा संशोधनं "
"कुर्वन्तु। एताः सूचीः विशेषं सम्मिलितुं उपयोक्तुं शक्यन्ते<link "
"linkend=\"series\"> श्रेणी</link> कार्यपत्रके अन्तः ।"

# automatic translation
#: commands.docbook:893
#. Tag: menuchoice
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Protect Sheet...</guimenuitem>"
msgstr ""
"<guimenu>उपकरणाः</guimenu> <guimenuitem>पत्रस्य रक्षणं "
"कुर्वन्तु...</guimenuitem>"

# automatic translation
#: commands.docbook:898
#. Tag: action
#, no-c-format
msgid ""
"Protect the sheet with a password. A dialog pops up prompting you for a "
"password. Unchecking this option will prompt you for the password in order "
"to unprotect the sheet. Protecting a sheet means protecting all cells in "
"the sheet. In a protected sheet, the cells cannot be reformatted or "
"overwritten."
msgstr ""
"गुप्तशब्देन पत्रस्य रक्षणं कुर्वन्तु। एकं संवादं भवन्तं गुप्तशब्दं "
"प्रार्थयति । एतत् विकल्पं अनचेक् कृत्वा पत्रस्य रक्षणार्थं गुप्तशब्दं "
"प्रार्थयिष्यति । पत्रस्य रक्षणस्य अर्थः पत्रे स्थितानां सर्वेषां कोशिकानां "
"रक्षणम् । संरक्षितपत्रे कोष्ठकानां पुनः स्वरूपणं वा अधिलेखनं वा कर्तुं न "
"शक्यते ।"

# automatic translation
#: commands.docbook:903
#. Tag: menuchoice
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Protect Document...</guimenuitem>"
msgstr ""
"<guimenu>उपकरणाः</guimenu> <guimenuitem>दस्तावेजस्य रक्षणं "
"कुर्वन्तु...</guimenuitem>"

# automatic translation
#: commands.docbook:908
#. Tag: action
#, no-c-format
msgid ""
"Protect the whole document with a password. A dialog pops up prompting you "
"for a password. Unchecking this option will prompt you for the password in "
"order to unprotect the document. In a protected document you cannot rename "
"or remove a sheet. Document protection does not mean that each individual "
"sheet is protected."
msgstr ""
"गुप्तशब्देन सम्पूर्णं दस्तावेजं रक्षन्तु । एकं संवादं भवन्तं गुप्तशब्दं "
"प्रार्थयति । एतत् विकल्पं अनचेक् कृत्वा दस्तावेजस्य रक्षणार्थं गुप्तशब्दं "
"प्रार्थयिष्यति । संरक्षितदस्तावेजे भवान् पत्रस्य नाम परिवर्तयितुं वा "
"निष्कासयितुं वा न शक्नोति । दस्तावेजसंरक्षणस्य अर्थः न भवति यत् प्रत्येकं "
"व्यक्तिगतपत्रं रक्षितम् अस्ति ।"

# automatic translation
#: commands.docbook:917
#. Tag: menuchoice
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Shift;<keysym>F9</keysym></keycombo> "
"</shortcut> <guimenu>Tools</guimenu> <guimenuitem>Recalculate "
"Sheet</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Shift;<keysym>F9</keysym></keycombo> "
"</shortcut> <guimenu>उपकरण</guimenu> <guimenuitem>पत्रस्य पुनः "
"गणना</guimenuitem>"

# automatic translation
#: commands.docbook:924
#. Tag: action
#, no-c-format
msgid "Recalculate formulae in the current sheet."
msgstr "वर्तमानपत्रे सूत्राणां पुनः गणनां कुर्वन्तु।"

# automatic translation
#: commands.docbook:929
#. Tag: menuchoice
#, no-c-format
msgid ""
"<shortcut> <keysym>F9</keysym> </shortcut> <guimenu>Tools</guimenu> "
"<guimenuitem>Recalculate Document</guimenuitem>"
msgstr ""
"<shortcut> <keysym>F9</keysym> </shortcut> <guimenu>उपकरणं</guimenu> "
"<guimenuitem>दस्तावेजस्य पुनः गणना</guimenuitem>"

# automatic translation
#: commands.docbook:936
#. Tag: action
#, no-c-format
msgid "Recalculate all sheets."
msgstr "सर्वाणि पत्राणि पुनः गणयन्तु।"

# automatic translation
#: commands.docbook:952
#. Tag: menuchoice
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Execute Script File...</guimenuitem>"
msgstr ""
"<guimenu>उपकरणाः</guimenu> <guimenuitem>स्क्रिप्टसञ्चिकां "
"निष्पादयन्तु...</guimenuitem>"

# automatic translation
#: commands.docbook:956
#. Tag: para
#, no-c-format
msgid ""
"Execute the chosen external script in &sheets;. &sheets; supports scripting "
"in JavaScript, Python and Ruby. Default examples of the scripts can be "
"found in the "
"<menuchoice><guimenu>Tools</guimenu><guisubmenu>Scripts</guisubmenu></"
"menuchoice> submenu."
msgstr ""
"&sheets;मध्ये चयनितं बाह्यलिपिं निष्पादयन्तु । &sheets; जावास्क्रिप्ट्, "
"पायथन्, रुबी च इत्यत्र स्क्रिप्टिङ्ग् समर्थयति । स्क्रिप्ट्-समूहस्य "
"पूर्वनिर्धारित-उदाहरणानि "
"<menuchoice><guimenu>Tools</guimenu><guisubmenu>स्क्रिप्ट्</guisubmenu></"
"menuchoice> उपमेनू मध्ये प्राप्यन्ते ।"

# automatic translation
#: commands.docbook:960
#. Tag: menuchoice
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guisubmenu>Scripts</guisubmenu>"
msgstr "<guimenu>उपकरणं</guimenu> <guisubmenu>स्क्रिप्ट्</guisubmenu>"

# automatic translation
#: commands.docbook:964
#. Tag: para
#, no-c-format
msgid ""
"Here you can execute the script to export or import data in various "
"formats, save your &sheets; log into file, use <ulink "
"url=\"https://live.gnome.org/Orca\">Orca speech</ulink> for accessibility, "
"debug Python and Ruby scripts or add functions to display stock or weather "
"condition values. You can even use some <ulink "
"url=\"http://www.r-project.org/\">R functions</ulink> (<ulink "
"url=\"http://rpy.sourceforge.net/rpy.html\">RPy module</ulink> should be "
"installed)."
msgstr ""
"अत्र भवान् विभिन्नस्वरूपेषु दत्तांशं निर्यातयितुं आयातयितुं वा स्क्रिप्ट् "
"निष्पादयितुं शक्नोति, स्वस्य &sheets; सञ्चिकायां प्रवेशं कुर्वन्तु, "
"अभिगम्यतायै <ulink url=\"https://live.gnome.org/Orca\">Orca speech</ulink> "
"इत्यस्य उपयोगं कुर्वन्तु, Python तथा Ruby स्क्रिप्ट् इत्येतयोः "
"त्रुटिनिवारणं कुर्वन्तु अथवा स्टॉक् अथवा मौसमस्य स्थितिमूल्यानि "
"प्रदर्शयितुं कार्याणि योजयन्तु भवन्तः केचन <ulink "
"url=\"http://www.r-project.org/\">R कार्याणि</ulink> (<ulink "
"url=\"http://rpy.sourceforge.net/rpy.html\" अपि उपयोक्तुं शक्नुवन्ति। >RPy "
"मॉड्यूल</ulink> संस्थापनीयम्)।"

# automatic translation
#: commands.docbook:968
#. Tag: menuchoice
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Script Manager...</guimenuitem>"
msgstr ""
"<guimenu>उपकरणाः</guimenu> <guimenuitem>स्क्रिप्ट् "
"प्रबन्धकः...</guimenuitem>"

# automatic translation
#: commands.docbook:972
#. Tag: para
#, no-c-format
msgid ""
"<action>Opens</action> the <guilabel>Scripts Manager</guilabel> dialog to "
"execute, load, unload, install, uninstall and get more scripts."
msgstr ""
"<action>अधिकानि स्क्रिप्ट् निष्पादयितुं, लोड् कर्तुं, अनलोड् कर्तुं, "
"संस्थापनं कर्तुं, विस्थापयितुं, अधिकानि स्क्रिप्ट् प्राप्तुं च "
"<guilabel>Scripts Manager</guilabel> संवादं उद्घाटयति</action> ।"

# automatic translation
#: commands.docbook:977
#. Tag: menuchoice
#, no-c-format
msgid "<guimenu>Tools</guimenu> <guimenuitem>Function Optimizer...</guimenuitem>"
msgstr "<guimenu>उपकरणाः</guimenu> <guimenuitem>कार्य अनुकूलकः...</guimenuitem>"

# automatic translation
#: commands.docbook:981
#. Tag: para
#, no-c-format
msgid ""
"<action>Opens</action> the <guilabel>Function Optimizer</guilabel> dialog "
"where you can choose an objective function cell, optimization target "
"(<guilabel>Maximize</guilabel>, <guilabel>Minimize</guilabel> or enter the "
"<guilabel>Value</guilabel>) and a set of decision parameter cells."
msgstr ""
"<action> <guilabel>कार्यअनुकूलकः</guilabel> संवादं उद्घाटयति</action> यत्र "
"भवान् उद्देश्यपूर्णं कार्यकोशं, अनुकूलनलक्ष्यं "
"(<guilabel>अधिकतमं</guilabel>, <guilabel>न्यूनतमं</guilabel> अथवा "
"प्रविष्टुं शक्नोति <guilabel>Value</guilabel>) तथा निर्णयपैरामीटर् "
"कोष्ठकानां समुच्चयः ।"

# automatic translation
#: commands.docbook:988
#. Tag: title
#, no-c-format
msgid "The Settings Menu"
msgstr "सेटिंग्स् मेन्यू इति"

# automatic translation
#: commands.docbook:992
#. Tag: menuchoice
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guisubmenu>Toolbars Shown</guisubmenu>"
msgstr "<guimenu>सेटिंग्स्</guimenu> <guisubmenu>उपकरणपट्टिकाः दर्शिताः</guisubmenu>"

# automatic translation
#: commands.docbook:996
#. Tag: action
#, no-c-format
msgid ""
"Show or hide the toolbars: <guilabel>File</guilabel>, "
"<guilabel>Edit</guilabel>, <guilabel>Navigation</guilabel>, "
"<guilabel>Font</guilabel>, <guilabel>Format</guilabel> and "
"<guilabel>Color/Border</guilabel>."
msgstr ""
"साधनपट्टिकाः दर्शयन्तु अथवा गोपयन्तु : <guilabel>सञ्चिका</guilabel>, "
"<guilabel>सम्पादनं</guilabel>, <guilabel>नेविगेशन</guilabel>, "
"<guilabel>फ़ॉन्ट्</guilabel>, <guilabel>स्वरूप</guilabel> तथा "
"<guilabel>वर्ण/सीमा</guilabel>।"

# automatic translation
#: commands.docbook:1015
#. Tag: menuchoice
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Status Bar</guimenuitem>"
msgstr "<guimenu>सेटिंग्स्</guimenu> <guimenuitem>स्थितिपट्टिका</guimenuitem>"

# automatic translation
#: commands.docbook:1019
#. Tag: para
#, no-c-format
msgid ""
"<action>Show or hide the Status Bar.</action> The Status Bar shows "
"additional information for selected items and instant calculations of the "
"selected cells."
msgstr ""
"<action>स्थितिपट्टिकां दर्शयतु अथवा गोपयतु।</action> स्थितिपट्टिका "
"चयनितवस्तूनाम् अतिरिक्तसूचनाः चयनितकोष्ठकानां तत्क्षणगणनाञ्च दर्शयति ।"

# automatic translation
#: commands.docbook:1026
#. Tag: menuchoice
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Tab Bar</guimenuitem>"
msgstr "<guimenu>सेटिंग्स्</guimenu> <guimenuitem>ट्याब्बार</guimenuitem>"

# automatic translation
#: commands.docbook:1030
#. Tag: para
#, no-c-format
msgid ""
"<action>Show or hide the Tab Bar.</action> All Sheets of the current "
"Document can be accessed through the Tab Bar."
msgstr ""
"<action>Tab Bar दर्शयतु अथवा गोपयतु।</action> वर्तमान Document इत्यस्य "
"सर्वाणि Sheets Tab Bar मार्गेण प्राप्तुं शक्यन्ते ।"

# automatic translation
#: commands.docbook:1036
#. Tag: menuchoice
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure "
"Shortcuts...</guimenuitem>"
msgstr ""
"<guimenu>सेटिंग्स्</guimenu> <guimenuitem>शॉर्टकट् विन्यस्तं "
"कुर्वन्तु...</guimenuitem>"

# automatic translation
#: commands.docbook:1040
#. Tag: para
#, no-c-format
msgid ""
"<action>Configure the keyboard shortcuts used by &sheets;. </action> See "
"the section on <link linkend=\"configshort\">configuring shortcuts </link> "
"for more details."
msgstr ""
"<action>&amp;sheets;द्वारा उपयुज्यमानं कीबोर्डशॉर्टकट् विन्यस्यताम् "
"।</action> विषये खण्डं पश्यन्तु<link linkend=\"configshort\"> शॉर्टकट् "
"विन्यस्तं कुर्वन्</link> अधिकविवरणार्थम्।"

# automatic translation
#: commands.docbook:1048
#. Tag: menuchoice
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Configure Toolbars...</guimenuitem>"
msgstr ""
"<guimenu>सेटिंग्स्</guimenu> <guimenuitem>उपकरणपट्टिकाः "
"विन्यस्यताम्...</guimenuitem>"

# automatic translation
#: commands.docbook:1052
#. Tag: para
#, no-c-format
msgid ""
"<action>Configure the toolbars.</action> The section on <link "
"linkend=\"configtoolbars\">configuring toolbars</link> has more information."
msgstr ""
"<action>साधनपट्टिकाः विन्यस्यताम् ।</action> इति खण्डः<link "
"linkend=\"configtoolbars\"> साधनपट्टिकानां विन्यासः</link> अधिकानि सूचनानि "
