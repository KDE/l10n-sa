"action=\"simul\">&Ctrl;&Alt;<keycap>F</keycap></keycombo> </shortcut> "
"<guimenuitem>Cell Format...</guimenuitem>"
msgstr ""
"<shortcut> <keycombo "
"action=\"simul\">&Ctrl;&Alt;<keycap>F</keycap></keycombo> </shortcut> "
"<guimenuitem>कोशिकास्वरूपं...</guimenuitem>"

# automatic translation
#: commands.docbook:1134
#. Tag: menuchoice
#, no-c-format
