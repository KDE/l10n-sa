# automatic translation
#: commands.docbook:1059
#. Tag: menuchoice
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Themes</guimenuitem>"
msgstr "<guimenu>सेटिंग्स्</guimenu> <guimenuitem>विषयाणि</guimenuitem>"

# automatic translation
#: commands.docbook:1063
#. Tag: para
#, no-c-format
msgid ""
"<action>Choose the color theme for &sheets; window.</action> You can choose "
"one of the predefined color schemes or select "
"<guimenuitem>Configuration...</guimenuitem> to open <ulink "
"url=\"help:/kcontrol/colors\">&systemsettings; color selection "
"module</ulink>."
msgstr ""
"<action>&sheets; window.</action> भवान् पूर्वनिर्धारितवर्णयोजनासु एकं "
"चिन्वतु अथवा <ulink url=\"help:/kcontrol/colors\">&systemsettings; "
"वर्णचयनमॉड्यूल</ulink> इति ।"

# automatic translation
#: commands.docbook:1070
#. Tag: menuchoice
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Active Author Profile</guimenuitem>"
msgstr "<guimenu>सेटिंग्स्</guimenu> <guimenuitem>सक्रियलेखकप्रोफाइल</guimenuitem>"

# automatic translation
#: commands.docbook:1074
#. Tag: para
#, no-c-format
msgid ""
"<action>Configure the author profile for the current document.</action> You "
"can choose one of the profiles defined using <link "
"linkend=\"configauthor\">&sheets; configuration window</link>, "
"<guimenuitem>Default Author Profile</guimenuitem> as defined by "
"&systemsettings; data or blank <guimenuitem>Anonymous</guimenuitem> profile "
"which can ensure your privacy."
msgstr ""
"<action>वर्तमानदस्तावेजस्य कृते लेखकरूपरेखां विन्यस्यताम् ।</action> "
"उपयोगेन परिभाषितप्रोफाइलमध्ये एकं चिन्वतु<link linkend=\"configauthor\"> "
"&amp;sheets; विन्यासविण्डो</link> , ९.<guimenuitem> पूर्वनिर्धारित लेखक "
"प्रोफाइल</guimenuitem> यथा परिभाषितं &amp;systemsettings; दत्तांशः रिक्तः "
"वा<guimenuitem> अनामक</guimenuitem> profile यत् भवतः गोपनीयतां सुनिश्चितं "
"कर्तुं शक्नोति।"

# automatic translation
#: commands.docbook:1082
#. Tag: menuchoice
#, no-c-format
msgid ""
"<guimenu>Settings</guimenu> <guimenuitem>Configure "
"Notifications...</guimenuitem>"
msgstr ""
"<guimenu>सेटिंग्स्</guimenu> <guimenuitem>सूचनाः "
"विन्यस्यताम्...</guimenuitem>"

# automatic translation
#: commands.docbook:1086
#. Tag: para
#, no-c-format
msgid ""
"<action>Configure &sheets; notification system.</action> There are no "
"actions that you can be notified in the current version of &sheets;."
msgstr ""
"<action>विन्यस्तं कुर्वन्तु &sheets; notification system.</action> &sheets; "
"इत्यस्य वर्तमानसंस्करणे भवन्तः सूचनां दातुं शक्नुवन्ति इति क्रियाः नास्ति ।"

# automatic translation
#: commands.docbook:1092
#. Tag: menuchoice
#, no-c-format
msgid "<guimenu>Settings</guimenu> <guimenuitem>Configure &sheets;...</guimenuitem>"
msgstr ""
"<guimenu>सेटिंग्स्</guimenu> <guimenuitem>&sheets;...</guimenuitem> "
"विन्यस्यताम्"

# automatic translation
#: commands.docbook:1096
#. Tag: para
#, no-c-format
msgid ""
"<action>General &sheets; configuration.</action> See the section on <link "
"linkend=\"configdialog\">&sheets; configuration</link> for more details."
msgstr ""
"<action>सामान्यम् &amp;sheets; विन्यासः ।</action> विषये खण्डं "
"पश्यन्तु<link linkend=\"configdialog\"> &amp;sheets; विन्यासः</link> "
"अधिकविवरणार्थम्।"

# automatic translation
#: commands.docbook:1106
#. Tag: title
#, no-c-format
msgid "The Help Menu"
msgstr "सहायता मेनू"

