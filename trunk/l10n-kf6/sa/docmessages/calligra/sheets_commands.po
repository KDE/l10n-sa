# automatic translation
#: commands.docbook:1321
#. Tag: guimenuitem
#, no-c-format
msgid "Delete Columns"
msgstr "स्तम्भान् विलोपयन्तु"

# automatic translation
#: commands.docbook:1323
#. Tag: action
#, no-c-format
msgid "Delete selected column(s)."
msgstr "चयनितं स्तम्भं (स्तम्भान्) विलोपयन्तु।"

# automatic translation
#: commands.docbook:1329
#. Tag: guimenuitem
#, no-c-format
msgid "Hide Columns"
msgstr "स्तम्भान् गोपयन्तु"

# automatic translation
#: commands.docbook:1331
#. Tag: action
#, no-c-format
msgid "Hides selected column(s)."
msgstr "चयनितं स्तम्भं (स्तम्भान्) गोपयति ।"

# automatic translation
#: commands.docbook:1337
#. Tag: guimenuitem
#, no-c-format
msgid "Show Columns"
msgstr "स्तम्भान् दर्शयतु"

# automatic translation
#: commands.docbook:1339
#. Tag: action
#, no-c-format
msgid ""
"Shows selected column(s). In order to show hidden columns you need to "
"select a range of columns that includes the hidden columns."
msgstr ""
"चयनितं स्तम्भं (स्तम्भान्) दर्शयति । गुप्तस्तम्भान् दर्शयितुं भवद्भिः "
"स्तम्भानां श्रेणीं चिन्वितव्यं यस्मिन् गुप्तस्तम्भाः समाविष्टाः सन्ति ।"

# automatic translation
#: commands.docbook:1347
#. Tag: guimenuitem
#, no-c-format
msgid "Comment..."
msgstr "टिप्पणी..."

# automatic translation
#: commands.docbook:1349
#. Tag: action
#, no-c-format
msgid "Add or modify a comment to the selected cell."
msgstr "चयनितकोष्ठके टिप्पणीं योजयन्तु परिवर्तनं वा कुर्वन्तु ।"

# automatic translation
#: commands.docbook:1355
#. Tag: guimenuitem
#, no-c-format
msgid "Selection List..."
msgstr "चयनसूची..."

# automatic translation
#: commands.docbook:1357
#. Tag: action
#, no-c-format
msgid ""
"Lets you select and paste text from any cell of the current selection of "
"cells into the selected cell."
msgstr ""
"वर्तमान कोष्ठकचयनस्य कस्मात् अपि कोष्ठकात् पाठं चयनितकोष्ठके चिनोति, चिनोति "
"च ।"

# automatic translation
#: commands.docbook:1374
#. Tag: title
#, no-c-format
msgid "Other Shortcuts"
msgstr "अन्ये शॉर्टकट्"

# automatic translation
#: commands.docbook:1375
#. Tag: para
#, no-c-format
msgid ""
"This section describes those &sheets; shortcut keys used for operations "
"that do not appear in any of the menus."
msgstr ""
"अस्मिन् खण्डे तानि &sheets; कस्मिन् अपि मेन्यू मध्ये न दृश्यमानानां "
"कार्याणां कृते प्रयुक्तानि शॉर्टकट् कीलानि ।"

# automatic translation
#: commands.docbook:1382
#. Tag: keycombo
#, no-c-format
msgid "&Ctrl;<keycap>H</keycap>"
msgstr "&Ctrl;<keycap>H</keycap> इति"

# automatic translation
#: commands.docbook:1384
#. Tag: para
#, no-c-format
msgid "Toggle the display of the dockers."
msgstr "डॉकर्स् इत्यस्य प्रदर्शनं टॉग्ल् कुर्वन्तु ।"

# automatic translation
#: commands.docbook:1389
#. Tag: keycombo
#, no-c-format
msgid "&Ctrl;<keysym>Arrow keys</keysym>"
msgstr "&Ctrl;<keysym>बाणकील</keysym>"

# automatic translation
#: commands.docbook:1391
#. Tag: action
#, no-c-format
msgid ""
"If the selected cell is occupied then move the cell cursor to the start or "
"end of the occupied block in the current row or column. If the selected "
"cell is not occupied then move the cell cursor to the start or end of the "
"block of unoccupied cells in the current row or column."
msgstr ""
"यदि चयनितः कोष्ठकः कब्जितः अस्ति तर्हि वर्तमानपङ्क्तौ अथवा स्तम्भे "
"कब्जितस्य खण्डस्य आरम्भे अथवा अन्ते कोष्ठकं कर्सरं चालयन्तु । यदि चयनितः "
"कोष्ठकः कब्जितः नास्ति तर्हि वर्तमानपङ्क्तौ अथवा स्तम्भे अकब्जितकोशिकानां "
"खण्डस्य आरम्भे अथवा अन्ते कोष्ठकं कर्सरं चालयन्तु ।"

# automatic translation
#: commands.docbook:1401
#. Tag: keycombo
#, no-c-format
msgid "&Ctrl;&Shift;<keysym>Arrow keys</keysym>"
msgstr "&Ctrl;&Shift;<keysym>बाणकील</keysym>"

# automatic translation
#: commands.docbook:1403
#. Tag: action
#, no-c-format
msgid ""
"If the selected cell is occupied then select all occupied cells to the "
"start or end of that block of occupied cells in the current row or column. "
"If the selected cell is not occupied then select all unoccupied cells to "
"the start or end of that block of unoccupied cells in the current row or "
"column."
msgstr ""
"यदि चयनितः कोष्ठकः कब्जाकृतः अस्ति तर्हि वर्तमानपङ्क्तौ अथवा स्तम्भे "
"कब्जाकृतानां कोष्ठकानां तस्य खण्डस्य आरम्भं वा अन्ते वा सर्वाणि "
"कब्जितकोशिकानि चिनोतु । यदि चयनितः कोष्ठकः कब्जितः नास्ति तर्हि "
"वर्तमानपङ्क्तौ अथवा स्तम्भे तस्य रिक्तकोष्ठकानां खण्डस्य आरम्भं वा अन्ते वा "
"सर्वाणि रिक्तकोष्ठकानि चिनोतु ।"

# automatic translation
#: commands.docbook:1414
#. Tag: keysym
#, no-c-format
msgid "Page Down"
msgstr "पृष्ठं अधः"

# automatic translation
#: commands.docbook:1416
#. Tag: action
#, no-c-format
msgid "Move the cell cursor 10 cells down."
msgstr "सेल कर्सरं 10 कोष्ठकं अधः चालयन्तु ।"

# automatic translation
#: commands.docbook:1422
#. Tag: keysym
#, no-c-format
msgid "Page Up"
msgstr "पृष्ठ ऊपर"

# automatic translation
#: commands.docbook:1424
#. Tag: action
#, no-c-format
msgid "Move the cell cursor 10 cells up."
msgstr "कोष्ठक कर्सरं १० कोष्ठकानि उपरि चालयन्तु ।"

# automatic translation
#: commands.docbook:1430
#. Tag: keycombo
#, no-c-format
msgid "&Ctrl;<keysym>Page Down</keysym>"
msgstr "&Ctrl;<keysym>पृष्ठं अधः</keysym>"

# automatic translation
#: commands.docbook:1432
#. Tag: action
#, no-c-format
msgid "Move to the next sheet."
msgstr "अग्रिमपत्रं प्रति गच्छन्तु।"

# automatic translation
#: commands.docbook:1438
#. Tag: keycombo
#, no-c-format
msgid "&Ctrl;<keysym>Page Up</keysym>"
msgstr "&Ctrl;<keysym>पृष्ठोपरि</keysym>"

# automatic translation
#: commands.docbook:1440
#. Tag: action
#, no-c-format
msgid "Move to the previous sheet."
msgstr "पूर्वपत्रं प्रति गच्छन्तु।"

# automatic translation
#: commands.docbook:1446
#. Tag: keycap
#, no-c-format
msgid "<keycap>F4</keycap>"
msgstr "<keycap>F4</keycap> इति"

# automatic translation
#: commands.docbook:1448
#. Tag: para
#, no-c-format
msgid ""
"<action>Change cell reference</action> between normal and <link "
"linkend=\"absolute\">absolute reference</link> types."
msgstr ""
"<action>कोष्ठसन्दर्भं परिवर्तयन्तु</action> सामान्यस्य च मध्ये<link "
"linkend=\"absolute\"> निरपेक्ष सन्दर्भ</link> प्रकाराः ।"