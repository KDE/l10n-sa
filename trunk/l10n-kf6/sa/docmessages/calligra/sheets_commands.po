msgstr "क्षेत्रनाम..."

# automatic translation
#: commands.docbook:1218
#. Tag: para
#, no-c-format
msgid ""
"<action>Name selected area.</action> See the section <link "
"linkend=\"namedareas\">Named Areas</link> for more details."
msgstr ""
"<action>चयनितक्षेत्रस्य नामकरणं कुर्वन्तु।</action> खण्डं पश्यन्तु<link "
"linkend=\"namedareas\"> नामित क्षेत्र</link> अधिकविवरणार्थम्।"

# automatic translation
#: commands.docbook:1225
#. Tag: guimenuitem
#, no-c-format
