msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo> "
"</shortcut> <guimenu>Game</guimenu> <guimenuitem>New</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>N</keycap></keycombo> "
"</shortcut> <guimenu>खेल</guimenu> <guimenuitem>नव</guimenuitem>"

# automatic translation
#: index.docbook:606
#. Tag: para
#, no-c-format
msgid "Starts a new game."
msgstr "नूतनं क्रीडां आरभते।"

# automatic translation
#: index.docbook:613
#. Tag: menuchoice
#, no-c-format
msgid ""
"<shortcut> <keycap>P</keycap> </shortcut> <guimenu>Game</guimenu> "
"<guimenuitem>Pause</guimenuitem>"
msgstr ""
"<shortcut> <keycap>P</keycap> </shortcut> <guimenu>खेल</guimenu> "
"<guimenuitem>विरामं कुरुत</guimenuitem>"

# automatic translation
#: index.docbook:621
#. Tag: para
#, no-c-format
msgid "Pause and resume the current game."
msgstr "विरामं कृत्वा वर्तमानक्रीडां पुनः आरभत।"

# automatic translation
#: index.docbook:628
#. Tag: menuchoice
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>H</keycap></keycombo> "
"</shortcut> <guimenu>Game</guimenu> <guimenuitem>Show High "
"Scores</guimenuitem>"
msgstr ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>H</keycap></keycombo> "
"</shortcut> <guimenu>खेल</guimenu> <guimenuitem>उच्चाङ्कान् "
"दर्शयतु</guimenuitem>"

# automatic translation
#: index.docbook:635
#. Tag: para
#, no-c-format
msgid "Shows a dialog containing the High Scores."
msgstr "High Scores युक्तं संवादं दर्शयति ।"

# automatic translation
#: index.docbook:642
#. Tag: menuchoice
#, no-c-format
msgid ""
"<shortcut> <keycombo action=\"simul\">&Ctrl;<keycap>Q</keycap></keycombo> "
"</shortcut> <guimenu>Game</guimenu> <guimenuitem>Quit</guimenuitem>"
msgstr ""
"<shortcut> <keycombo "
"action=\"simul\">&Ctrl;<keycap>प्रश्न</keycap></keycombo> </shortcut> "
"<guimenu>खेल</guimenu> <guimenuitem>निर्गम</guimenuitem>"

# automatic translation
#: index.docbook:650
#. Tag: para
#, no-c-format
msgid "Quits the program."
msgstr "कार्यक्रमं त्यजति।"

# automatic translation
#: index.docbook:657
#. Tag: menuchoice
#, no-c-format
msgid ""
"<shortcut> <keycombo "
"action=\"simul\">&Ctrl;&Shift;<keycap>F</keycap></keycombo> </shortcut> "
"<guimenu>View</guimenu> <guimenuitem>Full Screen Mode</guimenuitem>"
msgstr ""
"<shortcut> <keycombo "
"action=\"simul\">&Ctrl;&Shift;<keycap>F</keycap></keycombo> </shortcut> "
"<guimenu>दृश्य</guimenu> <guimenuitem>पूर्णपर्दे मोड</guimenuitem>"

# automatic translation
#: index.docbook:665
#. Tag: action
#, no-c-format
msgid ""
"Play the &kbreakout; game in full screen mode. Leaving this mode is only "
"possible using the shortcut."
msgstr ""
"&kbreakout इति क्रीडन्तु; गेम पूर्णपर्दे मोडे। एतत् मोड् त्यक्त्वा केवलं "
"शॉर्टकट् इत्यस्य उपयोगेन एव सम्भवति ।"

# automatic translation
#: index.docbook:671
#. Tag: para
#, no-c-format
msgid ""
"Additionally &kbreakout; has the common &kde; <guimenu>Settings</guimenu> "
"and <guimenu>Help</guimenu> menu items, for more information read the "
"sections about the <ulink "
"url=\"help:/fundamentals/menus.html#menus-settings\">Settings Menu</ulink> "
"and <ulink url=\"help:/fundamentals/menus.html#menus-help\">Help "
"Menu</ulink> of the &kde; Fundamentals."
msgstr ""
"अतिरिक्तरूपेण &kbreakout; सामान्यं &kde; <guimenu>सेटिंग्स्</guimenu> तथा "
"<guimenu>सहायता</guimenu> मेनू-वस्तूनाम्, अधिकसूचनार्थं <ulink "
"url=\"help:/fundamentals/menus.html#menus-settings\">सेटिंग्स् मेनु< "
"इत्यस्य विषये विभागान् पठन्तु /ulink> तथा च &kde; मौलिकता।"

