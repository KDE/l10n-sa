#: index.docbook:23
#. Tag: para
#, no-c-format
msgid ""
"This is the documentation for the &systemsettings; module to customize the "
"mouse cursor appearance."
msgstr ""
"एतत् &systemsettings; module इत्यनेन मूषकस्य कर्सरस्य स्वरूपं अनुकूलितुं "
"शक्यते ।"

#: index.docbook:29
#. Tag: keyword
#, no-c-format
msgid "<keyword>KDE</keyword>"
msgstr "<keyword>WHERE</keyword> इति"

#: index.docbook:30
#. Tag: keyword
#, no-c-format
