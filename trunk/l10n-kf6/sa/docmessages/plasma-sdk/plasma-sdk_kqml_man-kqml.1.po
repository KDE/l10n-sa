msgid ""
"<command>kqml</command> was written by "
"<personname><firstname>ivan</firstname><surname>tkachenko</surname></"
"personname> <email>me@raitjas.tk</email>."
msgstr ""
"<command>kqml</command> इति "
"<personname><firstname>ivan</firstname><surname>tkachenko</surname></"
"personname> <email>me@raitjas.tk</email> इत्यनेन लिखितम् ।"
