msgstr "अस्य पटलस्य द्वौ विभागौ स्तः ।"

#. Tag: guilabel
#: index.docbook:692
#, no-c-format
msgid "Shake pointer to find it"
msgstr ""

#. Tag: para
#: index.docbook:694
#, no-c-format
msgid "If this option is enabled, &plasma; enables the shake ponter effect."
msgstr ""

