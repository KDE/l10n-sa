"action=\"simul\">&Ctrl;<keycap>H</keycap></keycombo></shortcut> "
"<guimenu>खेल</guimenu> <guimenuitem>उच्चाङ्कान् दर्शयतु</guimenuitem>"

#: index.docbook:247
#. Tag: action
#, no-c-format
msgid "Show the highest scores so far."
msgstr "अद्यावधि सर्वोच्चाङ्कान् दर्शयतु।"

#: index.docbook:254
#. Tag: menuchoice
#, no-c-format
msgid "<guimenu>Game</guimenu> <guimenuitem>Single Player</guimenuitem>"
msgstr "<guimenu>खेल</guimenu> <guimenuitem>एकः खिलाडी</guimenuitem>"

#: index.docbook:262
#. Tag: action
#, no-c-format
msgid "Start a game with your computer as the opponent."
msgstr "प्रतिद्वन्द्वीरूपेण स्वसङ्गणकेन सह क्रीडां आरभत।"

#: index.docbook:269
#. Tag: menuchoice
#, no-c-format
msgid "<guimenu>Game</guimenu> <guimenuitem>Host Game…</guimenuitem>"
msgstr "<guimenu>क्रीडा</guimenu> <guimenuitem>होस्ट् क्रीडा…</guimenuitem>"

#: index.docbook:277
#. Tag: action
#, no-c-format
msgid "Start the server so another player can connect to you."
msgstr "सर्वरं आरभत येन अन्यः खिलाडी भवता सह सम्बद्धः भवितुम् अर्हति ।"

#: index.docbook:284
#. Tag: menuchoice
#, no-c-format
