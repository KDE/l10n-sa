# automatic translation
#: index.docbook:342
#. Tag: menuchoice
#, no-c-format
msgid ""
"<guimenu>Startup</guimenu> <guimenuitem>Start KMix on desktop "
"startup</guimenuitem>"
msgstr ""
"<guimenu>प्रारम्भः</guimenu> <guimenuitem>डेस्कटॉप् प्रारम्भे KMix "
