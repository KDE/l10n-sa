# automatic translation
#: index.docbook:233
#. Tag: menuchoice
#, no-c-format
msgid "<guimenu>Behavior</guimenu> <guimenuitem>Volume Overdrive</guimenuitem>"
msgstr "<guimenu>व्यवहारः</guimenu> <guimenuitem>मात्रा अतिड्राइव</guimenuitem>"

# automatic translation
#: index.docbook:237
#. Tag: para
#, no-c-format
msgid ""
"Check this box to allow volume to be more than recommended value (sometimes "
"PulseAudio maximal volume exceeds the normal value). &kmix; restart is "
"needed for this setting to take effect."
msgstr ""
"अनुशंसितमूल्यात् अधिकं आयतनं भवितुं अनुमतिं दातुं एतत् पेटी चिनोतु (कदाचित् "
"PulseAudio अधिकतमं आयतनं सामान्यमूल्यं अतिक्रमति) । &kmix; एतस्य सेटिङ्ग् "
"इत्यस्य प्रभावाय पुनः आरम्भस्य आवश्यकता अस्ति ।"

# automatic translation
#: index.docbook:239
#. Tag: para
#, no-c-format
msgid ""
"Uncheck this item if there are audible sound distortions at the maximal "
"volume."
msgstr ""
"यदि अधिकतममात्रायां श्रव्यध्वनिविकृतयः सन्ति तर्हि एतत् द्रव्यं अनचेक् "
"कुर्वन्तु ।"

# automatic translation
#: index.docbook:247
#. Tag: menuchoice
#, no-c-format
msgid "<guimenu>Behavior</guimenu> <guimenuitem>Volume Feedback</guimenuitem>"
msgstr "<guimenu>व्यवहार</guimenu> <guimenuitem>मात्राप्रतिक्रिया</guimenuitem>"

# automatic translation
#: index.docbook:251
#. Tag: action
#, no-c-format
msgid "Check this box to enable audible feedback on volume change."
msgstr "आयतनपरिवर्तनस्य श्रव्यप्रतिक्रिया सक्षमीकरणाय एतत् पेटी चिनोतु ।"

# automatic translation
#: index.docbook:255
#. Tag: menuchoice
#, no-c-format
msgid "<guimenu>Behavior</guimenu> <guimenuitem>Volume step</guimenuitem>"
msgstr "<guimenu>व्यवहार</guimenu> <guimenuitem>मात्राचरण</guimenuitem>"

# automatic translation
#: index.docbook:260
#. Tag: para
#, no-c-format
msgid "Set the volume step as a percentage of the volume range."
msgstr "आयतनपदं आयतनपरिधिस्य प्रतिशतरूपेण सेट् कुर्वन्तु ।"

# automatic translation
#: index.docbook:263
#. Tag: para
#, no-c-format
msgid ""
"This affects changing the volume via hot keys, with the mouse wheel over "
"the system tray icon, or moving sliders by a page step."
msgstr ""
"एतेन हॉट् कीलद्वारा मात्रां परिवर्तयितुं, सिस्टम् ट्रे चिह्नस्य उपरि "
"मूषकचक्रं कृत्वा, अथवा पृष्ठपदेन स्लाइडर् चालयितुं प्रभावितं भवति ।"

# automatic translation
#: index.docbook:266
#. Tag: para
#, no-c-format
msgid "&kmix; must be restarted for this change to take effect."
msgstr "&kmix; अस्य परिवर्तनस्य प्रभावाय पुनः आरम्भः करणीयः ।"

# automatic translation
#: index.docbook:273
#. Tag: menuchoice
#, no-c-format
msgid "<guimenu>Visual</guimenu> <guimenuitem>Show slider tickmarks</guimenuitem>"
msgstr ""
"<guimenu>दृश्य</guimenu> <guimenuitem>स्लाइडरटिकचिह्नानि "
"दर्शयतु</guimenuitem>"

# automatic translation
#: index.docbook:277
#. Tag: action
#, no-c-format
msgid "Check this box to show tickmarks on the sliders."
msgstr "स्लाइडर्-मध्ये टिक-चिह्नानि दर्शयितुं एतत् पेटीम् चिनोतु ।"

# automatic translation
#: index.docbook:281
#. Tag: menuchoice
#, no-c-format
msgid "<guimenu>Visual</guimenu> <guimenuitem>Show control labels</guimenuitem>"
msgstr "<guimenu>दृश्य</guimenu> <guimenuitem>नियन्त्रणलेबल् दर्शयतु</guimenuitem>"

# automatic translation
#: index.docbook:285
#. Tag: action
#, no-c-format
msgid "Check this box to show labels of controls."
msgstr "नियन्त्रणानां लेबल् दर्शयितुं एतत् पेटी चिनोतु ।"

# automatic translation
#: index.docbook:289
#. Tag: menuchoice
#, no-c-format
msgid ""
"<guimenu>Visual</guimenu> <guimenuitem>Show On Screen Display "
"(OSD)</guimenuitem>"
msgstr ""
"<guimenu>दृश्य</guimenu> <guimenuitem>पर्दे प्रदर्शनं (OSD) "
"दर्शयतु</guimenuitem>"

# automatic translation
#: index.docbook:293
#. Tag: action
#, no-c-format
msgid "Check this box to enable OSD show on hovering &kmix; tray widget."
msgstr "&kmix; ट्रे विजेट।"

# automatic translation
#: index.docbook:297
#. Tag: menuchoice
#, no-c-format
msgid ""
"<guimenu>Slider orientation (main window)</guimenu> "
"<guimenuitem>Horizontal</guimenuitem>"
msgstr ""
"<guimenu>स्लाइडर अभिमुखीकरणं (मुख्यविण्डो)</guimenu> "
"<guimenuitem>क्षैतिज</guimenuitem>"

# automatic translation
#: index.docbook:301
#. Tag: action
#, no-c-format
msgid "Check this radio button to orientate the control slider horizontally."
msgstr "नियन्त्रणस्लाइडरं क्षैतिजरूपेण उन्मुखीकर्तुं एतत् रेडियो बटनं पश्यन्तु ।"

# automatic translation
#: index.docbook:305
#. Tag: menuchoice
#, no-c-format
msgid ""
"<guimenu>Slider orientation (main window)</guimenu> "
"<guimenuitem>Vertical</guimenuitem>"
msgstr ""
"<guimenu>स्लाइडर अभिविन्यासः (मुख्यविण्डो)</guimenu> "
"<guimenuitem>ऊर्ध्वाधर</guimenuitem>"

# automatic translation
#: index.docbook:309
#. Tag: action
#, no-c-format
msgid "Check this radio button to orientate the control slider vertically."
msgstr "नियन्त्रणस्लाइडरं लम्बवत् उन्मुखीकर्तुं एतत् रेडियो बटनं पश्यन्तु ।"

# automatic translation
#: index.docbook:313
#. Tag: menuchoice
#, no-c-format
msgid ""
"<guimenu>Slider orientation (system tray popup)</guimenu> "
"<guimenuitem>Horizontal/Vertical</guimenuitem>"
msgstr ""
"<guimenu>स्लाइडर अभिविन्यास (प्रणाली ट्रे पॉपअप)</guimenu> "
"<guimenuitem>क्षैतिज/ऊर्ध्वाधर</guimenuitem>"

# automatic translation
#: index.docbook:317
#. Tag: para
#, no-c-format
msgid ""
"Same as the previous two radio buttons but for the system tray volume "
"control (the panel that is shown after &LMB; click on &kmix; tray icon)."
msgstr ""
"पूर्वयोः रेडियो-बटनयोः समानं किन्तु सिस्टम् ट्रे वॉल्यूम् नियन्त्रणस्य कृते "
"(&LMB; &kmix; ट्रे चिह्नस्य उपरि क्लिक् कृत्वा यत् पटलं दर्शितं भवति) ।"

