msgstr "पृष्ठभूमि कृते इष्टं ठोसवर्णं उपयुज्यताम् ।"

#: index.docbook:483
#. Tag: guilabel
#, no-c-format
msgid "Image"
msgstr "छवि"

#: index.docbook:484
