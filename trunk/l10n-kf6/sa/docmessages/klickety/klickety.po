msgstr ""
"<menuchoice> <shortcut><keycombo "
"action=\"simul\">&Ctrl;<keycap>S</keycap></keycombo></shortcut> "
"<guimenu>खेल</guimenu> <guimenuitem>रक्षतु</guimenuitem> </ menuchoice> "
"(KSame मोड् मध्ये न)"

#: index.docbook:284
#. Tag: para
#, no-c-format
msgid "Saves the current state of the game to the disk."
