# automatic translation
#: index.docbook:149
#. Tag: para
#, no-c-format
msgid ""
"As mentioned above, a reflection occurs when a beam emerges from the same "
"point it was sent in. This can happen in several ways:"
msgstr ""
"यथा उपरि उक्तं, प्रतिबिम्बं तदा भवति यदा किरणः यस्मिन् बिन्दौ प्रेषितः "
"आसीत् तस्मात् एव बिन्दुतः निर्गच्छति ।एतत् अनेकधा भवितुम् अर्हति ।"

# automatic translation
#: index.docbook:154
#. Tag: screen
#, no-c-format
msgid ""
"- - - - - - - -         - - - - - - - -          - - - - - - - -\n"
"  - - - - O - - -         - - O - O - - -          - - - - - - - -\n"
