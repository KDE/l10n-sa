msgstr "केवलं घटनानां कृते कार्यं कुर्वन्तु (पूर्वनिर्धारितम्)।"

# automatic translation
#: index.docbook:481
#. Tag: option
#, no-c-format
msgid "--todo"
msgstr "--सर्वे"

# automatic translation
#: index.docbook:482
#. Tag: entry
#, no-c-format
msgid "Operate for Todos only. (Not implemented)"
msgstr "केवलं टोडोस् कृते एव संचालनं कुर्वन्तु। (न कार्यान्वितः) २."

# automatic translation
#: index.docbook:485
#. Tag: option
#, no-c-format
