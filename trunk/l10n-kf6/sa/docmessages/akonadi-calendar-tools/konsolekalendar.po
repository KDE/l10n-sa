# automatic translation
#: index.docbook:404
#. Tag: title
#, no-c-format
msgid "Importing Calendars"
msgstr "कैलेण्डरस्य आयातम्"

# automatic translation
#: index.docbook:406
#. Tag: para
#, no-c-format
msgid ""
"&konsolekalendar; can import an iCal or vCal calendar file into calendar. "
"All events from the calendar being imported from will be inserted, skipping "
"identical events, that are already part of the calendar."
msgstr ""
"&konsolekalendar; iCal अथवा vCal पञ्चाङ्गसञ्चिकां पञ्चाङ्गे आयातयितुं "
"शक्नोति । आयातितस्य पञ्चाङ्गात् सर्वाणि घटनानि सम्मिलिताः भविष्यन्ति, "
"समानघटनानि त्यक्त्वा, ये पूर्वमेव पञ्चाङ्गस्य भागाः सन्ति ।"

# automatic translation
#: index.docbook:411
#. Tag: para
#, no-c-format
msgid ""
"To import calendar file <replaceable>vacation.ics</replaceable> into "
"calendar with the id <replaceable>8</replaceable> run:"
msgstr ""
"पञ्चाङ्गसञ्चिकां <replaceable>vacation.ics</replaceable> इत्येतत् id "
"<replaceable>8</replaceable> इत्यनेन सह पञ्चाङ्गे आयातयितुं चालयन्तु:"

# automatic translation
#: index.docbook:416
#. Tag: screen
#, no-c-format
msgid ""
"<prompt>%</prompt><userinput> <command>konsolekalendar</command> "
"<option>--import <replaceable>vacation.ics</replaceable></option> "
"<option>--calendar <replaceable>8</replaceable></option></userinput>"
msgstr ""
"<prompt>, ९.</prompt><userinput><command> "
"सान्त्वपञ्चाङ्गम्</command><option> --आयात<replaceable> "
"अवकाश.ics</replaceable></option><option> --पञ्चाङ्गम्<replaceable> "
"८</replaceable></option></userinput>"

# automatic translation
#: index.docbook:426
#. Tag: title
#, no-c-format
