"<shortcut><keycombo "
"action=\"simul\">&Ctrl;&Shift;<keycap>Z</keycap></keycombo></shortcut> "
"<guimenu>खेल</guimenu> <guimenuitem>पुनः कुरुत</guimenuitem>"

# automatic translation
#: index.docbook:264
