"<shortcut>&Esc;</shortcut> <guimenu>खेल</guimenu> <guimenuitem>स्तरं पुनः "
"आरभत</guimenuitem>"

# automatic translation
#: index.docbook:230
#. Tag: action
#, no-c-format
msgid "Restart the current level."
msgstr "वर्तमानस्तरं पुनः आरभत।"

# automatic translation
#: index.docbook:235
#. Tag: menuchoice
#, no-c-format
