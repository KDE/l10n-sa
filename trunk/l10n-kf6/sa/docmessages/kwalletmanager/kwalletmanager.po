# automatic translation
#. Tag: para
#: index.docbook:32
#, no-c-format
msgid ""
"The wallet subsystem provides a convenient and secure way to manage all your "
"passwords."
msgstr ""

# automatic translation
#. Tag: keyword
#: index.docbook:39
#, no-c-format
msgid "<keyword>KDE</keyword>"
msgstr ""

# automatic translation
