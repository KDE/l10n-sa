# automatic translation
#. Tag: para
#: index.docbook:19
#, no-c-format
msgid ""
"The gzip KIO worker is not directly usable, and is intended for use as a "
"filter. For example, the tar KIO worker can filter a file through the gzip "
"KIO worker, in order to display the contents of a <literal "
"role=\"extension\">tar.gz</literal> file directly in a &konqueror; window."
msgstr ""

# automatic translation
#. Tag: para
#: index.docbook:25
#, no-c-format
msgid ""
"If you click on a file compressed with a <literal "
"role=\"extension\">gz</literal> extension in &konqueror;, this KIO worker is"
" used to uncompress it and display it as a normal (uncompressed) file."
msgstr ""

# automatic translation
#. Tag: para
#: index.docbook:30
#, no-c-format
msgid ""
"If you are a developer, and would like to use the gzip filter, you can find "
"documentation on using KIO workers at <ulink "
"url=\"http://techbase.kde.org\">http://techbase.kde.org</ulink>"
msgstr ""

# automatic translation
#. Tag: para
#: index.docbook:34
#, no-c-format
msgid "See the manual: <ulink url=\"man:/gzip\">gzip</ulink>."
msgstr ""
