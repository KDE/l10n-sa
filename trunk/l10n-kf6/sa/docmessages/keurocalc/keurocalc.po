#, no-c-format
msgid "Enter"
msgstr "प्रवेश"

#: index.docbook:514
#. Tag: guibutton
#, no-c-format
msgid "<guibutton>%</guibutton>"
msgstr "<गुइबटन>%</guibutton>"

#: index.docbook:517
#. Tag: guibutton
#, no-c-format
msgid "<guibutton>+/-</guibutton>"
msgstr "<गुइबटन>+/-</गुइबटन>"

#: index.docbook:520
#. Tag: member
#, no-c-format
msgid ""
"<guibutton>Min</guibutton>, <guibutton>MR</guibutton>, "
"<guibutton>M+</guibutton> and <guibutton>-</guibutton>"
msgstr ""
"<guibutton>Min</guibutton>, <guibutton>MR</guibutton>, "
"<guibutton>M+</guibutton> तथा <guibutton>-</guibutton> इति"

#: index.docbook:521
#. Tag: member
#, no-c-format
msgid ""
"Store result in memory, recall memory into result, add result to memory and "
