msgstr ""
"परिणामं स्मृतौ संग्रहयन्तु, स्मृतिं परिणामे स्मरणं कुर्वन्तु, परिणामं "
"स्मृतौ योजयन्तु तथा च स्मृत्याः परिणामं घटयन्तु"

#: index.docbook:523
#. Tag: member
#, no-c-format
msgid ""
"<guibutton>/</guibutton>, <guibutton>X</guibutton>, "
"<guibutton>-</guibutton> and <guibutton>+</guibutton>"
msgstr ""
"<guibutton>/</guibutton>, <guibutton>X</guibutton>, "
"<guibutton>-</guibutton> तथा <guibutton>+</guibutton> इति"

#: index.docbook:526
