#: index.docbook:495
#. Tag: member
#, no-c-format
msgid "<guibutton>.</guibutton> or <guibutton>,</guibutton>"
msgstr "<guibutton>।</guibutton> अथवा <guibutton>,</guibutton> इति"

#: index.docbook:498
#. Tag: guibutton
#, no-c-format
msgid "&lt;-"
msgstr "&lt;- २."

#: index.docbook:501
#. Tag: guibutton
#, no-c-format
