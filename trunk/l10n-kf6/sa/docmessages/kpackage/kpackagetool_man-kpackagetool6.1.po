# automatic translation
#: man-kpackagetool6.1.docbook:45
#. Tag: title
#, no-c-format
msgid "Description"
msgstr "वर्णनम्‌"

# automatic translation
#: man-kpackagetool6.1.docbook:46
#. Tag: para
#, no-c-format
msgid ""
"<command>kpackagetool6</command> is a command line tool to install, list, "
"remove &plasma; packages."
msgstr "<command>kpackagetool6</command> इति &plasma; संकुलम् ।"

# automatic translation
#: man-kpackagetool6.1.docbook:52
#. Tag: title
#, no-c-format
msgid "Options"
msgstr "विकल्पाः"

# automatic translation
#: man-kpackagetool6.1.docbook:56
#. Tag: option
#, no-c-format
msgid "-v, --version"
msgstr "-व, --संस्करणम्"

# automatic translation
#: man-kpackagetool6.1.docbook:57
#. Tag: para
#, no-c-format
msgid "Displays version information."
msgstr "संस्करणसूचनाः प्रदर्शयति ।"

# automatic translation
#: man-kpackagetool6.1.docbook:60
#. Tag: option
#, no-c-format
msgid "-h, --help"
msgstr "-ह, --सहाय"

# automatic translation
#: man-kpackagetool6.1.docbook:61
#. Tag: para
#, no-c-format
msgid "Displays this help."
msgstr "एतत् साहाय्यं प्रदर्शयति ।"

# automatic translation
#: man-kpackagetool6.1.docbook:64
#. Tag: term
#, no-c-format
msgid "<option>--hash</option> <replaceable> path</replaceable>"
msgstr "<option value=--hash>--हश</option><replaceable> पथं</replaceable>"

# automatic translation
#: man-kpackagetool6.1.docbook:65
#. Tag: para
#, no-c-format
msgid "Generate a SHA1 hash for the package at <quote>path</quote>."
msgstr "<quote>path</quote> इत्यत्र संकुलस्य कृते SHA1 हैशं जनयन्तु ।"

# automatic translation
#: man-kpackagetool6.1.docbook:68
#. Tag: option
#, no-c-format
msgid "-g, --global"
msgstr "-छ, --वैश्विक"

# automatic translation
#: man-kpackagetool6.1.docbook:69
#. Tag: para
#, no-c-format
msgid "For install or remove, operates on packages installed for all users."
msgstr ""
"संस्थापनार्थं वा निष्कासयितुं वा, सर्वेषां उपयोक्तृणां कृते संस्थापितेषु "
"संकुलेषु कार्यं करोति ।"

# automatic translation
#: man-kpackagetool6.1.docbook:72
#. Tag: term
#, no-c-format
msgid "<option>-t, --type</option> <replaceable> type</replaceable>"
msgstr ""
"<option value=\"-t, --type\">-त, --प्रकारः</option><replaceable> "
"प्रकारः</replaceable>"

# automatic translation
#: man-kpackagetool6.1.docbook:73
#. Tag: para
#, no-c-format
msgid ""
"The type of package, corresponding to the service type of the package "
"plugin, &eg; KPackage/Generic, Plasma/Theme, Plasma/Wallpaper, "
"Plasma/Applet, &etc;"
msgstr ""
"संकुलस्य प्रकारः, संकुलप्लगिन् इत्यस्य सेवाप्रकारस्य अनुरूपः, &eg; "
"केपैकेज/सामान्य, प्लाज्मा/थीम, प्लाज्मा/वॉलपेपर, प्लाज्मा/एप्लेट, &etc;"

# automatic translation
#: man-kpackagetool6.1.docbook:77
#. Tag: term
#, no-c-format
msgid "<option>-i, --install</option> <replaceable> path</replaceable>"
msgstr ""
"<option value=\"-i, --install\">-इ, --स्थापनम्</option><replaceable> "
"पथं</replaceable>"

# automatic translation
#: man-kpackagetool6.1.docbook:78
#. Tag: para
#, no-c-format
msgid "Install the package at <quote>path</quote>."
msgstr "<quote>path</quote> इत्यत्र संकुलं संस्थापयन्तु ।"

# automatic translation
#: man-kpackagetool6.1.docbook:81
#. Tag: term
#, no-c-format
msgid "<option>-s, --show</option> <replaceable> name</replaceable>"
msgstr ""
"<option value=\"-s, --show\">-स, --दर्शनम्</option><replaceable> "
"नामः</replaceable>"

# automatic translation
#: man-kpackagetool6.1.docbook:82
#. Tag: para
#, no-c-format
msgid "Show information of package <quote>name</quote>."
msgstr "<quote>name</quote> इत्यस्य संकुलस्य सूचनां दर्शयतु ।"

# automatic translation
#: man-kpackagetool6.1.docbook:85
#. Tag: term
#, no-c-format
msgid "<option>-u, --upgrade</option> <replaceable> path</replaceable>"
msgstr ""
"<option value=\"-u, --upgrade\">-उ, --उन्नयनम्</option><replaceable> "
"पथं</replaceable>"

# automatic translation
#: man-kpackagetool6.1.docbook:86
#. Tag: para
#, no-c-format
msgid "Upgrade the package at <quote>path</quote>."
msgstr "<quote>path</quote> इत्यत्र संकुलं उन्नयनं कुर्वन्तु ।"

# automatic translation
#: man-kpackagetool6.1.docbook:89
#. Tag: option
#, no-c-format
msgid "-l, --list"
msgstr "-l, --सूची"

# automatic translation
#: man-kpackagetool6.1.docbook:90
#. Tag: para
#, no-c-format
msgid "List installed packages."
msgstr "संस्थापितानां संकुलानाम् सूचीं कुर्वन्तु।"

# automatic translation
#: man-kpackagetool6.1.docbook:93
#. Tag: option
#, no-c-format
msgid "--list-types"
msgstr "--सूची-प्रकाराः"

# automatic translation
#: man-kpackagetool6.1.docbook:94
#. Tag: para
#, no-c-format
msgid "Lists all known Package types that can be installed."
msgstr ""
"सर्वान् ज्ञातान् Package प्रकारान् सूचीबद्धं करोति ये संस्थापनं कर्तुं "
"शक्यन्ते ।"

# automatic translation
#: man-kpackagetool6.1.docbook:97
#. Tag: term
#, no-c-format
msgid "<option>-r, --remove</option> <replaceable> name</replaceable>"
msgstr ""
"<option value=\"-r, --remove\">-र, --निष्कासन</option><replaceable> "
"नामः</replaceable>"

# automatic translation
#: man-kpackagetool6.1.docbook:98
#. Tag: para
#, no-c-format
msgid "Remove the package named <quote>name</quote>."
msgstr "<quote>name</quote> इति नामकं संकुलं निष्कासयन्तु ।"

# automatic translation
#: man-kpackagetool6.1.docbook:101
#. Tag: term
#, no-c-format
msgid "<option>-p, --packageroot</option> <replaceable> path</replaceable>"
msgstr ""
"<option value=\"-p, --packageroot\">-प, --पैकमूल</option><replaceable> "
"पथं</replaceable>"

# automatic translation
#: man-kpackagetool6.1.docbook:102
#. Tag: para
#, no-c-format
msgid ""
"Absolute path to the package root. If not supplied, then the standard data "
"directories for this &plasma; session will be searched instead."
msgstr ""
"संकुलमूलस्य निरपेक्षः मार्गः । यदि न आपूर्तिः, तर्हि अस्य &plasma; सत्रस्य "
"स्थाने अन्वेषणं भविष्यति।"

# automatic translation
#: man-kpackagetool6.1.docbook:106
#. Tag: term
#, no-c-format
msgid "<option>--generate-index</option> <replaceable> path</replaceable>"
msgstr ""
"<option value=--generate-index>--जनन-सूचकाङ्कः</option><replaceable> "
"पथं</replaceable>"

# automatic translation
#: man-kpackagetool6.1.docbook:107
#. Tag: para
#, no-c-format
msgid ""
"Recreate the plugin index. To be used in conjunction with either the option "
"<option>-t</option> or <option>-g</option>. Recreates the index for the "
"given type or package root. Operates in the user directory, unless "
"<option>-g</option> is used."
msgstr ""
"प्लगिन् अनुक्रमणिका पुनः रचयन्तु । विकल्पेन वा सह संयोजनेन "
"प्रयोक्तव्यम्<option value=-t> -त</option> वा<option value=-g> -छ</option> "
". दत्तप्रकारस्य अथवा संकुलमूलस्य अनुक्रमणिकां पुनः निर्माति । "
"उपयोक्तृनिर्देशिकायां कार्यं करोति, यावत्<option value=-g> -छ</option> "
"प्रयुज्यते ।"

# automatic translation
#: man-kpackagetool6.1.docbook:118
#. Tag: title
#, no-c-format
msgid "See Also"
msgstr "इदमपि पश्यन्तु"

# automatic translation
#: man-kpackagetool6.1.docbook:120
#. Tag: para
#, no-c-format
msgid ""
"More detailed user documentation is available from <ulink "
"url=\"help:/plasma-desktop\">help:/plasma-desktop</ulink> (either enter "
"this &URL; into &konqueror;, or run "
"<userinput><command>khelpcenter</command> "
"<parameter>help:/plasma-desktop</parameter></userinput>)."
msgstr ""
"अधिकविस्तृतं उपयोक्तृदस्तावेजं <ulink "
"url=\"help:/plasma-desktop\">help:/plasma-desktop</ulink> इत्यस्मात् "
"उपलभ्यते (एतत् &URL; &konqueror; मध्ये प्रविशतु, अथवा "
"<userinput><command>khelpcenter< चालयन्तु /command> "
"<parameter>help:/प्लाज्मा-डेस्कटॉप</parameter></userinput>) इति ।"

