"<personname><firstname>Ben</firstname><surname>Burton</surname></"
"personname> <email></email>"
msgstr ""
"<personname><firstname>बेन्</firstname><surname>बर्टन</surname></"
"personname> <email></email> इति"

#: man-cvslastlog.1.docbook:10
#. Tag: date
#, no-c-format
msgid "2003-04-06"
msgstr "२००३-०४-०६"

#: man-cvslastlog.1.docbook:15
