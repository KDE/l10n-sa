msgid "<manvolnum>1</manvolnum>"
msgstr "<मन्वोल्नुम्>१</मन्वोल्नुम्>"

#: man-cvslastlog.1.docbook:20
#. Tag: refpurpose
#, no-c-format
msgid "Prints the log entry for the last commit for a file."
msgstr "सञ्चिकायाः कृते अन्तिम-प्रतिबद्धतायाः कृते लॉग्-प्रविष्टिं मुद्रयति ।"

#: man-cvslastlog.1.docbook:24
#. Tag: cmdsynopsis
#, no-c-format
msgid ""
"<command>cvslastlog</command> "
"<group><option><replaceable>filename</replaceable></option></group>"
msgstr ""
"<command>cvslastlog इति</command><group><option><replaceable> "
"सञ्चिकानाम</replaceable></option></group>"

#: man-cvslastlog.1.docbook:32
#. Tag: title
#, no-c-format
msgid "Description"
msgstr "वर्णनम्‌"

#: man-cvslastlog.1.docbook:34
#. Tag: para
#, no-c-format
msgid ""
"<command>cvslastlog</command> shows the log associated with the last CVS "
"commit for the given file. It depends on the version of the local file, not "
"the one on the server."
msgstr ""
"<command>cvslastlog</command> दत्तसञ्चिकायाः अन्तिम CVS commit इत्यनेन सह "
"सम्बद्धं लॉग् दर्शयति । स्थानीयसञ्चिकायाः संस्करणस्य उपरि निर्भरं भवति, न "
"तु सर्वरे विद्यमानस्य ।"

#: man-cvslastlog.1.docbook:38
#. Tag: para
#, no-c-format
msgid "This utility is part of the &kde; Software Development Kit."
msgstr "एषा उपयोगिता &kde; सॉफ्टवेयर विकास किट।"
