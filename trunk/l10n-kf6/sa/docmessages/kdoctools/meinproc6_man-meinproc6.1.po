#: man-meinproc6.1.docbook:54
#. Tag: title
#, no-c-format
msgid "Synopsis"
msgstr "सार"

#: man-meinproc6.1.docbook:56
#. Tag: cmdsynopsis
#, no-c-format
msgid ""
"<command>meinproc6</command> <arg choice=\"opt\">-h, --help</arg> <arg "
"choice=\"opt\">-v, --version</arg> <arg choice=\"opt\">--cache<replaceable> "
"file</replaceable></arg> <arg choice=\"opt\">--check</arg> <arg "
"choice=\"opt\">--srcdir<replaceable> dir</replaceable></arg> <arg "
"choice=\"opt\">--param "
"<replaceable>key</replaceable>=<replaceable>value</replaceable></arg> "
"<group> <group> <arg>-o</arg> <arg>--output</arg> </group> <replaceable> "
"file</replaceable> </group> <arg choice=\"opt\">--stdout</arg> <arg "
"choice=\"opt\">--stylesheet<replaceable> xsl</replaceable></arg> <arg "
"choice=\"plain\">docbook_file</arg>"
msgstr ""
"<command>meinproc6</command> <arg choice=\"opt\">-h, --help</arg> <arg "
"choice=\"opt\">-v, --संस्करण</arg> <arg choice=\"opt "
"\">--सञ्चय<replaceable> सञ्चिका</replaceable></arg> <arg "
"choice=\"opt\">--परीक्षणं</arg> <arg choice=\"opt\">--srcdir<replaceable> "
"dir</replaceable></arg> <arg choice=\"opt\">--param "
"<replaceable>key</replaceable>=<प्रतिस्थापनीय>मूल्यं</replaceable></arg> "
"<समूह> <समूह> <arg> -o</arg> <arg>--निर्गम</arg> </group> <प्रतिस्थापनीय> "
"सञ्चिका</replaceable> </group> <arg choice=\"opt\">--stdout</arg> <arg "
"choice=\"opt\">--शैलीपत्र<replaceable> xsl</replaceable></arg> <arg "
"choice=\"plain\">docbook_file</arg>"

#: man-meinproc6.1.docbook:80
#. Tag: title
#, no-c-format
msgid "Description"
msgstr "वर्णनम्‌"

#: man-meinproc6.1.docbook:82
#. Tag: para
#, no-c-format
msgid "<command>meinproc6</command> converts DocBook files to &HTML;."
msgstr "<command>meinproc6</command> इत्यनेन DocBook सञ्चिकाः &HTML;"

#: man-meinproc6.1.docbook:87
#. Tag: title
#, no-c-format
msgid "Generic Options"
msgstr "सामान्यविकल्पाः"

#: man-meinproc6.1.docbook:92
#. Tag: term
#, no-c-format
msgid "<option>-h</option><option>--help</option>"
msgstr "<option value=-h>-ह</option><option value=--help> --साहाय्यम्‌</option>"

#: man-meinproc6.1.docbook:94
#. Tag: para
#, no-c-format
msgid "Show help about options."
msgstr "विकल्पानां विषये सहायतां दर्शयतु।"

#: man-meinproc6.1.docbook:101
#. Tag: term
#, no-c-format
msgid "<option>-v</option><option>--version</option>"
msgstr "<option value=-v>-वि</option><option value=--version> --संस्करण</option>"

#: man-meinproc6.1.docbook:103
#. Tag: para
#, no-c-format
msgid "Show version information."
msgstr "संस्करणसूचना दर्शयतु।"

#: man-meinproc6.1.docbook:114
#. Tag: title
#, no-c-format
msgid "Application Options"
msgstr "अनुप्रयोगविकल्पाः"

#: man-meinproc6.1.docbook:118
#. Tag: term
#, no-c-format
msgid "<option>--cache</option> <parameter>file</parameter>"
msgstr "<option value=--cache>--सञ्चयम्</option><parameter> संचिका</parameter>"

#: man-meinproc6.1.docbook:120
#. Tag: para
#, no-c-format
msgid "Create a cache file for the document."
msgstr "दस्तावेजस्य कृते एकं cache file रचयन्तु ।"

#: man-meinproc6.1.docbook:127
#. Tag: option
#, no-c-format
msgid "--check"
msgstr "--अनुशीलय"

#: man-meinproc6.1.docbook:129
#. Tag: para
#, no-c-format
msgid "Check the document for validity."
msgstr "दस्तावेजस्य वैधतायाः परीक्षणं कुर्वन्तु।"

#: man-meinproc6.1.docbook:130
#. Tag: screen
#, no-c-format
msgid ""
"The output can be a bit daunting, since one small mistake can cause a "
"cascade of errors. \n"
"The trick is to look at the first error, fix that error, save the file, and "
"run <command>meinproc6</command> again."
msgstr ""
"उत्पादनं किञ्चित् भयङ्करं भवितुम् अर्हति, यतः एकः लघुदोषः दोषाणां झरनं "
"जनयितुं शक्नोति । \n"
"प्रथमं दोषं दृष्ट्वा, तत् दोषं निवारयित्वा, सञ्चिकां रक्षित्वा, पुनः "
"<command>meinproc6</command> चालयितुं च युक्तिः अस्ति ।"

#: man-meinproc6.1.docbook:135
#. Tag: term
#, no-c-format
msgid "<option>-o</option>, <option>--output</option><parameter> file</parameter>"
msgstr ""
"<option value=-o>-o</option> , ९.<option value=--output> "
"--निर्गमः</option><parameter> संचिका</parameter>"

#: man-meinproc6.1.docbook:137
#. Tag: para
#, no-c-format
msgid "Output whole document to <parameter>file</parameter>."
msgstr "सम्पूर्णं दस्तावेजं <parameter>file</parameter> इत्यत्र निर्गच्छतु ।"

#: man-meinproc6.1.docbook:144
#. Tag: option
#, no-c-format
msgid "--stdout"
msgstr "--stdout इति"

#: man-meinproc6.1.docbook:146
#. Tag: para
#, no-c-format
msgid "Output whole document to stdout."
msgstr "stdout मध्ये सम्पूर्णं दस्तावेजं आउटपुट् कुर्वन्तु ।"

#: man-meinproc6.1.docbook:153
#. Tag: term
#, no-c-format
msgid "<option>--stylesheet</option> <parameter>xsl</parameter>"
msgstr "<option value=--stylesheet>--शैलीपत्रम्</option><parameter> xsl</parameter>"

#: man-meinproc6.1.docbook:155
#. Tag: para
#, no-c-format
msgid "Stylesheet to use."
msgstr "उपयोगाय शैलीपत्रम् ।"

#: man-meinproc6.1.docbook:162
#. Tag: term
#, no-c-format
msgid "<option>--srcdir</option> <parameter>dir</parameter>"
msgstr "<option value=--srcdir>--srcdir</option><parameter> त्वम्‌</parameter>"

#: man-meinproc6.1.docbook:164
#. Tag: para
#, no-c-format
msgid "Set the root directory to look for kdoctools."
msgstr "kdoctools अन्वेष्टुं मूलनिर्देशिकां सेट् कुर्वन्तु ।"

#: man-meinproc6.1.docbook:171
#. Tag: term
#, no-c-format
msgid "<option>--param</option> key=value"
msgstr "<option value=--param>--परम्</option> कील=मूल्यम्"

#: man-meinproc6.1.docbook:173
#. Tag: para
#, no-c-format
msgid "Set parameters to pass to the stylesheet."
msgstr "स्टाइलशीट् मध्ये पारयितुं पैरामीटर्स् सेट् कुर्वन्तु ।"

#: man-meinproc6.1.docbook:184
#. Tag: title
#, no-c-format
msgid "Usage"
msgstr "प्रयोगः"

#: man-meinproc6.1.docbook:185
#. Tag: para
#, no-c-format
msgid ""
"The most common way to run <command>meinproc6</command> is simply as "
"<literallayout>\n"
"<userinput><command>meinproc6</command> "
"<replaceable>docbook-file</replaceable>\n"
"</userinput>\n"
"</literallayout> where <replaceable>docbook-file</replaceable> is usually "
"index.docbook. This command creates &HTML; pages from the DocBook file. "
"Note that these pages are only viewable in &kde;-based browsers (like "
"&konqueror;)."
msgstr ""
"<command>meinproc6</command> चालयितुं सर्वाधिकं सामान्यः उपायः केवलं "
"<literlayout> इव अस्ति\n"
"<userinput><command>meinproc6</command> "
"<प्रतिस्थापनीय>डॉकबुक-सञ्चिका</replaceable>\n"
"</userinput> इति\n"
"</literlayout> यत्र <replaceable>docbook-file</replaceable> प्रायः "
"index.docbook भवति । एषः आदेशः &HTML; DocBook सञ्चिकातः पृष्ठानि । ध्यानं "
"कुर्वन्तु यत् एतानि पृष्ठानि केवलं &kde;-आधारित-ब्राउजरेषु (&konqueror; "
"इत्यादिषु) दृश्यन्ते ।"

#: man-meinproc6.1.docbook:192
#. Tag: para
#, no-c-format
msgid ""
"If you need to view the &HTML; output in another browser (for example, if "
"you're placing it on line), use <literallayout>\n"
"<userinput><command>meinproc6</command> --stylesheet "
"<replaceable>stylesheet-name</replaceable> "
"<replaceable>docbook-file</replaceable>\n"
"</userinput>\n"
"</literallayout> where <replaceable>stylesheet-name</replaceable> is the "
"full path to one of the &XSL; stylesheets in "
"&lt;kdoctools_installation_prefix&gt;/share/kf5/kdoctools/customization/. "
"To produce output suitable for the web, you can use "
"<command>kde-web.xsl</command> or <command>kde-chunk-online.xsl</command>. "
"See the <filename>README</filename> file in that directory for more details."
msgstr ""
"यदि भवान् &HTML; अन्यस्मिन् ब्राउजरे आउटपुट् (उदाहरणार्थं, यदि भवान् तत् "
"रेखायां स्थापयति), <literallayout> इत्यस्य उपयोगं कुर्वन्तु\n"
"<userinput><command>meinproc6</command> --stylesheet "
"<replaceable>शैलीपत्रक-नाम</replaceable> "
"<replaceable>docbook-file</replaceable>\n"
"</userinput> इति\n"
"</literlayout> यत्र <replaceable>stylesheet-name</replaceable> &XSL; "
"&lt;kdoctools_installation_prefix&gt;/share/kf5/kdoctools/customization/ "
"इत्यस्मिन् शैलीपत्राणि । जालस्य अनुकूलं उत्पादनं उत्पादयितुं भवान् "
"<command>kde-web.xsl</command> अथवा <command>kde-chunk-online.xsl</command> "
"इत्यस्य उपयोगं कर्तुं शक्नोति । अधिकविवरणार्थं तस्मिन् निर्देशिकायां "
"<filename>README</filename> सञ्चिकां पश्यन्तु ।"

