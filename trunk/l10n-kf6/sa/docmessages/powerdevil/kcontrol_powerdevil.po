#, no-c-format
msgid "<title>Advanced Settings</title>"
msgstr "<title>उन्नत सेटिंग्स्</title>"

# automatic translation
#: index.docbook:156
#. Tag: screeninfo
#, no-c-format
msgid "<screeninfo>Advanced Settings</screeninfo>"
msgstr "<screeninfo>उन्नतसेटिंग्स्</screeninfo>"

# automatic translation
#: index.docbook:162
#. Tag: phrase
#, no-c-format
msgid "<phrase>Advanced Settings</phrase>"
msgstr "<phrase>उन्नतसेटिंग्स्</phrase> इति"

