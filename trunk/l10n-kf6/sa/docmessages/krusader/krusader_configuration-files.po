# automatic translation
#: configuration-files.docbook:131
#. Tag: para
#, no-c-format
msgid ""
"This is a <literal role=\"extension\">.ini</literal> file that holds a "
"<link linkend=\"configure-shortcuts\">Key binding profile</link>. Until "
"&krusader;-1.70.0 this was a binary file. &krusader; is backwards "
"compatible for importing this legacy binary format."
msgstr ""
"इति क<literal role=\"extension\"> .इनि</literal> सञ्चिका या धारयति a<link "
"linkend=\"configure-shortcuts\"> कुंजी बन्धन प्रोफाइल</link> . "
"&amp;krusader;-1.70.0 पर्यन्तं एषा द्विचक्रीयसञ्चिका आसीत् । &amp;krusader; "
"अस्य विरासतां द्विचक्रीयस्वरूपस्य आयातार्थं पश्चात्तापसङ्गतम् अस्ति ।"

# automatic translation
#: configuration-files.docbook:136
#. Tag: para
#, no-c-format
msgid "Location: <filename> /usr/share/krusader/foo.keymap</filename>"
msgstr "स्थानम् : <filename> /usr/share/krusader/foo.keymap</filename> इति"

