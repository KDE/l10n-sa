#: index.docbook:232
#. Tag: entry
#, no-c-format
msgid ""
"Opens an existing <literal role=\"extension\">.tuberling</literal> file "
"from the disk."
msgstr ""
"डिस्कतः विद्यमानं <literal role=\"extension\">.tuberling</literal> सञ्चिकां "
"उद्घाटयति ।"

#: index.docbook:239
#. Tag: phrase
#, no-c-format
msgid "Save Button"
msgstr "Save Button इति"

#: index.docbook:242
#. Tag: guiicon
#, no-c-format
msgid "Save"
msgstr "रक्ष्"

#: index.docbook:243
#. Tag: menuchoice
