# automatic translation
#: man-kwallet-query.1.docbook:42
#. Tag: simpara
#, no-c-format
msgid ""
"<command>kwallet-query</command> comes in handy when shell scripts need to "
"read or update the &kde; Wallet. It works by manipulating the entries "
"displayed in the <emphasis role=\"strong\">&kde; Wallet Manager</emphasis> "
"utility. It&#8217;s only parameter is the <emphasis>wallet</emphasis>name "
"the tool should read or update. The operation mode is specified by the "
"options."
msgstr ""
"<command>kwallet-query</command> तदा उपयोगी भवति यदा शेल् स्क्रिप्ट्-मध्ये "
"&kde; लघुपुट। <emphasis role=\"strong\">&kde; बटुआ प्रबन्धक</emphasis> "
"उपयोगिता । अस्य एकमात्रं पैरामीटर् अस्ति यत् <emphasis>wallet</emphasis>नाम "
"साधनेन पठितव्यं अथवा अद्यतनं कर्तव्यम् । विकल्पैः संचालनविधिः निर्दिष्टा "
"भवति ।"

# automatic translation
#: man-kwallet-query.1.docbook:45
#. Tag: title
#, no-c-format
msgid "OPTIONS"
msgstr "OPTIONS इति"

# automatic translation
#: man-kwallet-query.1.docbook:49
#. Tag: emphasis
#, no-c-format
msgid "-h,--help"
msgstr "-ह,--सहाय"

# automatic translation
#: man-kwallet-query.1.docbook:52
#. Tag: simpara
#, no-c-format
msgid "Display a short help message."
msgstr "लघुसहायकसन्देशं प्रदर्शयन्तु।"

# automatic translation
#: man-kwallet-query.1.docbook:57
#. Tag: emphasis
#, no-c-format
msgid "-l,--list-entries"
msgstr "-ल,--सूची-प्रविष्टयः"

# automatic translation
#: man-kwallet-query.1.docbook:60
#. Tag: simpara
#, no-c-format
msgid ""
"List password entries. These are the folder names displayed in the "
"<emphasis role=\"strong\">&kde; Wallet Manager</emphasis> utility. If the "
"<emphasis role=\"strong\">-f</emphasis> option is given, this will only "
"display the subfolders of the specified folder."
msgstr ""
"गुप्तशब्दप्रविष्टीनां सूचीं कुर्वन्तु। एतानि <emphasis "
"role=\"strong\">&kde; बटुआ प्रबन्धक</emphasis> उपयोगिता । यदि <emphasis "
"role=\"strong\">-f</emphasis> विकल्पः दत्तः अस्ति तर्हि एतत् केवलं "
"निर्दिष्टपुटस्य उपपुटं प्रदर्शयिष्यति ।"

# automatic translation
#: man-kwallet-query.1.docbook:64
#. Tag: term
#, no-c-format
msgid ""
"<emphasis role=\"strong\">-r,--read-password</emphasis> "
"<emphasis>Entry</emphasis>"
msgstr ""
"<emphasis role=\"strong\">-र,--पठ-गुप्तशब्द</emphasis> "
"<emphasis>प्रविष्टि</emphasis>"

# automatic translation
#: man-kwallet-query.1.docbook:69
#. Tag: simpara
#, no-c-format
msgid ""
"Read the contents of the given <emphasis>Entry</emphasis> from the "
"<emphasis role=\"strong\">Folder</emphasis>section of the "
"<emphasis>wallet</emphasis> and output it on the standard output. Maps are "
"exported as &JSON; object."
msgstr ""
"<emphasis>wallet</emphasis> इत्यस्य <emphasis "
"role=\"strong\">Folder</emphasis>विभागात् दत्तस्य "
"<emphasis>Entry</emphasis> इत्यस्य सामग्रीं पठित्वा मानकनिर्गमस्य उपरि "
"आउटपुट् कुर्वन्तु नक्शाः &JSON; वस्तु।"

# automatic translation
#: man-kwallet-query.1.docbook:73
#. Tag: term
#, no-c-format
msgid ""
"<emphasis role=\"strong\">-w,--write-password</emphasis> "
"<emphasis>Entry</emphasis>"
msgstr ""
"<emphasis role=\"strong\">-w,--write-password</emphasis> "
"<emphasis>प्रविष्टि</emphasis>"

# automatic translation
#: man-kwallet-query.1.docbook:78
#. Tag: simpara
#, no-c-format
msgid ""
"Write secrets to the given <emphasis>Entry</emphasis> under the <emphasis "
"role=\"strong\">Folder</emphasis> section of the given "
"<emphasis>wallet</emphasis>. The secrets are read from the standard input. "
"Maps take in input a well-formed &JSON; object. <emphasis "
"role=\"strong\">IMPORTANT</emphasis> previous wallet entry value will be "
"overwritten by this option, so be careful when using it!"
msgstr ""
"दत्तस्य <emphasis>वालेट्</emphasis> इत्यस्य <emphasis "
"role=\"strong\">पुट</emphasis> विभागस्य अन्तर्गतं दत्तस्य "
"<emphasis>प्रविष्टिः</emphasis> इत्यस्य रहस्यं लिखन्तु । रहस्यानि "
"मानकनिवेशात् पठ्यन्ते । नक्शाः एकं सुनिर्मितं &JSON; वस्तु। <emphasis "
"role=\"strong\">महत्त्वपूर्ण</emphasis> पूर्वं बटुकप्रविष्टिमूल्यं अस्मिन् "
"विकल्पेन अधिलिखितं भविष्यति, अतः तस्य उपयोगं कुर्वन् सावधानाः भवन्तु!"

# automatic translation
#: man-kwallet-query.1.docbook:82
#. Tag: term
#, no-c-format
msgid "<emphasis role=\"strong\">-f,--folder</emphasis> <emphasis>Folder</emphasis>"
msgstr "<emphasis role=\"strong\">-f,--पुट</emphasis> <emphasis>पुट</emphasis> इति"

# automatic translation
#: man-kwallet-query.1.docbook:87
#. Tag: simpara
#, no-c-format
msgid ""
"Set the <emphasis>wallet</emphasis> folder to <emphasis>Folder</emphasis> "
"value. By default <emphasis role=\"strong\">Passwords</emphasis> is used."
msgstr ""
"<emphasis>wallet</emphasis> पुटं <emphasis>Folder</emphasis> मूल्ये सेट् "
"कुर्वन्तु । पूर्वनिर्धारितरूपेण <emphasis "
"role=\"strong\">गुप्तशब्दाः</emphasis> इत्यस्य उपयोगः भवति ।"

# automatic translation
#: man-kwallet-query.1.docbook:92
#. Tag: emphasis
#, no-c-format
msgid "-v,--verbose"
msgstr "-व,--वाचक"

# automatic translation
#: man-kwallet-query.1.docbook:95
#. Tag: simpara
#, no-c-format
msgid "Output more information when performing the operation, to help debugging."
