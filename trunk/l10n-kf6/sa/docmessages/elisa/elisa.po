msgstr "आमुख"

#: index.docbook:68
#. Tag: para
#, no-c-format
msgid "&elisa; is a music player designed to be simple to use."
msgstr "&elisa; इति सङ्गीतवादकः यस्य उपयोगः सरलः भवेत् ।"

#: index.docbook:72
#. Tag: screeninfo
