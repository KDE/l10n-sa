#: index.docbook:3741 index.docbook:3969 index.docbook:4167 index.docbook:4332
#: index.docbook:4528
#, no-c-format
msgid "name"
msgstr ""

# automatic translation
#. Tag: para
#: index.docbook:3743 index.docbook:3971 index.docbook:4169 index.docbook:4334
#: index.docbook:4530
#, no-c-format
msgid "Specifies an optional name for the alarm."
msgstr ""

# automatic translation
#. Tag: parameter
#: index.docbook:3748 index.docbook:4363
#, no-c-format
msgid "<parameter>message</parameter>"
msgstr ""

# automatic translation
#. Tag: para
#: index.docbook:3750
#, no-c-format
msgid ""
"Specifies the text of the message to be scheduled, or if "
"<parameter>flags</parameter> has the <userinput>DISPLAY_COMMAND</userinput> "
"bit set, specifies the command line to execute to generate the message text."
msgstr ""

# automatic translation
#. Tag: parameter
#: index.docbook:3758 index.docbook:3984 index.docbook:4183 index.docbook:4378
#: index.docbook:4550
#, no-c-format
msgid "startDateTime"
msgstr ""

# automatic translation
#. Tag: para
#: index.docbook:3760 index.docbook:3986 index.docbook:4185 index.docbook:4380
#: index.docbook:4552
#, no-c-format
msgid ""
"Specifies the scheduled date, or date and time, at which the message should "
"be displayed. For a date-only alarm, the string should be in the format "
"<replaceable>YYYY-MM-DD[ TZ]</replaceable> (as returned by "
"<methodname>QDate::toString(Qt::ISODate)</methodname>). For an alarm with a "
"date and time, the string should be in the format <replaceable>YYYY-MM-"
"DDTHH:MM[:SS][ TZ]</replaceable> (as returned by "
"<methodname>QDateTime::toString(Qt::ISODate)</methodname>) or "
"<replaceable>HH:MM[:SS]</replaceable> (as returned by "
"<methodname>QTime::toString(Qt::ISODate)</methodname>). If no date is "
"specified, today's date is used. Note that any seconds value is ignored."
msgstr ""

# automatic translation
#. Tag: para
#: index.docbook:3772 index.docbook:3998 index.docbook:4197 index.docbook:4392
#: index.docbook:4564
#, no-c-format
msgid ""
"If no time zone is specified, the local system time zone is assumed. If a "
"time zone specifier <replaceable>TZ</replaceable> is present, it may be the "
"name of a system time zone (&eg; <userinput>Europe/London</userinput>), or "
"<userinput>UTC</userinput> representing the UTC time zone."
msgstr ""

# automatic translation
#. Tag: parameter
#: index.docbook:3781 index.docbook:4007 index.docbook:4206 index.docbook:4401
#: index.docbook:4573
#, no-c-format
msgid "lateCancel"
msgstr ""

# automatic translation
#. Tag: para
#: index.docbook:3783 index.docbook:4009 index.docbook:4208 index.docbook:4403
#: index.docbook:4575
#, no-c-format
msgid ""
"Causes the alarm to be canceled if it cannot be triggered within the "
"specified number of minutes after the alarm's scheduled time. If the value "
"is 0, the alarm will not be canceled no matter how late it is triggered."
msgstr ""

# automatic translation
#. Tag: parameter
#: index.docbook:3791 index.docbook:4017 index.docbook:4216 index.docbook:4411
#: index.docbook:4583
#, no-c-format
msgid "flags"
msgstr ""

# automatic translation
#. Tag: para
#: index.docbook:3793
#, no-c-format
msgid ""
"Specifies the logical OR of the desired alarm flags. The flag bits are those"
" defined in class <classname>KAlarmIface</classname> in "
"<filename>kalarmiface.h</filename>. Note that not all flag bits are "
"applicable to message alarms."
msgstr ""

# automatic translation
#. Tag: parameter
#: index.docbook:3801 index.docbook:4027
#, no-c-format
msgid "bgColor"
msgstr ""

# automatic translation
#. Tag: para
#: index.docbook:3803
#, no-c-format
msgid ""
"Specifies the background color for displaying the message. The string may be"
" in the format <quote>#RRGGBB</quote> (as returned by "
"<methodname>QColor::name()</methodname>) where RR, GG and BB are two-digit "
"hexadecimal values for red, green and blue. Alternatively the string may be "
"in any of the other formats accepted by "
"<methodname>QColor::setNamedColor()</methodname>, such as a name from the X "
"color database (&eg; <quote>red</quote> or <quote>steelblue</quote>). Set "
"the string to null to specify the current default background color."
msgstr ""

# automatic translation
#. Tag: parameter
#: index.docbook:3816
#, no-c-format
msgid "fgColor"
msgstr ""

# automatic translation
#. Tag: para
#: index.docbook:3818
#, no-c-format
msgid ""
"Specifies the foreground color for displaying the message. The format of the"
" string is the same as for <parameter>bgColor</parameter>, or alternatively "
"set the string to null to specify the current default foreground color."
msgstr ""

# automatic translation
#. Tag: parameter
#: index.docbook:3826
#, no-c-format
msgid "font"
msgstr ""

# automatic translation
#. Tag: para
#: index.docbook:3828
#, no-c-format
msgid ""
"Specifies the font for displaying the message. The format of the string is "
"that output by <methodname>QFont::toString()</methodname>. Set the string to"
" null to use the default message font current at the time the message is "
"displayed."
msgstr ""

# automatic translation
#. Tag: parameter
#: index.docbook:3836 index.docbook:4042 index.docbook:4535
#, no-c-format
msgid "audioURL"
msgstr ""

# automatic translation
#. Tag: para
#: index.docbook:3838 index.docbook:4044
#, no-c-format
msgid ""
"Specifies the audio file which is to be played when the message is "
"displayed. Set the value to null if no audio file is to be played."
msgstr ""

# automatic translation
#. Tag: parameter
#: index.docbook:3845 index.docbook:4051
#, no-c-format
msgid "reminderMins"
msgstr ""

# automatic translation
#. Tag: para
#: index.docbook:3847 index.docbook:4053
#, no-c-format
msgid ""
"Specifies the number of minutes in advance of the main alarm and of each of "
"its recurrences (if any) at which a reminder alarm should be displayed. "
"Specify a negative value for a reminder to be displayed after the main "
"alarm. Specify 0 if no reminder is required."
msgstr ""

# automatic translation
#. Tag: parameter
#: index.docbook:3855 index.docbook:4061 index.docbook:4226 index.docbook:4421
#: index.docbook:4593
#, no-c-format
msgid "recurrence"
msgstr ""

# automatic translation
#. Tag: para
#: index.docbook:3857 index.docbook:4063 index.docbook:4228 index.docbook:4423
#: index.docbook:4595
#, no-c-format
msgid ""
"Specifies a regular recurrence for the alarm, using iCalendar syntax as "
"defined in <ulink "
"url=\"http://www.w3.org/2002/12/cal/rfc2445.html\">RFC2445</ulink>. For "
"example, <quote>FREQ=MONTHLY;COUNT=4;INTERVAL=3;BYDAY=-1MO</quote> would "
"specify 4 repetitions at 3-monthly intervals on the last Monday of the "
"month. For a non-recurring alarm, specify an empty string."
msgstr ""

# automatic translation
#. Tag: parameter
#: index.docbook:3868 index.docbook:4074 index.docbook:4239 index.docbook:4434
#: index.docbook:4606
#, no-c-format
msgid "recurType"
msgstr ""

# automatic translation
#. Tag: para
#: index.docbook:3870 index.docbook:4076 index.docbook:4241 index.docbook:4436
#: index.docbook:4608
#, no-c-format
msgid ""
"Specifies the recurrence type for the alarm. The permissible values are "
"MINUTELY, DAILY, WEEKLY, MONTHLY, YEARLY. These are defined in class "
"<classname>KAlarmIface</classname> in <filename>kalarmiface.h</filename>. "
"Monthly recurrences are of the day of the month type, and yearly recurrences"
" are of the date in the year type, with the date in both cases taken from "
"the <parameter>startDateTime</parameter> parameter."
msgstr ""

# automatic translation
#. Tag: parameter
#: index.docbook:3881 index.docbook:4087 index.docbook:4252 index.docbook:4447
#: index.docbook:4619
#, no-c-format
msgid "recurInterval"
msgstr ""

# automatic translation
#. Tag: para
#: index.docbook:3883 index.docbook:4089 index.docbook:4254 index.docbook:4449
#: index.docbook:4621
#, no-c-format
msgid ""
"Specifies the number of periods (minutes/days/weeks/months/years as "
"specified by <parameter>recurType</parameter>) between recurrences of the "
"alarm."
msgstr ""

# automatic translation
#. Tag: parameter
#: index.docbook:3891 index.docbook:4097 index.docbook:4262 index.docbook:4457
#: index.docbook:4629
#, no-c-format
msgid "recurCount"
msgstr ""

# automatic translation
#. Tag: para
#: index.docbook:3893 index.docbook:4099 index.docbook:4264 index.docbook:4459
#: index.docbook:4631
#, no-c-format
msgid ""
"Specifies the number of times that the alarm should be repeated. Specify -1 "
"to repeat the alarm indefinitely."
msgstr ""

# automatic translation
#. Tag: parameter
#: index.docbook:3899 index.docbook:4105 index.docbook:4270 index.docbook:4465
#: index.docbook:4637
#, no-c-format
msgid "endDateTime"
msgstr ""

# automatic translation
#. Tag: para
#: index.docbook:3901 index.docbook:4107 index.docbook:4272 index.docbook:4467
#: index.docbook:4639
#, no-c-format
msgid ""
"Specifies the end date, or date and time, for recurrences of the alarm. If "
"<parameter>startDateTime</parameter> includes a time, this parameter must "
"also include a time; if <parameter>startDateTime</parameter> contains only a"
" date, this parameter must also contain only a date. It must not contain a "
"time zone specifier; the same time zone as for "
"<parameter>startDateTime</parameter> is used to interpret this parameter's "
"value."
msgstr ""

# automatic translation
#. Tag: parameter
#: index.docbook:3912 index.docbook:4118 index.docbook:4283 index.docbook:4478
#: index.docbook:4650
#, no-c-format
msgid "subRepeatInterval"
msgstr ""

# automatic translation
#. Tag: para
#: index.docbook:3914 index.docbook:4120 index.docbook:4285 index.docbook:4480
#: index.docbook:4652
#, no-c-format
msgid ""
"Specifies the number of minutes between sub-repetitions of the alarm. "
"Specify 0 for no sub-repetition. Ignored if no recurrence is specified."
msgstr ""

# automatic translation
#. Tag: parameter
#: index.docbook:3921 index.docbook:4127 index.docbook:4292 index.docbook:4487
#: index.docbook:4659
#, no-c-format
msgid "subRepeatCount"
msgstr ""

# automatic translation
#. Tag: para
#: index.docbook:3923 index.docbook:4129 index.docbook:4294 index.docbook:4489
#: index.docbook:4661
#, no-c-format
msgid ""
"Specifies the number of sub-repetitions of the alarm, including the initial "
"occurrence."
msgstr ""

# automatic translation
#. Tag: para
#: index.docbook:3933
#, no-c-format
msgid ""
"<function>scheduleMessage()</function> is a &DBus; call to schedule the "
"specified alarm message for display at the specified date and time. It has "
"three forms. The most general form allows an arbitrary recurrence to be "
"specified &ndash; use this also for non-repeating alarms. The other forms "
"provide convenient access to a restricted set of alarm recurrence types, one"
" specifying a repetition count and the other an end time."
msgstr ""

# automatic translation
#. Tag: para
#: index.docbook:3941
#, no-c-format
msgid ""
"If the scheduled time (including any repetitions) has already passed, "
"&kalarm; immediately displays the message (unless the "
"<parameter>lateCancel</parameter> value indicates that it is now too late to"
" display the alarm, in which case &kalarm; ignores the request). If the "
"scheduled time (or a repetition) is in the future, &kalarm; adds the alarm "
"message to the default active alarm calendar for later display."
msgstr ""

# automatic translation
#. Tag: refentrytitle
#: index.docbook:3953
#, no-c-format
msgid "<refentrytitle>scheduleFile</refentrytitle>"
msgstr ""

