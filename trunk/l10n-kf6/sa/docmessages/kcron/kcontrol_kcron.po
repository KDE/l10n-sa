# automatic translation
#: index.docbook:134 index.docbook:336
#. Tag: guilabel
#, no-c-format
msgid "Value"
msgstr "मूल्यम्‌"

# automatic translation
#: index.docbook:135
#. Tag: para
#, no-c-format
msgid "Variable value."
