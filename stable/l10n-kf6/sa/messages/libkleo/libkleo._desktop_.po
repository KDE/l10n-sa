#: src/libkleopatrarc.desktop:1191 src/libkleopatrarc-win32.desktop:1053
msgctxt "Description"
msgid "Certificates that are disabled"
msgstr "प्रमाणपत्राणि ये अक्षमानि सन्ति"

#: src/libkleopatrarc.desktop:1227 src/libkleopatrarc-win32.desktop:1089
msgctxt "Name"
msgid "My Own"
msgstr "मम स्वकीयः"

#: src/libkleopatrarc.desktop:1256 src/libkleopatrarc-win32.desktop:1118
msgctxt "Description"
msgid "My own certificates"
