#: org.kde.tokodon.desktop:4 src/tokodon.notifyrc:5
msgctxt "Name"
msgid "Tokodon"
msgstr "टोकोडोन्"

#: org.kde.tokodon.desktop:45
msgctxt "GenericName"
msgid "Browse the Fediverse"
msgstr "Fediverse ब्राउज् कुर्वन्तु"

#: org.kde.tokodon.desktop:77
msgctxt "Comment"
msgid "Client for the Mastodon"
msgstr "मस्टोडन् कृते ग्राहकः"

#: src/tokodon.notifyrc:47
msgctxt "Comment"
msgid "A client for Mastodon, the decentralized social media"
msgstr "विकेन्द्रीकृतस्य सामाजिकमाध्यमस्य मास्टोडन् इत्यस्य ग्राहकः"

#: src/tokodon.notifyrc:84
msgctxt "Name"
msgid "Favorite"
msgstr "प्रिय"

#: src/tokodon.notifyrc:121
msgctxt "Comment"
msgid "Someone favorited your post"
msgstr "भवतः पोस्ट् कश्चन प्रियं कृतवान्"

#: src/tokodon.notifyrc:158
msgctxt "Name"
msgid "Boost"
msgstr "संवेग"

#: src/tokodon.notifyrc:193
msgctxt "Comment"
msgid "Someone boosted your post"
msgstr "कश्चन भवतः पोस्ट् बूस्ट् कृतवान्"

#: src/tokodon.notifyrc:231 src/tokodon.notifyrc:374
msgctxt "Name"
msgid "Follow"
msgstr "अनुशीलनं"

#: src/tokodon.notifyrc:268
msgctxt "Comment"
msgid "Someone followed you"
msgstr "कश्चित् भवन्तं अनुसृत्य गतः"

#: src/tokodon.notifyrc:306
msgctxt "Name"
msgid "Follow Request"
msgstr "अनुसरणं कुर्वन्तु अनुरोधः"

#: src/tokodon.notifyrc:339
msgctxt "Comment"
msgid "Someone requested to followed you"
msgstr "कश्चन भवतः अनुसरणं कर्तुं प्रार्थितवान्"

#: src/tokodon.notifyrc:411
msgctxt "Comment"
msgid "Someone mentioned you"
msgstr "कश्चित् भवतः उल्लेखं कृतवान्"

#: src/tokodon.notifyrc:449
msgctxt "Name"
msgid "Update"
msgstr "अद्यतन"

#: src/tokodon.notifyrc:485
msgctxt "Comment"
msgid "Someone edited a post"
msgstr "कश्चन एकं पोस्ट् सम्पादितवान्"

#: src/tokodon.notifyrc:522
msgctxt "Name"
msgid "Poll"
msgstr "मतदानम्"

#: src/tokodon.notifyrc:555
msgctxt "Comment"
msgid "Someone's poll ended"
msgstr "कस्यचित् मतदानं समाप्तम्"

#: src/tokodon.notifyrc:590
msgctxt "Name"
msgid "Status"
msgstr "स्थितिः"

#: src/tokodon.notifyrc:623
msgctxt "Comment"
msgid "Someone posted a new status"
msgstr "कश्चन नूतनं स्थितिं स्थापितवान्"

#: src/tokodon.notifyrc:658
msgctxt "Name"
msgid "Annual Report"
msgstr "वार्षिक प्रतिवेदन"

#: src/tokodon.notifyrc:687
msgctxt "Comment"
msgid "Unveil your year's highlights and memorable moments on the Fediverse!"
msgstr "Fediverse इत्यत्र स्वस्य वर्षस्य मुख्यविषयाणां स्मरणीयक्षणानाञ्च अनावरणं कुर्वन्तु!"

#: src/tokodon.notifyrc:719
msgctxt "Name"
msgid "Other"
msgstr "अन्ये"

#: src/tokodon.notifyrc:749
msgctxt "Comment"
msgid "Notifications that do not fit in other categories"
msgstr "अन्येषु वर्गेषु न उपयुज्यन्ते ये सूचनाः"
